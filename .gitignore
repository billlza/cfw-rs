# Rust build output
/target

# Physical collector local Go build/test caches
/tools/physical-collector/target/

# Atomic-write staging files
**/*.tmp

# macOS junk
.DS_Store

# Python bytecode is never source or release evidence
__pycache__/
*.py[cod]

# Playwright cache
/.playwright-cli

# Cursor local agent config
.cursor/

# Local build / notary logs (may contain machine paths)
/build-release.log
/notarize.log
/*.log

# UI esbuild
/apps/cfw-tauri-shell/node_modules/
/apps/cfw-tauri-shell/ui/dist/
# The parallel React prototype is retired. Keep any local remnants out of the
# source graph and release SBOM without deleting user-owned untracked files.
/apps/cfw-tauri-shell/ui-react/

# Retired local network binaries are never packaged. Keep accidental rebuilds
# out of source control while the one-way migration removes installed copies.
/apps/cfw-tauri-shell/resources/cores/*
/apps/cfw-tauri-shell/resources/helpers/*

# Perf gate local output
/target/perf-gate/

# Tauri updater private signing key (public key lives in tauri.conf.json)
/.tauri/*.key
/.tauri/*.log

# Xcode derived data from local native builds
/native/macos/build/
