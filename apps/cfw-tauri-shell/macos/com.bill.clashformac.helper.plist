<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Privileged helper daemon registered via SMAppService (macOS 13+).
      Staged into the app bundle at Contents/Library/LaunchDaemons/ by
      scripts/bundle_service_mode.sh, then registered from the app
      (cfw-platform::ServiceModeService::enable_service_mode). launchd runs this
      as root so mihomo can open a utun device for TUN mode.

      BundleProgram is resolved relative to the .app bundle root; the helper is
      shipped at Contents/Resources/helpers/cfw-helper by build_helper_resource.sh.

      RunAtLoad is intentionally false: the root daemon must learn the active
      user's app-home (e.g. /Users/<u>/Library/Application Support/Clash for Mac)
      before it can spawn the core with a valid config. The app kickstarts the
      daemon on demand once that coordination path is wired (real-machine TODO);
      a root run with the wrong (/var/root) home would just fail MissingConfig.
    -->
    <key>Label</key>
    <string>com.bill.clashformac.helper</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/helpers/cfw-helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/Resources/helpers/cfw-helper</string>
        <string>serve</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.bill.clashformac</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/com.bill.clashformac.helper.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/com.bill.clashformac.helper.log</string>
</dict>
</plist>
