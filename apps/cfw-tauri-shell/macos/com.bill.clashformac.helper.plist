<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Privileged helper daemon registered via SMAppService (macOS 13+). Staged
      into the app bundle at Contents/Library/LaunchDaemons/ by
      scripts/bundle_service_mode.sh and signed (Developer ID, Team YKUPL7Z869).
      launchd runs it as root so mihomo can open a utun device for TUN mode.

      Lifecycle is driven entirely by launchd + the app-written control file at
      /Library/Application Support/com.bill.clashformac/active-session.json:
        - KeepAlive PathState starts the `serve` supervisor while that file
          exists and stops it when the app removes it, so the unprivileged app
          never needs to start a system daemon itself (it cannot).
        - `serve` reads the control file to learn the active user's app-home and
          config (it CANNOT use $HOME, which is /var/root under launchd), and
          runs/stops the core based on want_core/generation/heartbeat.

      ProgramArguments carries no --app-home: the daemon self-discovers it from
      the control file. This plist is signed INTO the bundle, so RunAtLoad and
      KeepAlive must be correct before the first SMAppService.register(), else a
      change forces a re-sign and a re-approval in System Settings.
    -->
    <key>Label</key>
    <string>com.bill.clashformac.helper</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/resources/helpers/cfw-helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/Resources/resources/helpers/cfw-helper</string>
        <string>serve</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.bill.clashformac</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/com.bill.clashformac/active-session.json</key>
            <true/>
        </dict>
    </dict>
    <key>StandardOutPath</key>
    <string>/Library/Logs/com.bill.clashformac.helper.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/com.bill.clashformac.helper.log</string>
</dict>
</plist>
