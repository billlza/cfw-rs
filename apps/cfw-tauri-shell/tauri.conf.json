{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash for Mac",
  "version": "0.1.0",
  "identifier": "com.bill.clashformac",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "sh -c 'for script in scripts/build_helper_resource.sh ../scripts/build_helper_resource.sh ../../scripts/build_helper_resource.sh ../../../scripts/build_helper_resource.sh; do if [ -x \"$script\" ]; then \"$script\"; exit $?; fi; done; echo \"build_helper_resource.sh not found\" >&2; exit 127'"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 850,
        "height": 603,
        "minWidth": 850,
        "minHeight": 603,
        "decorations": true,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon_512.png",
      "icons/logo_64.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": [
      "resources/helpers",
      "resources/cores",
      "../../reverse/cfw-0.20.39-arm64/metadata",
      "../../reverse/cfw-0.20.39-arm64/asar/package.json"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["clash"]
      }
    }
  }
}
