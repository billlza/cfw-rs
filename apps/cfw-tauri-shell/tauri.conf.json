{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash for Mac",
  "version": "0.4.0",
  "identifier": "com.bill.clashformac",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "../../scripts/build_ui_with_pinned_node.sh",
    "beforeDevCommand": "../../scripts/build_ui_with_pinned_node.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 850,
        "height": 603,
        "minWidth": 850,
        "minHeight": 603,
        "decorations": true,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.icns",
      "icons/icon_512.png",
      "icons/logo_64.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "macos/entitlements.plist",
      "files": {
        "Frameworks/CFWNativeBridge.framework": "../../target/native-products/CFWNativeBridge.framework",
        "Library/HelperTools/CFWGlobalAuthority": "../../target/native-products/CFWGlobalAuthority",
        "Library/HelperTools/cfw-helper-tombstone": "../../target/native-products/CFWLegacyTombstone/cfw-helper-tombstone",
        "Library/LaunchDaemons/com.bill.clashformac.global-authority.plist": "../../native/macos/Config/com.bill.clashformac.global-authority.plist",
        "Library/LaunchDaemons/com.bill.clashformac.helper.plist": "macos/legacy-tombstone/com.bill.clashformac.helper.plist",
        "Library/LaunchAgents/com.bill.clashformac.proxy-agent.plist": "../../native/macos/Config/com.bill.clashformac.proxy-agent.plist",
        "Library/LoginItems/CFWProxyAgent.app": "../../target/native-products/CFWProxyAgent.app",
        "Library/SystemExtensions/com.bill.clashformac.packet-tunnel.systemextension": "../../target/native-products/com.bill.clashformac.packet-tunnel.systemextension"
      }
    },
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNjc4ODQ3NDhENTIwREQKUldUZElOVklSNGhuUWM1NnlCMS9qNGtyQm56L3JHSnFwYy9ZRm9iMHpQYzdBeTBqYmU0ZXNsMHUK",
      "endpoints": [
        "https://github.com/billlza/cfw-rs/releases/latest/download/latest.json"
      ]
    }
  }
}
