{
  "config": {
    "dns": {
      "final": "cfw-profile-dns-1",
      "rules": [
        {
          "action": "route",
          "domain_suffix": "example.org",
          "server": "cfw-policy-dns-0-0"
        },
        {
          "action": "evaluate",
          "domain_regex": ".*",
          "server": "cfw-profile-dns-0"
        },
        {
          "action": "respond",
          "mode": "and",
          "rules": [
            {
              "domain_regex": ".*"
            },
            {
              "mode": "or",
              "rules": [
                {
                  "match_response": true,
                  "response_rcode": "NOERROR"
                },
                {
                  "match_response": true,
                  "response_rcode": "NXDOMAIN"
                }
              ],
              "type": "logical"
            }
          ],
          "type": "logical"
        }
      ],
      "servers": [
        {
          "server": "223.5.5.5",
          "server_port": 53,
          "tag": "cfw-bootstrap-dns-0",
          "type": "udp"
        },
        {
          "connect_timeout": "5s",
          "detour": "proxy",
          "server": "1.1.1.1",
          "server_port": 53,
          "tag": "cfw-profile-dns-0",
          "type": "tcp"
        },
        {
          "connect_timeout": "5s",
          "detour": "proxy",
          "server": "8.8.8.8",
          "server_port": 53,
          "tag": "cfw-profile-dns-1",
          "type": "tcp"
        },
        {
          "connect_timeout": "5s",
          "server": "180.76.76.76",
          "server_port": 53,
          "tag": "cfw-proxy-server-dns-0",
          "type": "tcp"
        },
        {
          "connect_timeout": "5s",
          "server": "114.114.114.114",
          "server_port": 53,
          "tag": "cfw-direct-dns-0",
          "type": "tcp"
        },
        {
          "connect_timeout": "5s",
          "detour": "proxy",
          "server": "223.6.6.6",
          "server_port": 53,
          "tag": "cfw-policy-dns-0-0",
          "type": "tcp"
        }
      ],
      "strategy": "prefer_ipv4"
    },
    "experimental": {
      "clash_api": {
        "external_controller": "127.0.0.1:9090",
        "secret": "<CLASH-API-SECRET>"
      }
    },
    "inbounds": [
      {
        "listen": "127.0.0.1",
        "listen_port": 7890,
        "tag": "cfw-system-proxy",
        "type": "mixed"
      }
    ],
    "log": {
      "level": "info",
      "timestamp": true
    },
    "outbounds": [
      {
        "domain_resolver": {
          "server": "cfw-proxy-server-dns-0"
        },
        "server": "node.example.com",
        "server_port": 1080,
        "tag": "proxy",
        "type": "socks",
        "version": "5"
      },
      {
        "domain_resolver": {
          "server": "cfw-direct-dns-0"
        },
        "tag": "direct",
        "type": "direct"
      }
    ],
    "route": {
      "default_domain_resolver": {
        "policy": "default"
      },
      "final": "proxy",
      "rules": [
        {
          "action": "route",
          "clash_mode": "Direct",
          "outbound": "direct"
        },
        {
          "action": "resolve",
          "mode": "and",
          "rules": [
            {
              "clash_mode": "Global"
            },
            {
              "domain_regex": "."
            }
          ],
          "type": "logical"
        },
        {
          "action": "route",
          "clash_mode": "Global",
          "outbound": "proxy"
        },
        {
          "action": "route",
          "domain": "direct.example.com",
          "outbound": "direct"
        },
        {
          "action": "resolve",
          "domain_regex": "."
        }
      ]
    }
  },
  "credential_slots": [],
  "direct_ipv4_hosts": "DirectIpv4HostRoutes { release_transport: false }",
  "mode": "LocalProxy",
