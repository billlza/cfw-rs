                  "match_response": true,
                  "response_rcode": "NXDOMAIN"
                }
              ],
              "type": "logical"
            }
          ],
          "type": "logical"
        }
      ],
      "servers": [
        {
          "server": "223.6.6.6",
          "server_port": 53,
          "tag": "cfw-bootstrap-dns-0",
          "type": "udp"
        },
        {
          "server": "119.29.29.29",
          "server_port": 53,
          "tag": "cfw-bootstrap-dns-1",
          "type": "udp"
        },
        {
          "connect_timeout": "5s",
          "detour": "Node",
          "path": "/dns-query",
          "server": "223.5.5.5",
          "server_port": 443,
          "tag": "cfw-authenticated-dns-0",
          "tls": {
            "enabled": true,
            "min_version": "1.2",
            "server_name": "dns.alidns.com"
          },
          "type": "https"
        },
        {
          "connect_timeout": "5s",
