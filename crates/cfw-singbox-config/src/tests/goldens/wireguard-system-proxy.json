{
  "config": {
    "dns": {
      "final": "cfw-authenticated-dns-1",
      "rules": [
        {
          "action": "evaluate",
          "domain_regex": ".*",
          "server": "cfw-authenticated-dns-0"
        },
        {
          "action": "respond",
          "mode": "and",
          "rules": [
            {
              "domain_regex": ".*"
            },
            {
              "mode": "or",
              "rules": [
                {
                  "match_response": true,
                  "response_rcode": "NOERROR"
                },
                {
                  "match_response": true,
                  "response_rcode": "NXDOMAIN"
                }
              ],
              "type": "logical"
            }
          ],
          "type": "logical"
        }
      ],
      "servers": [
        {
          "server": "223.6.6.6",
          "server_port": 53,
          "tag": "cfw-bootstrap-dns-0",
          "type": "udp"
        },
        {
          "server": "119.29.29.29",
          "server_port": 53,
          "tag": "cfw-bootstrap-dns-1",
          "type": "udp"
        },
        {
          "connect_timeout": "5s",
          "detour": "wg",
          "path": "/dns-query",
          "server": "223.5.5.5",
          "server_port": 443,
          "tag": "cfw-authenticated-dns-0",
          "tls": {
            "enabled": true,
            "min_version": "1.2",
            "server_name": "dns.alidns.com"
          },
          "type": "https"
        },
        {
          "connect_timeout": "5s",
          "detour": "wg",
          "path": "/dns-query",
          "server": "1.1.1.1",
          "server_port": 443,
          "tag": "cfw-authenticated-dns-1",
          "tls": {
            "enabled": true,
            "min_version": "1.2",
            "server_name": "cloudflare-dns.com"
          },
          "type": "https"
        }
      ],
      "strategy": "prefer_ipv4"
    },
    "endpoints": [
      {
        "address": [
          "10.10.0.2/32",
          "fd00::2/128"
        ],
        "domain_resolver": {
          "fallback_server": "cfw-bootstrap-dns-1",
          "server": "cfw-bootstrap-dns-0"
        },
        "mtu": 1420,
        "peers": [
          {
            "address": "vpn.example.com",
            "allowed_ips": [
              "0.0.0.0/0",
              "::/0"
            ],
            "persistent_keepalive_interval": 25,
            "port": 51820,
            "public_key": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
          }
        ],
        "private_key": "",
        "system": false,
        "tag": "wg",
        "type": "wireguard"
      }
    ],
    "experimental": {
      "clash_api": {
        "external_controller": "127.0.0.1:9090",
        "secret": "<CLASH-API-SECRET>"
      }
    },
    "inbounds": [
      {
        "listen": "127.0.0.1",
        "listen_port": 7890,
        "tag": "cfw-system-proxy",
        "type": "mixed"
      }
    ],
    "log": {
      "level": "info",
      "timestamp": true
    },
    "outbounds": [
      {
        "tag": "cfw-direct",
        "type": "direct"
      }
    ],
    "route": {
      "default_domain_resolver": {
        "fallback_server": "cfw-authenticated-dns-1",
        "server": "cfw-authenticated-dns-0"
      },
      "final": "wg",
      "rules": [
        {
          "action": "route",
          "clash_mode": "Direct",
          "outbound": "cfw-direct"
        },
        {
          "action": "route",
          "clash_mode": "Global",
          "outbound": "wg"
        }
      ]
    }
  },
  "credential_slots": [
    {
      "json_pointer": "/endpoints/0/private_key",
      "outbound_index": 0,
      "reference": {
        "id": "66666666-6666-4666-8666-666666666666",
        "kind": "wireguard_private_key"
      },
      "target": "wireguard_private_key"
    }
  ],
  "direct_ipv4_hosts": "DirectIpv4HostRoutes { release_transport: false }",
  "mode": "SystemProxy",
