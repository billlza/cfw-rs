+		logger: logger.NOP(),
+		transport: &fallbackTransportManager{
+			primary:   primary,
+			secondary: secondary,
+		},
+		client: client,
+		rules:  []adapter.DNSRule{new(fallbackDNSRule)},
+	}
+}
