+type fallbackDNSClient struct {
+	exchangeErrors         map[string]error
+	lookupErrors           map[string]error
+	exchangeErrorSequences map[string][]error
+	lookupErrorSequences   map[string][]error
+	exchangeCalls          map[string]int
+	lookupCalls            map[string]int
+	exchangeHooks          map[string]func()
+	lookupHooks            map[string]func()
+}
+
+func newFallbackDNSClient() *fallbackDNSClient {
+	return &fallbackDNSClient{
+		exchangeErrors:         make(map[string]error),
+		lookupErrors:           make(map[string]error),
+		exchangeErrorSequences: make(map[string][]error),
+		lookupErrorSequences:   make(map[string][]error),
+		exchangeCalls:          make(map[string]int),
+		lookupCalls:            make(map[string]int),
+		exchangeHooks:          make(map[string]func()),
+		lookupHooks:            make(map[string]func()),
+	}
+}
+
+func (*fallbackDNSClient) Start()      {}
+func (*fallbackDNSClient) ClearCache() {}
+func (c *fallbackDNSClient) Exchange(_ context.Context, transport adapter.DNSTransport, message *mDNS.Msg, _ adapter.DNSQueryOptions, _ func([]netip.Addr) bool) (*mDNS.Msg, error) {
+	tag := transport.Tag()
+	c.exchangeCalls[tag]++
+	if hook := c.exchangeHooks[transport.Tag()]; hook != nil {
+		hook()
+	}
+	if sequence := c.exchangeErrorSequences[tag]; c.exchangeCalls[tag] <= len(sequence) {
+		if err := sequence[c.exchangeCalls[tag]-1]; err != nil {
+			return nil, err
+		}
+	}
+	if err := c.exchangeErrors[transport.Tag()]; err != nil {
+		return nil, err
+	}
+	response := new(mDNS.Msg)
+	response.SetReply(message)
+	return response, nil
+}
+func (c *fallbackDNSClient) Lookup(_ context.Context, transport adapter.DNSTransport, _ string, _ adapter.DNSQueryOptions, _ func([]netip.Addr) bool) ([]netip.Addr, error) {
+	tag := transport.Tag()
+	c.lookupCalls[tag]++
+	if hook := c.lookupHooks[transport.Tag()]; hook != nil {
+		hook()
+	}
+	if sequence := c.lookupErrorSequences[tag]; c.lookupCalls[tag] <= len(sequence) {
+		if err := sequence[c.lookupCalls[tag]-1]; err != nil {
+			return nil, err
+		}
+	}
+	if err := c.lookupErrors[transport.Tag()]; err != nil {
+		return nil, err
+	}
+	return []netip.Addr{netip.MustParseAddr("192.0.2.1")}, nil
+}
+
+func newFallbackRouter(client *fallbackDNSClient) *Router {
+	primary := &fallbackDNSTransport{tag: "primary"}
