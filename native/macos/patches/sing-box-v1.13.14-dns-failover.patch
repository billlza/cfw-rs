+func newExplicitFallbackRouter(client *fallbackDNSClient) (*Router, adapter.DNSTransport, adapter.DNSTransport) {
+	primary := &fallbackDNSTransport{tag: "primary"}
+	secondary := &fallbackDNSTransport{tag: "secondary"}
