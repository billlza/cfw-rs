index 00000000..cf0fa9a2
--- /dev/null
+++ b/experimental/libbox/raw_packet_tun_darwin_test.go
@@ -0,0 +1,303 @@
+//go:build darwin
+
+package libbox
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"slices"
+	"testing"
+	"time"
+
+	tun "github.com/sagernet/sing-tun"
+	"golang.org/x/sys/unix"
+)
+
+func TestRawPacketTunReadAddsDarwinAddressFamilyHeader(t *testing.T) {
+	tests := []struct {
+		name          string
+		packet        []byte
+		addressFamily int
+	}{
+		{"IPv4", testIPv4Packet(32), unix.AF_INET},
+		{"IPv6", testIPv6Packet(48), unix.AF_INET6},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			rawTun, peer, _ := newTestRawPacketTun(t, rawPacketTunMinimumMTU)
+			if err := unix.Send(peer, test.packet, 0); err != nil {
+				t.Fatal(err)
+			}
+			buffer := make([]byte, rawPacketTunMinimumMTU+rawPacketTunHeaderSize)
+			n, err := rawTun.Read(buffer)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if n != len(test.packet)+rawPacketTunHeaderSize {
+				t.Fatalf("unexpected framed packet length: %d", n)
+			}
+			if family := int(binary.BigEndian.Uint32(buffer[:rawPacketTunHeaderSize])); family != test.addressFamily {
+				t.Fatalf("unexpected address family: %d", family)
+			}
+			if !slices.Equal(buffer[rawPacketTunHeaderSize:n], test.packet) {
+				t.Fatal("raw packet payload changed")
+			}
+		})
+	}
+}
+
+func TestRawPacketTunWriteRemovesAndValidatesDarwinHeader(t *testing.T) {
+	rawTun, peer, _ := newTestRawPacketTun(t, rawPacketTunMinimumMTU)
+	packet := testIPv6Packet(64)
+	framed := frameTestPacket(packet, unix.AF_INET6)
+	written, err := rawTun.Write(framed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if written != len(framed) {
+		t.Fatalf("unexpected write length: %d", written)
+	}
+	received := make([]byte, rawPacketTunMinimumMTU)
+	n, err := unix.Read(peer, received)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Equal(received[:n], packet) {
+		t.Fatal("Darwin header leaked into raw packet datagram")
+	}
+
+	if _, err = rawTun.Write(frameTestPacket(testIPv4Packet(32), unix.AF_INET6)); !errors.Is(err, errRawPacketTunInvalidPacket) {
+		t.Fatalf("expected address-family validation error, got %v", err)
+	}
+	malformedHeader := append([]byte{1, 0, 0, unix.AF_INET}, testIPv4Packet(32)...)
+	if _, err = rawTun.Write(malformedHeader); !errors.Is(err, errRawPacketTunInvalidPacket) {
+		t.Fatalf("expected malformed address-family header error, got %v", err)
+	}
+}
+
+func TestRawPacketTunAcceptsExactMaximumMTUDatagramAndRejectsMaximumPlusOne(t *testing.T) {
+	rawTun, peer, _ := newTestRawPacketTun(t, rawPacketTunMaximumMTU)
+	packet := testIPv4Packet(rawPacketTunMaximumMTU)
+	if err := unix.Send(peer, packet, 0); err != nil {
+		t.Fatalf("send exact maximum datagram: %v", err)
+	}
+	buffer := make([]byte, rawPacketTunMaximumMTU+rawPacketTunHeaderSize)
+	n, err := rawTun.Read(buffer)
+	if err != nil {
+		t.Fatalf("read exact maximum datagram: %v", err)
+	}
+	if n != rawPacketTunMaximumMTU+rawPacketTunHeaderSize {
+		t.Fatalf("unexpected exact maximum framed length: %d", n)
+	}
+
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(pair[0])
+	_, err = newRawPacketTun(
+		int32(pair[1]),
+		testRawPacketTunOptions(rawPacketTunMaximumMTU+1),
+	)
+	if !errors.Is(err, errRawPacketTunInvalidConfiguration) {
+		t.Fatalf("expected maximum plus one MTU rejection, got %v", err)
+	}
+	if err := unix.Close(pair[1]); !errors.Is(err, unix.EBADF) {
+		t.Fatalf("rejected maximum plus one descriptor was not closed: %v", err)
+	}
+}
+
+func TestRawPacketTunRejectsTruncationOversizeAndMalformedPackets(t *testing.T) {
+	rawTun, peer, _ := newTestRawPacketTun(t, rawPacketTunMinimumMTU)
+	oversize := testIPv4Packet(rawPacketTunMinimumMTU + 1)
+	if err := unix.Send(peer, oversize, 0); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, rawPacketTunMinimumMTU+rawPacketTunHeaderSize)
+	if _, err := rawTun.Read(buffer); !errors.Is(err, errRawPacketTunPacketTruncated) {
+		t.Fatalf("expected truncation error, got %v", err)
+	}
+
+	if _, err := rawTun.Write(frameTestPacket(oversize, unix.AF_INET)); !errors.Is(err, errRawPacketTunInvalidPacket) {
+		t.Fatalf("expected outbound MTU error, got %v", err)
+	}
+	if err := unix.Send(peer, []byte{0x70, 0, 0, 0}, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := rawTun.Read(buffer); !errors.Is(err, errRawPacketTunInvalidPacket) {
+		t.Fatalf("expected IP validation error, got %v", err)
+	}
+	if _, err := rawTun.Read(make([]byte, rawPacketTunMinimumMTU)); !errors.Is(err, errRawPacketTunInvalidConfiguration) {
+		t.Fatalf("expected bounded read-buffer error, got %v", err)
+	}
+}
+
+func TestRawPacketTunCloseUnblocksReadAndIsIdempotent(t *testing.T) {
+	rawTun, _, _ := newTestRawPacketTun(t, rawPacketTunMinimumMTU)
+	readStarted := make(chan struct{})
+	readFinished := make(chan error, 1)
+	go func() {
+		close(readStarted)
+		_, err := rawTun.Read(make([]byte, rawPacketTunMinimumMTU+rawPacketTunHeaderSize))
+		readFinished <- err
+	}()
+	<-readStarted
+	if err := rawTun.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := rawTun.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-readFinished:
+		if err == nil {
+			t.Fatal("blocked read returned success after close")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not unblock packet read")
+	}
+}
+
+func TestRawPacketTunOwnsDescriptorAndUsesExternalConfiguration(t *testing.T) {
+	rawTun, peer, options := newTestRawPacketTun(t, rawPacketTunMinimumMTU)
+	name, err := rawTun.Name()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != rawPacketTunName || options.Name != rawPacketTunName {
+		t.Fatalf("unexpected logical name: %q / %q", name, options.Name)
+	}
+	if !options.EXP_ExternalConfiguration || options.EXP_MultiPendingPackets || options.EXP_SendMsgX {
+		t.Fatal("raw transport did not enforce external configuration")
+	}
+
+	unchanged := *options
+	unchanged.Inet4Address = slices.Clone(options.Inet4Address)
+	unchanged.Inet6Address = slices.Clone(options.Inet6Address)
+	if err := rawTun.UpdateRouteOptions(unchanged); err != nil {
+		t.Fatalf("unchanged options were rejected: %v", err)
+	}
+	changedMTU := unchanged
+	changedMTU.MTU++
+	if err := rawTun.UpdateRouteOptions(changedMTU); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected MTU change rejection, got %v", err)
+	}
+	changedAddress := unchanged
+	changedAddress.Inet4Address = []netip.Prefix{netip.MustParsePrefix("198.18.64.5/30")}
+	if err := rawTun.UpdateRouteOptions(changedAddress); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected address change rejection, got %v", err)
+	}
+	changedRoute := unchanged
+	changedRoute.Inet4RouteAddress = []netip.Prefix{netip.MustParsePrefix("203.0.113.0/24")}
+	if err := rawTun.UpdateRouteOptions(changedRoute); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected route change rejection, got %v", err)
+	}
+	changedDNS := unchanged
+	changedDNS.DNSServers = []netip.Addr{netip.MustParseAddr("2001:2:0:65::2")}
+	if err := rawTun.UpdateRouteOptions(changedDNS); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected DNS change rejection, got %v", err)
+	}
+	changedInterface := unchanged
+	changedInterface.IncludeInterface = []string{"en0"}
+	if err := rawTun.UpdateRouteOptions(changedInterface); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected interface change rejection, got %v", err)
+	}
+	changedExternalConfiguration := unchanged
+	changedExternalConfiguration.EXP_ExternalConfiguration = false
+	if err := rawTun.UpdateRouteOptions(changedExternalConfiguration); !errors.Is(err, errRawPacketTunConfigurationChanged) {
+		t.Fatalf("expected external configuration change rejection, got %v", err)
+	}
+
+	packet := testIPv4Packet(32)
+	if err := unix.Send(peer, packet, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := rawTun.Read(make([]byte, rawPacketTunMinimumMTU+rawPacketTunHeaderSize)); err != nil {
+		t.Fatalf("adopted connection is not usable: %v", err)
+	}
+}
+
+func TestRawPacketTunRejectsAndClosesInvalidDescriptors(t *testing.T) {
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(pair[0])
+	options := testRawPacketTunOptions(rawPacketTunMinimumMTU)
+	if _, err := newRawPacketTun(int32(pair[1]), options); !errors.Is(err, errRawPacketTunInvalidDescriptor) {
+		t.Fatalf("expected descriptor validation error, got %v", err)
+	}
+	if err := unix.Close(pair[1]); !errors.Is(err, unix.EBADF) {
+		t.Fatalf("failed constructor retained descriptor ownership: %v", err)
+	}
+
+	datagram, err := unix.Socket(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := newRawPacketTun(int32(datagram), testRawPacketTunOptions(rawPacketTunMinimumMTU)); !errors.Is(err, errRawPacketTunInvalidDescriptor) {
+		t.Fatalf("expected connected-socket validation error, got %v", err)
+	}
+	if err := unix.Close(datagram); !errors.Is(err, unix.EBADF) {
+		t.Fatalf("unconnected descriptor was not closed: %v", err)
+	}
+}
+
+func newTestRawPacketTun(t *testing.T, mtu int) (*rawPacketTun, int, *tun.Options) {
+	t.Helper()
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	options := testRawPacketTunOptions(mtu)
+	created, err := newRawPacketTun(int32(pair[1]), options)
+	if err != nil {
+		unix.Close(pair[0])
+		t.Fatal(err)
+	}
+	if err := unix.Close(pair[1]); !errors.Is(err, unix.EBADF) {
+		created.Close()
+		unix.Close(pair[0])
+		t.Fatalf("transferred descriptor was not closed: %v", err)
+	}
+	rawTun := created.(*rawPacketTun)
+	t.Cleanup(func() {
+		_ = rawTun.Close()
+		_ = unix.Close(pair[0])
+	})
+	return rawTun, pair[0], options
+}
+
+func testRawPacketTunOptions(mtu int) *tun.Options {
+	return &tun.Options{
+		MTU:          uint32(mtu),
+		Inet4Address: []netip.Prefix{netip.MustParsePrefix("198.18.64.1/30")},
+		Inet6Address: []netip.Prefix{netip.MustParsePrefix("2001:2:0:64::1/126")},
+	}
+}
+
+func frameTestPacket(packet []byte, addressFamily int) []byte {
+	framed := make([]byte, rawPacketTunHeaderSize+len(packet))
+	binary.BigEndian.PutUint32(framed[:rawPacketTunHeaderSize], uint32(addressFamily))
+	copy(framed[rawPacketTunHeaderSize:], packet)
+	return framed
+}
+
+func testIPv4Packet(length int) []byte {
+	packet := make([]byte, length)
+	packet[0] = 0x45
+	binary.BigEndian.PutUint16(packet[2:4], uint16(length))
+	packet[8] = 64
+	packet[9] = unix.IPPROTO_UDP
+	return packet
+}
+
+func testIPv6Packet(length int) []byte {
+	packet := make([]byte, length)
+	packet[0] = 0x60
+	binary.BigEndian.PutUint16(packet[4:6], uint16(length-40))
+	packet[6] = unix.IPPROTO_UDP
+	packet[7] = 64
+	return packet
+}
