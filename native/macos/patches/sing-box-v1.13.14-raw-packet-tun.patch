@@ -0,0 +1,31 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestStartedServiceRuntimeStatusAndFatalCleanup(t *testing.T) {
+	service := NewStartedService(ServiceOptions{Context: context.Background()})
+	defer service.Close()
+
+	status, message := service.RuntimeStatus()
+	if status != ServiceStatus_IDLE || message != "" {
+		t.Fatalf("unexpected initial status: %v %q", status, message)
+	}
+
+	service.SetError(errors.New("test failure"))
+	status, message = service.RuntimeStatus()
+	if status != ServiceStatus_FATAL || message != "test failure" {
+		t.Fatalf("unexpected fatal status: %v %q", status, message)
+	}
+
+	if err := service.CloseService(); err != nil {
+		t.Fatalf("clean fatal service: %v", err)
+	}
+	status, message = service.RuntimeStatus()
+	if status != ServiceStatus_IDLE || message != "" {
+		t.Fatalf("unexpected cleaned status: %v %q", status, message)
+	}
+}
