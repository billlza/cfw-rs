+package libbox
+
+import "errors"
+
+const rawPacketTunName = "cfw-packet-flow"
+
+var (
+	errRawPacketTunUnsupported          = errors.New("raw packet tun is unsupported on this platform")
+	errRawPacketTunInvalidDescriptor    = errors.New("raw packet tun descriptor is invalid")
+	errRawPacketTunInvalidConfiguration = errors.New("raw packet tun configuration is invalid")
+	errRawPacketTunConfigurationChanged = errors.New("raw packet tun configuration changed")
+	errRawPacketTunInvalidPacket        = errors.New("raw packet tun packet is invalid")
+	errRawPacketTunPacketTruncated      = errors.New("raw packet tun packet was truncated")
