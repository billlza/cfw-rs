diff --git a/experimental/libbox/raw_packet_tun_darwin.go b/experimental/libbox/raw_packet_tun_darwin.go
new file mode 100644
index 00000000..cd899a61
--- /dev/null
+++ b/experimental/libbox/raw_packet_tun_darwin.go
@@ -0,0 +1,242 @@
+//go:build darwin
+
+package libbox
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"reflect"
+	"slices"
+	"sync"
+
+	tun "github.com/sagernet/sing-tun"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	rawPacketTunMinimumMTU = 1280
+	rawPacketTunMaximumMTU = 1500
+	rawPacketTunHeaderSize = 4
+)
+
+type rawPacketTun struct {
+	connection    *net.UnixConn
+	mtu           int
+	configuration tun.Options
+	closeOnce     sync.Once
+	closeErr      error
+}
+
+var _ tun.Tun = (*rawPacketTun)(nil)
+
+// newRawPacketTun takes ownership of fd on every path. The descriptor must be
+// one end of a connected AF_UNIX/SOCK_DGRAM socketpair carrying exactly one
+// headerless IP packet per datagram.
+func newRawPacketTun(fd int32, options *tun.Options) (tun.Tun, error) {
+	if fd < 0 {
+		return nil, fmt.Errorf("%w: negative file descriptor", errRawPacketTunInvalidDescriptor)
+	}
+	closeFD := true
+	defer func() {
+		if closeFD {
+			_ = unix.Close(int(fd))
+		}
+	}()
+
+	socketType, err := unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_TYPE)
+	if err != nil {
+		return nil, fmt.Errorf("%w: query socket type: %v", errRawPacketTunInvalidDescriptor, err)
+	}
+	if socketType != unix.SOCK_DGRAM {
+		return nil, fmt.Errorf("%w: expected SOCK_DGRAM", errRawPacketTunInvalidDescriptor)
+	}
+	if _, ok := mustSockaddrUnix(unix.Getsockname(int(fd))); !ok {
+		return nil, fmt.Errorf("%w: expected AF_UNIX socket", errRawPacketTunInvalidDescriptor)
+	}
+	if _, ok := mustSockaddrUnix(unix.Getpeername(int(fd))); !ok {
+		return nil, fmt.Errorf("%w: expected connected AF_UNIX socket", errRawPacketTunInvalidDescriptor)
+	}
+	if options == nil {
+		return nil, fmt.Errorf("%w: missing options", errRawPacketTunInvalidConfiguration)
+	}
+	if options.MTU < rawPacketTunMinimumMTU || options.MTU > rawPacketTunMaximumMTU {
+		return nil, fmt.Errorf("%w: MTU %d is outside %d...%d", errRawPacketTunInvalidConfiguration, options.MTU, rawPacketTunMinimumMTU, rawPacketTunMaximumMTU)
+	}
+	if options.AutoRoute {
+		return nil, fmt.Errorf("%w: auto_route must be disabled", errRawPacketTunInvalidConfiguration)
+	}
+	if options.GSO {
+		return nil, fmt.Errorf("%w: GSO is unsupported", errRawPacketTunInvalidConfiguration)
+	}
+
+	file := os.NewFile(uintptr(fd), rawPacketTunName)
+	if file == nil {
+		return nil, fmt.Errorf("%w: adopt file descriptor", errRawPacketTunInvalidDescriptor)
+	}
+	connection, err := net.FileConn(file)
+	fileCloseErr := file.Close()
+	closeFD = false
+	if err != nil {
+		if fileCloseErr != nil {
+			return nil, fmt.Errorf("%w: adopt datagram socket: %v; close transferred descriptor: %v", errRawPacketTunInvalidDescriptor, err, fileCloseErr)
+		}
+		return nil, fmt.Errorf("%w: adopt datagram socket: %v", errRawPacketTunInvalidDescriptor, err)
+	}
+	if fileCloseErr != nil {
+		_ = connection.Close()
+		return nil, fmt.Errorf("%w: close transferred descriptor: %v", errRawPacketTunInvalidDescriptor, fileCloseErr)
+	}
+	unixConnection, ok := connection.(*net.UnixConn)
+	if !ok {
+		_ = connection.Close()
+		return nil, fmt.Errorf("%w: descriptor did not produce UnixConn", errRawPacketTunInvalidDescriptor)
+	}
+
+	options.Name = rawPacketTunName
+	options.FileDescriptor = 0
+	options.EXP_ExternalConfiguration = true
+	options.EXP_MultiPendingPackets = false
+	options.EXP_SendMsgX = false
+	return &rawPacketTun{
+		connection:    unixConnection,
+		mtu:           int(options.MTU),
+		configuration: cloneRawPacketTunOptions(*options),
+	}, nil
+}
+
+func cloneRawPacketTunOptions(options tun.Options) tun.Options {
+	options.Inet4Address = slices.Clone(options.Inet4Address)
+	options.Inet6Address = slices.Clone(options.Inet6Address)
+	options.DNSServers = slices.Clone(options.DNSServers)
+	options.Inet4LoopbackAddress = slices.Clone(options.Inet4LoopbackAddress)
+	options.Inet6LoopbackAddress = slices.Clone(options.Inet6LoopbackAddress)
+	options.Inet4RouteAddress = slices.Clone(options.Inet4RouteAddress)
+	options.Inet6RouteAddress = slices.Clone(options.Inet6RouteAddress)
+	options.Inet4RouteExcludeAddress = slices.Clone(options.Inet4RouteExcludeAddress)
+	options.Inet6RouteExcludeAddress = slices.Clone(options.Inet6RouteExcludeAddress)
+	options.IncludeInterface = slices.Clone(options.IncludeInterface)
+	options.ExcludeInterface = slices.Clone(options.ExcludeInterface)
+	options.IncludeUID = slices.Clone(options.IncludeUID)
+	options.ExcludeUID = slices.Clone(options.ExcludeUID)
+	options.IncludeAndroidUser = slices.Clone(options.IncludeAndroidUser)
+	options.IncludePackage = slices.Clone(options.IncludePackage)
+	options.ExcludePackage = slices.Clone(options.ExcludePackage)
+	// Runtime collaborators do not describe the externally managed Network
+	// Extension settings and must not participate in configuration equality.
+	options.InterfaceFinder = nil
+	options.InterfaceMonitor = nil
+	options.Logger = nil
+	return options
+}
+
+func mustSockaddrUnix(address unix.Sockaddr, err error) (*unix.SockaddrUnix, bool) {
+	if err != nil {
+		return nil, false
+	}
+	unixAddress, ok := address.(*unix.SockaddrUnix)
+	return unixAddress, ok
+}
+
+func (t *rawPacketTun) Name() (string, error) {
+	return rawPacketTunName, nil
+}
+
+func (t *rawPacketTun) Start() error {
+	return nil
+}
+
+func (t *rawPacketTun) Close() error {
+	t.closeOnce.Do(func() {
+		t.closeErr = t.connection.Close()
+	})
+	return t.closeErr
+}
+
+func (t *rawPacketTun) Read(buffer []byte) (int, error) {
+	required := t.mtu + rawPacketTunHeaderSize
+	if len(buffer) < required {
+		return 0, fmt.Errorf("%w: read buffer is %d, need %d", errRawPacketTunInvalidConfiguration, len(buffer), required)
+	}
+	packetLength, _, flags, _, err := t.connection.ReadMsgUnix(buffer[rawPacketTunHeaderSize:required], nil)
+	if err != nil {
+		return 0, err
+	}
+	if flags&unix.MSG_TRUNC != 0 {
+		return 0, errRawPacketTunPacketTruncated
+	}
+	if packetLength == 0 {
+		return 0, io.ErrUnexpectedEOF
+	}
+	addressFamily, err := validateRawIPPacket(buffer[rawPacketTunHeaderSize : rawPacketTunHeaderSize+packetLength])
+	if err != nil {
+		return 0, err
+	}
+	binary.BigEndian.PutUint32(buffer[:rawPacketTunHeaderSize], uint32(addressFamily))
+	return rawPacketTunHeaderSize + packetLength, nil
+}
+
+func (t *rawPacketTun) Write(packetWithHeader []byte) (int, error) {
+	if len(packetWithHeader) < rawPacketTunHeaderSize {
+		return 0, fmt.Errorf("%w: missing Darwin address-family header", errRawPacketTunInvalidPacket)
+	}
+	packet := packetWithHeader[rawPacketTunHeaderSize:]
+	if len(packet) > t.mtu {
+		return 0, fmt.Errorf("%w: packet is %d bytes, MTU is %d", errRawPacketTunInvalidPacket, len(packet), t.mtu)
+	}
+	addressFamily, err := validateRawIPPacket(packet)
+	if err != nil {
+		return 0, err
+	}
+	providedFamily := binary.BigEndian.Uint32(packetWithHeader[:rawPacketTunHeaderSize])
+	if providedFamily != uint32(addressFamily) {
+		return 0, fmt.Errorf("%w: address family %d does not match IP version", errRawPacketTunInvalidPacket, providedFamily)
+	}
+	written, err := t.connection.Write(packet)
+	if err != nil {
+		return 0, err
+	}
+	if written != len(packet) {
+		return 0, io.ErrShortWrite
+	}
+	return len(packetWithHeader), nil
+}
+
+func (t *rawPacketTun) UpdateRouteOptions(options tun.Options) error {
+	if !reflect.DeepEqual(t.configuration, cloneRawPacketTunOptions(options)) {
+		return errRawPacketTunConfigurationChanged
+	}
+	return nil
+}
+
+func validateRawIPPacket(packet []byte) (int, error) {
+	if len(packet) == 0 {
+		return 0, fmt.Errorf("%w: empty packet", errRawPacketTunInvalidPacket)
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < 20 {
+			return 0, fmt.Errorf("%w: truncated IPv4 header", errRawPacketTunInvalidPacket)
+		}
+		headerLength := int(packet[0]&0x0f) * 4
+		if headerLength < 20 || headerLength > len(packet) {
+			return 0, fmt.Errorf("%w: invalid IPv4 header length", errRawPacketTunInvalidPacket)
+		}
+		if int(binary.BigEndian.Uint16(packet[2:4])) != len(packet) {
+			return 0, fmt.Errorf("%w: IPv4 total length mismatch", errRawPacketTunInvalidPacket)
+		}
+		return unix.AF_INET, nil
+	case 6:
+		if len(packet) < 40 {
+			return 0, fmt.Errorf("%w: truncated IPv6 header", errRawPacketTunInvalidPacket)
+		}
+		if 40+int(binary.BigEndian.Uint16(packet[4:6])) != len(packet) {
+			return 0, fmt.Errorf("%w: IPv6 payload length mismatch", errRawPacketTunInvalidPacket)
+		}
+		return unix.AF_INET6, nil
+	default:
+		return 0, fmt.Errorf("%w: unsupported IP version", errRawPacketTunInvalidPacket)
+	}
+}
diff --git a/experimental/libbox/raw_packet_tun_darwin_test.go b/experimental/libbox/raw_packet_tun_darwin_test.go
