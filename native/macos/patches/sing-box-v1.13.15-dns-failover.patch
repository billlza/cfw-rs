@@ -0,0 +1,120 @@
+package dns_test
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func TestNamedDNSPoliciesComposeAndKeepFailuresInTheirOwnRole(t *testing.T) {
+	mainPort, mainQueries := startPolicyTCPWithTTL(t, false, "203.0.113.10", 60)
+	directPort, _ := startPolicyTCPWithTTL(t, false, "203.0.113.20", 60)
+	policyPort, _ := startPolicyTCPWithTTL(t, false, "203.0.113.30", 60)
+	closedPort, _ := startPolicyTCP(t, true, "")
+	var servers []any
+	for index, port := range []int{mainPort, directPort, policyPort, closedPort} {
+		servers = append(servers, map[string]any{"type": "tcp", "tag": fmt.Sprint(index), "server": "127.0.0.1", "server_port": port})
+	}
+	router, transports := startPolicyBox(t, map[string]any{
+		"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+		"dns": map[string]any{"servers": servers, "final": "0", "policies": []any{
+			map[string]any{"tag": "direct", "final": "1", "rules": []any{map[string]any{"domain_suffix": "internal.example", "action": "route", "server": "2"}}},
+			map[string]any{"tag": "failed", "final": "3"},
+		}},
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	for _, item := range []struct{ name, policy, address string }{
+		{"site.example", "default", "203.0.113.10"},
+		{"site.example", "direct", "203.0.113.20"},
+		{"internal.example", "direct", "203.0.113.30"},
+		{"sub.internal.example", "direct", "203.0.113.30"},
+	} {
+		addresses, err := router.Lookup(ctx, item.name, adapter.DNSQueryOptions{Policy: item.policy, Strategy: C.DomainStrategyIPv4Only})
+		if err != nil || len(addresses) != 1 || addresses[0] != netip.MustParseAddr(item.address) {
+			t.Fatalf("%s/%s: %v %v", item.policy, item.name, addresses, err)
+		}
+	}
+	query := new(mdns.Msg)
+	query.SetQuestion("must-not-leak.example.", mdns.TypeA)
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "failed"}); err == nil {
+		t.Fatal("failed role returned success")
+	}
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "missing"}); err == nil {
+		t.Fatal("unknown policy became default DNS")
+	}
+	explicit, _ := transports.Transport("0")
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "direct", Transport: explicit}); err == nil {
+		t.Fatal("conflicting policy and explicit resolver accepted")
+	}
+	if _, seen := mainQueries.Load("must-not-leak.example."); seen {
+		t.Fatal("failed named policy leaked to the ordinary resolver")
+	}
+}
+
+func TestDNSGeoIPAcceptAllRejectsMixedAnswersInEitherOrder(t *testing.T) {
+	for _, answer := range [][]string{{"203.0.113.1", "198.51.100.1"}, {"198.51.100.1", "203.0.113.1"}, {"203.0.113.1", "203.0.113.2"}} {
+		t.Run(answer[0]+"/"+answer[1], func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := &mdns.Server{Listener: listener, Net: "tcp", Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+				r := new(mdns.Msg)
+				r.SetReply(q)
+				for _, address := range answer {
+					record, err := mdns.NewRR(q.Question[0].Name + " 60 IN A " + address)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					r.Answer = append(r.Answer, record)
+				}
+				if err := w.WriteMsg(r); err != nil {
+					t.Error(err)
+				}
+			})}
+			go func() {
+				if err := server.ActivateAndServe(); err != nil {
+					t.Error(err)
+				}
+			}()
+			t.Cleanup(func() {
+				if err := server.Shutdown(); err != nil {
+					t.Error(err)
+				}
+			})
+			fallbackPort, fallbackQueries := startPolicyTCP(t, false, "192.0.2.1")
+			router, transports := startPolicyBox(t, map[string]any{
+				"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+				"route": map[string]any{"rule_set": []any{map[string]any{"type": "inline", "tag": "country", "rules": []any{map[string]any{"ip_cidr": "203.0.113.0/24"}}}}},
+				"dns": map[string]any{"independent_cache": true, "final": "fallback", "servers": []any{
+					map[string]any{"type": "tcp", "tag": "main", "server": "127.0.0.1", "server_port": listener.Addr().(*net.TCPAddr).Port},
+					map[string]any{"type": "tcp", "tag": "fallback", "server": "127.0.0.1", "server_port": fallbackPort},
+				}, "rules": []any{map[string]any{"rule_set": []string{"country"}, "action": "route", "server": "main", "retry_on_error": true, "response_ip_accept_all": true}}},
+			})
+			query := new(mdns.Msg)
+			query.SetQuestion("mixed.example.", mdns.TypeA)
+			main, _ := transports.Transport("main")
+			if _, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{Transport: main}); err != nil {
+				t.Fatal(err)
+			}
+			response, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, queriedFallback := fallbackQueries.Load("mixed.example.")
+			wantFallback := answer[0] == "198.51.100.1" || answer[1] == "198.51.100.1"
+			if queriedFallback != wantFallback {
+				t.Fatalf("fallback=%v expected=%v response=%v", queriedFallback, wantFallback, response)
+			}
+		})
+	}
+}
diff --git a/dns/response_policy.go b/dns/response_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..e30f181944183e81cce3e167128fcaa5ec1652ff
--- /dev/null
+++ b/dns/response_policy.go
@@ -0,0 +1,51 @@
+package dns
+
+import (
+	"github.com/miekg/dns"
+	"net/netip"
+)
+
+// Recheck cached and fresh answers identically. Domain policies and live rule
+// resources can change which addresses are acceptable without changing the
+// resolver's tag. Valid negative answers must not become a retry or DNS leak.
+func responseIsRejected(response *dns.Msg, checker func([]netip.Addr) bool) bool {
+	if checker == nil {
+		return false
+	}
+	if response.Rcode == dns.RcodeNameError {
+		return false
+	}
+	if response.Rcode != dns.RcodeSuccess {
+		return true
+	}
+	if len(response.Answer) == 0 {
+		if _, hasSOA := extractNegativeTTL(response); hasSOA {
+			return false
+		}
+	}
+	return !checker(MessageToAddresses(response))
+}
+
+// A/AAAA can return joined errors. A terminal negative only suppresses retries
+// when every branch is negative; it must not hide an independent I/O failure.
+func onlyNegativeDNSResult(err error) bool {
+	if code, ok := err.(RcodeError); ok {
+		return int(code) == dns.RcodeNameError
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		children := joined.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !onlyNegativeDNSResult(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyNegativeDNSResult(wrapped.Unwrap())
+	}
+	return false
+}
