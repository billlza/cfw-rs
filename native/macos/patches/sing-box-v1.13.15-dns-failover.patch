+func TestRuntimeDeadlinePreventsLaterResolvers(t *testing.T) {
+	entered := make(chan struct{}, 1)
+	release := make(chan struct{})
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &mdns.Server{Listener: listener, Net: "tcp", Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, m *mdns.Msg) {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		<-release
+		w.Close()
+	})}
+	go server.ActivateAndServe()
+	defer func() { close(release); server.Shutdown() }()
+	last, seen := startPolicyTCP(t, false, "192.0.2.9")
+	config := map[string]any{"log": map[string]any{"disabled": true}, "dns": map[string]any{"servers": []any{policyTCP("stalled", listener.Addr().(*net.TCPAddr).Port), policyTCP("last", last)}, "final": "last"}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}}, "route": map[string]any{"default_domain_resolver": "last"}}
+	router, manager := startPolicyBox(t, config)
+	primary, _ := manager.Transport("stalled")
+	fallback, _ := manager.Transport("last")
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	_, err = router.Exchange(ctx, policyQuestion("deadline.example"), adapter.DNSQueryOptions{Transport: primary, FallbackTransports: []adapter.DNSTransport{fallback}})
+	if err == nil || time.Since(started) > time.Second {
+		t.Fatalf("unbounded deadline: %v", err)
+	}
+	select {
+	case <-entered:
+	default:
+		t.Fatal("stalled server was not reached")
+	}
+	if _, ok := seen.Load("deadline.example."); ok {
+		t.Fatal("expired request queried fallback")
+	}
+}
+
+func TestRuntimeDNSPoolRetriesSERVFAILButPreservesNegativeAnswers(t *testing.T) {
+	for _, rcode := range []int{mdns.RcodeServerFailure, mdns.RcodeRefused, mdns.RcodeNameError} {
+		t.Run(mdns.RcodeToString[rcode], func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := &mdns.Server{Listener: listener, Net: "tcp", Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, request *mdns.Msg) {
+				response := new(mdns.Msg).SetRcode(request, rcode)
+				if err := w.WriteMsg(response); err != nil {
+					t.Error(err)
+				}
+			})}
+			go server.ActivateAndServe()
+			t.Cleanup(func() { server.Shutdown() })
+			port, observed := startPolicyTCP(t, false, "127.0.0.1")
+			config := map[string]any{
+				"log":       map[string]any{"disabled": true},
+				"outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+				"dns": map[string]any{"servers": []any{policyTCP("first", listener.Addr().(*net.TCPAddr).Port), policyTCP("last", port)}, "final": "last",
+					"rules": []any{map[string]any{"domain_suffix": "test", "action": "route", "server": "first", "retry_on_error": true}, map[string]any{"domain_suffix": "test", "action": "route", "server": "last"}}},
+				"route": map[string]any{"default_domain_resolver": "last"},
+			}
+			router, _ := startPolicyBox(t, config)
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			response, err := router.Exchange(ctx, new(mdns.Msg).SetQuestion("rcode.test.", mdns.TypeTXT), adapter.DNSQueryOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, usedFallback := observed.Load("rcode.test.")
+			if rcode == mdns.RcodeNameError {
+				if response.Rcode != mdns.RcodeNameError || usedFallback {
+					t.Fatal("NXDOMAIN was changed or retried")
+				}
+			} else if !usedFallback || response.Rcode != mdns.RcodeSuccess || len(response.Answer) != 1 {
+				t.Fatal("server failure did not reach the next configured resolver")
+			}
+		})
+	}
+}
