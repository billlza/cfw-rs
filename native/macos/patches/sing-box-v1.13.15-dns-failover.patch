+// Only an actual local lookup miss permits resolver fallback. A joined error
+// containing a hosts-file I/O failure must remain terminal.
+func onlyHostsMiss(err error) bool {
+	if err == ErrHostsNotFound {
+		return true
+	}
+	if multi, ok := err.(interface{ Unwrap() []error }); ok {
+		causes := multi.Unwrap()
+		if len(causes) == 0 {
+			return false
+		}
+		for _, cause := range causes {
+			if !onlyHostsMiss(cause) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyHostsMiss(wrapped.Unwrap())
+	}
+	return false
