+				proxyURL, _ := url.Parse(fmt.Sprintf("http://127.0.0.1:%d", port))
+				transport := &http.Transport{Proxy: http.ProxyURL(proxyURL)}
+				defer transport.CloseIdleConnections()
+				client := &http.Client{Transport: transport, Timeout: 2 * time.Second}
+				names := []string{"special.example.org", "direct.example.com"}
+				if file == "named.json" {
+					names = append(names, "direct.example.org")
+				}
+				for _, name := range names {
+					response, err := client.Get("http://" + net.JoinHostPort(name, targetPort))
+					if err != nil {
+						t.Fatal(err)
+					}
+					body, _ := io.ReadAll(response.Body)
+					response.Body.Close()
+					if string(body) != "policy-ok" {
+						t.Fatal("wrong response")
+					}
+				}
+				if file == "named.json" {
+					if _, seen := observed["cfw-policy-dns-0-0"].Load("direct.example.org."); !seen {
+						t.Fatal("direct follow-policy skipped the matching domain policy")
+					}
+					if _, seen := observed["cfw-direct-dns-0"].Load("direct.example.org."); seen {
+						t.Fatal("direct follow-policy ignored its domain policy")
+					}
+				}
+				if _, ok := observed["cfw-direct-dns-0"].Load("direct.example.com."); !ok {
+					t.Fatal("direct resolver unused")
+				}
+				for tag, seen := range observed {
+					if tag == "cfw-direct-dns-0" {
+						continue
+					}
+					if _, ok := seen.Load("direct.example.com."); ok {
+						t.Fatalf("direct query leaked to %s", tag)
+					}
+				}
+			}
+		})
+	}
+}
