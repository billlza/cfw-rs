+package dns
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"testing"
+)
+
+func TestHostsMissDoesNotHideAJointIOFailure(t *testing.T) {
+	if !onlyHostsMiss(fmt.Errorf("lookup: %w", errors.Join(ErrHostsNotFound, ErrHostsNotFound))) {
+		t.Fatal("wrapped hosts absence rejected")
+	}
+	for _, err := range []error{nil, os.ErrPermission, errors.Join(ErrHostsNotFound, os.ErrPermission)} {
+		if onlyHostsMiss(err) {
+			t.Fatal("non-miss error admitted fallback")
+		}
+	}
+}
diff --git a/dns/policy.go b/dns/policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..9f7505d2dfe8733811e14362c2597c1ea0d1f091
--- /dev/null
+++ b/dns/policy.go
@@ -0,0 +1,98 @@
+package dns
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	R "github.com/sagernet/sing-box/route/rule"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+type dnsPolicy struct {
+	rules []adapter.DNSRule
+	final string
+}
+
+func (r *Router) ValidateDNSPolicy(policy string) error {
+	return r.validatePolicy(adapter.DNSQueryOptions{Policy: policy})
+}
+
+func routerInitializePolicies(r *Router) error {
+	if len(r.policyOptions) > 8 {
+		return E.New("at most eight named DNS policies are supported")
+	}
+	r.policies = make(map[string]dnsPolicy, len(r.policyOptions))
+	for _, source := range r.policyOptions {
+		if source.Tag == "" || source.Tag == "default" || len(source.Tag) > 128 || source.Final == "" || len(source.Rules) > 4096 {
+			return E.New("invalid named DNS policy")
+		}
+		if _, exists := r.policies[source.Tag]; exists {
+			return E.New("duplicate DNS policy: ", source.Tag)
+		}
+		policy := dnsPolicy{final: source.Final}
+		for index, sourceRule := range source.Rules {
+			rule, err := R.NewDNSRule(r.ctx, r.logger, sourceRule, true)
+			if err != nil {
+				return E.Cause(err, "parse DNS policy ", source.Tag, " rule[", index, "]")
+			}
+			policy.rules = append(policy.rules, rule)
+		}
+		r.policies[source.Tag] = policy
+	}
+	r.policyOptions = nil
+	return nil
+}
+
+func (r *Router) startPolicies() error {
+	for tag, policy := range r.policies {
+		if _, found := r.transport.Transport(policy.final); !found {
+			return E.New("DNS policy ", tag, " final server not found: ", policy.final)
+		}
+		for index, rule := range policy.rules {
+			if err := rule.Start(); err != nil {
+				return E.Cause(err, "start DNS policy ", tag, " rule[", index, "]")
+			}
+		}
+	}
+	return nil
+}
+
+func (r *Router) closePolicies() error {
+	var errs []error
+	for tag, policy := range r.policies {
+		for index, rule := range policy.rules {
+			if err := rule.Close(); err != nil {
+				errs = append(errs, E.Cause(err, "close DNS policy ", tag, " rule[", index, "]"))
+			}
+		}
+	}
+	return E.Errors(errs...)
+}
+
+func (r *Router) validatePolicy(options adapter.DNSQueryOptions) error {
+	if options.Policy == "" {
+		return nil
+	}
+	if options.Transport != nil || options.FallbackTransport != nil || len(options.FallbackTransports) != 0 {
+		return E.New("DNS policy cannot be combined with explicit resolver transports")
+	}
+	if options.Policy != "default" {
+		policy, found := r.policies[options.Policy]
+		if !found {
+			return E.New("DNS policy not found: ", options.Policy)
+		}
+		if _, found := r.transport.Transport(policy.final); !found {
+			return E.New("DNS policy final server is unavailable: ", policy.final)
+		}
+	}
+	return nil
+}
+
+// validatePolicy runs before either query path reaches this method. A missing
+// final transport after startup is an unavailable configuration, never default DNS.
+func (r *Router) policyRules(tag string) ([]adapter.DNSRule, adapter.DNSTransport) {
+	if tag == "" || tag == "default" {
+		return r.rules, r.transport.Default()
+	}
+	policy := r.policies[tag]
+	transport, _ := r.transport.Transport(policy.final)
+	return policy.rules, transport
+}
