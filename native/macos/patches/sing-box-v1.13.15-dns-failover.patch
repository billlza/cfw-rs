+func TestDNSRuleFallbackHasAGlobalEightAttemptBudget(t *testing.T) {
+	for _, lookup := range []bool{false, true} {
+		client := newFallbackDNSClient()
+		unavailable := errors.New("resolver unavailable")
+		client.exchangeErrors["primary"] = unavailable
+		client.lookupErrors["primary"] = unavailable
+		router := newFallbackRouter(client)
+		for i := 0; i < maxDNSAttempts+2; i++ {
+			router.rules = append(router.rules, new(fallbackDNSRule))
+		}
+		var err error
+		var count int
+		if lookup {
+			_, err = router.Lookup(context.Background(), "example.test", adapter.DNSQueryOptions{})
+			count = client.lookupCalls["primary"]
+		} else {
+			_, err = router.Exchange(context.Background(), testDNSQuestion(mDNS.TypeA), adapter.DNSQueryOptions{})
+			count = client.exchangeCalls["primary"]
+		}
+		if !errors.Is(err, unavailable) || count != maxDNSAttempts {
+			t.Fatalf("bounded errors were not retained: count=%d err=%v", count, err)
+		}
+	}
+}
