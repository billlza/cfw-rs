+func TestDNSFallbackDependenciesAreOrderedAndValidated(t *testing.T) {
+	domainResolver := &option.DomainResolveOptions{Server: "primary", FallbackServer: "secondary"}
+	transportAdapter := NewTransportAdapterWithRemoteOptions("https", "dependent", option.RemoteDNSServerOptions{
+		RawLocalDNSServerOptions: option.RawLocalDNSServerOptions{
+			DialerOptions: option.DialerOptions{DomainResolver: domainResolver},
+		},
+	})
+	if !slices.Equal(transportAdapter.Dependencies(), []string{"primary", "secondary"}) {
+		t.Fatalf("fallback resolver was omitted from dependencies: %v", transportAdapter.Dependencies())
+	}
+
+	t.Run("dependencies start first", func(t *testing.T) {
+		var startOrder []string
+		primary := &fallbackDNSTransport{tag: "primary", startOrder: &startOrder}
+		secondary := &fallbackDNSTransport{tag: "secondary", startOrder: &startOrder}
+		dependent := &fallbackDNSTransport{
+			tag:          "dependent",
+			dependencies: []string{"primary", "secondary"},
+			startOrder:   &startOrder,
+		}
+		manager := NewTransportManager(logger.NOP(), nil, nil, "")
+		manager.transportByTag = map[string]adapter.DNSTransport{
+			"primary": primary, "secondary": secondary, "dependent": dependent,
+		}
+		if err := manager.startTransports([]adapter.DNSTransport{dependent, secondary, primary}); err != nil {
+			t.Fatalf("start transports: %v", err)
+		}
+		dependentIndex := slices.Index(startOrder, "dependent")
+		if dependentIndex < 0 || slices.Index(startOrder, "primary") >= dependentIndex || slices.Index(startOrder, "secondary") >= dependentIndex {
+			t.Fatalf("dependent started before both resolvers: %v", startOrder)
+		}
+	})
+
+	t.Run("missing dependency fails", func(t *testing.T) {
+		dependent := &fallbackDNSTransport{tag: "dependent", dependencies: []string{"missing"}}
+		manager := NewTransportManager(logger.NOP(), nil, nil, "")
+		manager.transportByTag["dependent"] = dependent
+		err := manager.startTransports([]adapter.DNSTransport{dependent})
+		if err == nil || !strings.Contains(err.Error(), "dependency[missing] not found") {
+			t.Fatalf("missing fallback dependency was not rejected: %v", err)
+		}
+	})
+
+	t.Run("dependency cycle fails", func(t *testing.T) {
+		primary := &fallbackDNSTransport{tag: "primary", dependencies: []string{"secondary"}}
+		secondary := &fallbackDNSTransport{tag: "secondary", dependencies: []string{"primary"}}
+		manager := NewTransportManager(logger.NOP(), nil, nil, "")
+		manager.transportByTag = map[string]adapter.DNSTransport{
+			"primary": primary, "secondary": secondary,
+		}
+		err := manager.startTransports([]adapter.DNSTransport{primary, secondary})
+		if err == nil || !strings.Contains(err.Error(), "circular server dependency") {
+			t.Fatalf("fallback dependency cycle was not rejected: %v", err)
+		}
+	})
+}
