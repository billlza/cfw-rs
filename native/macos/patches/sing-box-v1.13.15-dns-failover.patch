+func startPolicyTCPWithTTL(t *testing.T, fail bool, answer string, ttl uint32) (int, *sync.Map) {
+	t.Helper()
+	seen := new(sync.Map)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &mdns.Server{Listener: listener, Net: "tcp", Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, m *mdns.Msg) {
+		seen.Store(m.Question[0].Name, true)
+		if fail {
+			w.Close()
+			return
+		}
+		r := new(mdns.Msg)
+		r.SetReply(m)
+		var answerText string
+		switch m.Question[0].Qtype {
+		case mdns.TypeA:
+			answerText = "A " + answer
+		case mdns.TypeTXT:
+			answerText = "TXT \"policy-ok\""
+		case mdns.TypeMX:
+			answerText = "MX 10 mail.example."
+		case mdns.TypeHTTPS:
+			answerText = "HTTPS 1 . alpn=\"h3\" ipv4hint=127.0.0.1"
+		}
+		if answerText != "" {
+			rr, err := mdns.NewRR(fmt.Sprintf("%s %d IN %s", m.Question[0].Name, ttl, answerText))
+			if err != nil {
+				t.Error(err)
+				w.Close()
+				return
+			}
+			r.Answer = []mdns.RR{rr}
+		}
+		w.WriteMsg(r)
+	})}
+	go server.ActivateAndServe()
+	t.Cleanup(func() { server.Shutdown() })
+	return listener.Addr().(*net.TCPAddr).Port, seen
+}
