+	config := map[string]any{"log": map[string]any{"disabled": true}, "dns": map[string]any{"servers": []any{policyTCP("first", first), policyTCP("second", second), policyTCP("third", third), policyTCP("last-failure", finalFailure)}, "final": "third"}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}}, "route": map[string]any{"default_domain_resolver": map[string]any{"server": "first", "fallback_servers": []string{"second", "third"}}}}
+	router, manager := startPolicyBox(t, config)
+	primary, _ := manager.Transport("first")
+	secondary, _ := manager.Transport("second")
+	last, _ := manager.Transport("third")
+	opts := adapter.DNSQueryOptions{Transport: primary, FallbackTransports: []adapter.DNSTransport{secondary, last}}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	response, err := router.Exchange(ctx, policyQuestion("third-success.example"), opts)
+	if err != nil || len(response.Answer) != 1 {
