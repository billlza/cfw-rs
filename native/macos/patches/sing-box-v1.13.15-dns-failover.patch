+func TestRuntimeCFMFilteredResponsesAndPolicyFailureIsolation(t *testing.T) {
+	dir := os.Getenv("CFW_DNS_PROJECTED_FIXTURE_DIR")
+	if dir == "" {
+		t.Skip("Rust projection fixtures not supplied")
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "filter.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config map[string]any
+	if err = json.Unmarshal(data, &config); err != nil {
+		t.Fatal(err)
+	}
+	delete(config, "experimental")
+	delete(config, "inbounds")
+	config["log"] = map[string]any{"disabled": true}
+	proxyPort := localPolicySOCKS(t)
+	observed := map[string]*sync.Map{}
+	for _, raw := range config["dns"].(map[string]any)["servers"].([]any) {
+		server := raw.(map[string]any)
+		tag := server["tag"].(string)
+		answer := "127.0.0.1"
+		if tag == "cfw-profile-dns-0" {
+			answer = "240.0.0.1"
+		}
+		port, seen := startPolicyTCP(t, tag == "cfw-policy-dns-1-0", answer)
+		observed[tag] = seen
+		server["server"] = "127.0.0.1"
+		server["type"] = "tcp"
+		server["server_port"] = port
+	}
+	config["outbounds"].([]any)[0].(map[string]any)["server_port"] = proxyPort
+	router, _ := startPolicyBox(t, config)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	for _, name := range []string{"filtered.example.net", "force.fallback.example"} {
+		response, err := router.Exchange(ctx, policyQuestion(name), adapter.DNSQueryOptions{})
+		if err != nil || len(response.Answer) != 1 {
+			t.Fatalf("filter %s: %v", name, err)
+		}
+		if response.Answer[0].(*mdns.A).A.String() != "127.0.0.1" {
+			t.Fatal("rejected primary response escaped")
+		}
+		if _, ok := observed["cfw-fallback-dns-0"].Load(name + "."); !ok {
+			t.Fatal("fallback resolver was not reached")
+		}
+	}
+	for _, qtype := range []uint16{mdns.TypeTXT, mdns.TypeMX} {
+		name := fmt.Sprintf("non-address-filter-%d.example.net.", qtype)
+		response, err := router.Exchange(ctx, new(mdns.Msg).SetQuestion(name, qtype), adapter.DNSQueryOptions{})
+		if err != nil || len(response.Answer) != 1 {
+			t.Fatalf("non-address filter: %v", err)
+		}
+		if _, ok := observed["cfw-profile-dns-0"].Load(name); !ok {
+			t.Fatal("non-address query bypassed the primary")
+		}
+		if _, ok := observed["cfw-fallback-dns-0"].Load(name); ok {
+			t.Fatal("IP filter incorrectly affected a non-address answer")
+		}
+	}
+	if _, ok := observed["cfw-profile-dns-0"].Load("force.fallback.example."); ok {
+		t.Fatal("forced fallback domain queried ordinary DNS")
+	}
+	_, err = router.Exchange(ctx, policyQuestion("special.example.org"), adapter.DNSQueryOptions{})
+	if err == nil {
+		t.Fatal("failed domain policy fell through to another pool")
+	}
+	for _, tag := range []string{"cfw-profile-dns-0", "cfw-fallback-dns-0", "cfw-bootstrap-dns-0"} {
+		if _, ok := observed[tag].Load("special.example.org."); ok {
+			t.Fatalf("failed policy escaped to %s", tag)
+		}
+	}
+}
