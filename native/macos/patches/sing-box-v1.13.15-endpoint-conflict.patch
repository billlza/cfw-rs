index 0000000000000000000000000000000000000000..fc4e119b199fd8c12f5dd1c5b13a758bf89d66d6
--- /dev/null
+++ b/experimental/clashapi/endpoint_conflict_test.go
@@ -0,0 +1,37 @@
+package clashapi
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+func TestClassifyControllerListenError(t *testing.T) {
+	cause := fmt.Errorf("listen failed: %w", syscall.EADDRINUSE)
+	err := classifyControllerListenError("127.0.0.1:9092", cause)
+	role, port, ok := adapter.EndpointConflictFromError(err)
+	if !ok || role != adapter.EndpointConflictController || port != 9092 || !errors.Is(err, cause) {
+		t.Fatalf("unexpected controller conflict: role=%v port=%d ok=%v err=%v", role, port, ok, err)
+	}
+}
+
+func TestClassifyControllerListenErrorRejectsOtherAndMalformedErrors(t *testing.T) {
+	ordinary := errors.New("permission denied")
+	for _, test := range []struct {
+		address string
+		err     error
+	}{
+		{"127.0.0.1:9092", ordinary},
+		{"127.0.0.1", syscall.EADDRINUSE},
+		{"127.0.0.1:0", syscall.EADDRINUSE},
+		{"127.0.0.1:65536", syscall.EADDRINUSE},
+	} {
+		classified := classifyControllerListenError(test.address, test.err)
+		if classified != test.err {
+			t.Fatalf("unexpected classification for %q: %v", test.address, classified)
+		}
+	}
+}
diff --git a/experimental/clashapi/server.go b/experimental/clashapi/server.go
index 950dca0408f22431f1d89604e4a4f4b8b2dcac94..d5d32186b41cfff548bc21b15d456854bb49f042 100644
--- a/experimental/clashapi/server.go
+++ b/experimental/clashapi/server.go
@@ -10,0 +11 @@ import (
+	"strconv"
@@ -175,0 +177 @@ func (s *Server) Start(stage adapter.StartStage) error {
+				err = classifyControllerListenError(s.httpServer.Addr, err)
@@ -190,0 +193,16 @@ func (s *Server) Start(stage adapter.StartStage) error {
+func classifyControllerListenError(address string, err error) error {
+	if !errors.Is(err, syscall.EADDRINUSE) {
+		return err
+	}
+	_, portText, splitErr := net.SplitHostPort(address)
+	port, portErr := strconv.ParseUint(portText, 10, 16)
+	if splitErr != nil || portErr != nil || port == 0 {
+		return err
+	}
+	return adapter.NewEndpointConflictError(
+		adapter.EndpointConflictController,
+		uint16(port),
+		err,
+	)
+}
+
diff --git a/experimental/libbox/command_server.go b/experimental/libbox/command_server.go
index 1ecf9a1f0b982a8b7b4ed817176f578595879805..2d351c118fadebeb58b6068a1992836d32792f82 100644
--- a/experimental/libbox/command_server.go
+++ b/experimental/libbox/command_server.go
@@ -204,0 +205,46 @@ func (s *CommandServer) CloseService() error {
+const (
+	RuntimeEndpointConflictMixed      int32 = int32(adapter.EndpointConflictMixed)
+	RuntimeEndpointConflictController int32 = int32(adapter.EndpointConflictController)
+)
+
+type RuntimeStartConflict struct {
+	Kind int32
+	Port int32
+}
+
+// StartOrReloadServiceReportingConflict preserves every ordinary start error.
+// Only an exact product listener EADDRINUSE is converted to structured data so
+// the embedding application can retry after its own cleanup and Off proof.
+func (s *CommandServer) StartOrReloadServiceReportingConflict(configContent string, options *OverrideOptions) (*RuntimeStartConflict, error) {
+	err := s.StartOrReloadService(configContent, options)
+	if err == nil {
+		return nil, nil
+	}
+	conflict := runtimeStartConflict(err)
+	if conflict == nil {
+		return nil, err
+	}
+	return conflict, nil
+}
+
+func runtimeStartConflict(err error) *RuntimeStartConflict {
+	if containsMultiError(err) || !errors.Is(err, syscall.EADDRINUSE) {
+		return nil
+	}
+	role, port, isConflict := adapter.EndpointConflictFromError(err)
+	if !isConflict || port == 0 || (role != adapter.EndpointConflictMixed && role != adapter.EndpointConflictController) {
+		return nil
+	}
+	return &RuntimeStartConflict{Kind: int32(role), Port: int32(port)}
+}
+
+func containsMultiError(err error) bool {
+	for err != nil {
+		if _, ok := err.(interface{ Unwrap() []error }); ok {
+			return true
+		}
+		err = errors.Unwrap(err)
+	}
+	return false
+}
+
diff --git a/experimental/libbox/endpoint_conflict_test.go b/experimental/libbox/endpoint_conflict_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..34e4602ab060d563349c153be9cb942e6d6518c7
--- /dev/null
+++ b/experimental/libbox/endpoint_conflict_test.go
@@ -0,0 +1,41 @@
+package libbox
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+func TestRuntimeStartConflictPreservesExactRoleAndPort(t *testing.T) {
+	err := fmt.Errorf(
+		"start service: %w",
+		adapter.NewEndpointConflictError(adapter.EndpointConflictController, 9092, syscall.EADDRINUSE),
+	)
+	conflict := runtimeStartConflict(err)
+	if conflict == nil || conflict.Kind != RuntimeEndpointConflictController || conflict.Port != 9092 {
+		t.Fatalf("unexpected runtime conflict: %#v", conflict)
+	}
+}
+
+func TestRuntimeStartConflictRejectsOrdinaryAndMalformedErrors(t *testing.T) {
+	for _, err := range []error{
+		syscall.EADDRINUSE,
+		errors.New("ordinary startup failure"),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, errors.New("wrong cause")),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, nil),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictNone, 9090, syscall.EADDRINUSE),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 0, syscall.EADDRINUSE),
+		E.Errors(
+			adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, syscall.EADDRINUSE),
+			errors.New("cleanup failed"),
+		),
+	} {
+		if conflict := runtimeStartConflict(err); conflict != nil {
+			t.Fatalf("unexpected retryable conflict for %v: %#v", err, conflict)
+		}
+	}
+}
