+++ b/protocol/group/health_policy_test.go
@@ -0,0 +1,90 @@
+package group
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/service"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHealthPoliciesDoNotBorrowAnotherURLsSuccess(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/ok" {
+			w.WriteHeader(204)
+		} else {
+			w.WriteHeader(503)
+		}
+	}))
+	defer server.Close()
+	node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}}
+	manager := healthProbeTestManager{node: node}
+	ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+	first, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL+"/ok", time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	first.expectedStatus = "204"
+	if result, err := first.URLTest(ctx); err != nil || len(result) != 1 {
+		t.Fatalf("first: %v %v", result, err)
+	}
+	second, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL+"/bad", time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	second.expectedStatus = "204"
+	result, err := second.urlTest(ctx, false)
+	if err != nil || len(result) != 0 || second.history.LoadURLTestHistory("node") != nil {
+		t.Fatal("provider reused a different URL's success")
+	}
+	if first.history.LoadURLTestHistory("node") == nil {
+		t.Fatal("one provider's failure erased another policy")
+	}
+}
+
+func TestOverlappingHealthChecksCoalesceAndReturnObservedResults(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		once.Do(func() { close(started) })
+		<-release
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}}
+	g, err := NewURLTestGroup(context.Background(), healthProbeTestManager{node: node}, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL, time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer g.Close()
+	first := make(chan map[string]uint16, 1)
+	go func() {
+		result, err := g.URLTest(context.Background())
+		if err != nil {
+			t.Error(err)
+		}
+		first <- result
+	}()
+	<-started
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if _, err := g.URLTest(ctx); err == nil {
+		t.Fatal("waiting caller cancellation became empty success")
+	}
+	close(release)
+	if result := <-first; len(result) != 1 {
+		t.Fatal("coalesced run lost its result")
+	}
+}
diff --git a/protocol/group/loadbalance.go b/protocol/group/loadbalance.go
new file mode 100644
index 0000000000000000000000000000000000000000..179035d2cf00b0795202898c8adf2ebce7d43a6f
--- /dev/null
+++ b/protocol/group/loadbalance.go
@@ -0,0 +1,138 @@
+package group
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/cache"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	"golang.org/x/net/publicsuffix"
+)
+
+const maxStickySessions = 1024
+
+type loadBalancePolicy struct {
+	strategy string
+	cursor   atomic.Uint64
+	// Serialize the cache's value access as well as mutation. The upstream LRU
+	// protects its index, but Load returns a value after releasing its index lock.
+	access   sync.Mutex
+	sessions *cache.LruCache[string, string]
+}
+
+func NewLoadBalance(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.LoadBalanceOutboundOptions) (adapter.Outbound, error) {
+	if options.InterruptExistConnections {
+		return nil, E.New("load-balance keeps established sessions on their original outbound")
+	}
+	strategy := options.Strategy
+	if strategy == "" {
+		strategy = "consistent-hashing"
+	}
+	if strategy != "consistent-hashing" && strategy != "sticky-sessions" && strategy != "round-robin" {
+		return nil, E.New("unsupported load-balance strategy")
+	}
+	proxy, err := newHealthCheckGroup(ctx, router, logger, tag, option.URLTestOutboundOptions{
+		Outbounds: options.Outbounds, URL: options.URL, Interval: options.Interval,
+		IdleTimeout: options.IdleTimeout, Lazy: options.Lazy, Hidden: options.Hidden, Timeout: options.Timeout, ExpectedStatus: options.ExpectedStatus,
+	}, C.TypeLoadBalance)
+	if err != nil {
+		return nil, err
+	}
+	proxy.balance = &loadBalancePolicy{strategy: strategy,
+		sessions: cache.New[string, string](cache.WithSize[string, string](maxStickySessions), cache.WithAge[string, string](600))}
+	return proxy, nil
+}
+
+func balanceDestination(destination M.Socksaddr) string {
+	if !destination.IsDomain() {
+		return destination.Addr.Unmap().String()
+	}
+	host := strings.TrimSuffix(strings.ToLower(destination.Fqdn), ".")
+	if domain, err := publicsuffix.EffectiveTLDPlusOne(host); err == nil {
+		return domain
+	}
+	return host
+}
+
+func balanceKey(ctx context.Context, destination M.Socksaddr, sticky bool) string {
+	key := balanceDestination(destination)
+	if sticky {
+		source := ""
+		if metadata := adapter.ContextFrom(ctx); metadata != nil && metadata.Source.Addr.IsValid() {
+			source = metadata.Source.Addr.Unmap().String()
+		}
+		key = source + "\x00" + key
+	}
+	return key
+}
+
+func (s *URLTest) connectionCandidates(ctx context.Context, network string, destination M.Socksaddr) []adapter.Outbound {
+	candidates := s.group.orderedCandidates(network)
+	if s.balance == nil || len(candidates) == 0 {
+		return candidates
+	}
+	p := s.balance
+	if p.strategy == "round-robin" {
+		first := int((p.cursor.Add(1) - 1) % uint64(len(candidates)))
+		return append(candidates[first:], candidates[:first]...)
+	}
+	key := balanceKey(ctx, destination, p.strategy == "sticky-sessions")
+	// Rendezvous hashing depends on member identities, not their list positions.
+	// Adding/removing a member does not reshuffle unrelated destinations.
+	type scored struct {
+		outbound adapter.Outbound
+		score    uint64
+	}
+	scores := make([]scored, len(candidates))
+	for i, node := range candidates {
+		digest := sha256.Sum256([]byte(key + "\x00" + node.Tag()))
+		scores[i] = scored{node, binary.BigEndian.Uint64(digest[:8])}
+	}
+	sort.Slice(scores, func(i, j int) bool {
+		if scores[i].score == scores[j].score {
+			return scores[i].outbound.Tag() < scores[j].outbound.Tag()
+		}
+		return scores[i].score > scores[j].score
+	})
+	for i, node := range scores {
+		candidates[i] = node.outbound
+	}
+	if p.strategy == "sticky-sessions" {
+		p.access.Lock()
+		selected, exists := p.sessions.Load(key)
+		p.access.Unlock()
+		if exists {
+			for i, node := range candidates {
+				if node.Tag() == selected {
+					copy(candidates[1:i+1], candidates[:i])
+					candidates[0] = node
+					break
+				}
+			}
+		}
+	}
+	return candidates
+}
+
+func (s *URLTest) rememberConnection(ctx context.Context, destination M.Socksaddr, tag string) {
+	if s.balance == nil || s.balance.strategy != "sticky-sessions" {
+		return
+	}
+	p := s.balance
+	key := balanceKey(ctx, destination, true)
+	p.access.Lock()
+	defer p.access.Unlock()
+	if current, exists := p.sessions.Load(key); !exists || current != tag {
+		p.sessions.Store(key, tag)
+	}
+}
