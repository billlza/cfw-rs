@@ -75,0 +79,46 @@ func (s *HistoryStorage) Close() error {
+// ParseExpectedStatus accepts slash-separated HTTP codes or inclusive ranges.
+// An empty policy accepts any response, preserving the default URL-test contract.
+func ParseExpectedStatus(policy string) (func(int) bool, error) {
+	if len(policy) > 128 {
+		return nil, errors.New("expected HTTP status is too long")
+	}
+	if policy == "" {
+		return func(int) bool { return true }, nil
+	}
+	var allowed [600]bool
+	for _, item := range strings.Split(policy, "/") {
+		parts := strings.Split(item, "-")
+		if len(parts) < 1 || len(parts) > 2 {
+			return nil, errors.New("invalid HTTP status range")
+		}
+		var codes []int
+		for _, part := range parts {
+			code, err := strconv.Atoi(part)
+			if err != nil || len(part) != 3 || code < 100 || code > 599 {
+				return nil, errors.New("invalid expected HTTP status")
+			}
+			codes = append(codes, code)
+		}
+		low, high := codes[0], codes[len(codes)-1]
+		if low > high {
+			return nil, errors.New("reversed HTTP status range")
+		}
+		for code := low; code <= high; code++ {
+			allowed[code] = true
+		}
+	}
+	return func(code int) bool { return code >= 100 && code < len(allowed) && allowed[code] }, nil
+}
+
+func ValidateProbeTarget(link string) error {
+	if link == "" {
+		return nil
+	}
+	parsed, err := url.Parse(link)
+	if err != nil || len(link) > 2048 || strings.IndexFunc(link, func(r rune) bool { return r <= ' ' || r == 127 }) >= 0 ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") || parsed.Hostname() == "" || parsed.User != nil || parsed.Fragment != "" || parsed.Port() == "0" {
+		return errors.New("invalid health-check URL")
+	}
+	return nil
+}
