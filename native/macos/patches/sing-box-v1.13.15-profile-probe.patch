+package urltest
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type statusDialer struct{ calls atomic.Int32 }
+
+func (d *statusDialer) DialContext(ctx context.Context, network string, address M.Socksaddr) (net.Conn, error) {
+	d.calls.Add(1)
+	return (&net.Dialer{}).DialContext(ctx, network, address.String())
+}
+func (d *statusDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("unexpected UDP")
+}
+
+func TestHealthStatusAndCancellationUseTheConfiguredTarget(t *testing.T) {
+	var path atomic.Value
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		path.Store(r.URL.Path)
+		if r.URL.Path == "/wait" {
+			<-r.Context().Done()
+			return
+		}
+		if r.URL.Path == "/unavailable" {
+			w.WriteHeader(503)
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	dialer := new(statusDialer)
+	for _, check := range []struct {
+		path, expected string
+		success        bool
+	}{
+		{"/configured", "204", true}, {"/configured", "200-299/304", true},
+		{"/unavailable", "204", false}, {"/unavailable", "", true},
+	} {
+		delay, err := URLTestWithStatus(context.Background(), server.URL+check.path, check.expected, dialer)
+		if (err == nil) != check.success || (check.success && delay == 0) {
+			t.Fatalf("%s policy %s: delay=%d error=%v", check.path, check.expected, delay, err)
+		}
+		if path.Load() != check.path {
+			t.Fatal("probe URL silently changed")
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 80*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	if _, err := URLTestWithStatus(ctx, server.URL+"/wait", "204", dialer); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("cancellation became %v", err)
+	}
+	if time.Since(started) > time.Second {
+		t.Fatal("request ignored its deadline")
+	}
+	before := dialer.calls.Load()
+	for _, expected := range []string{"299-200", "600", "200/", "20", "+20"} {
+		if _, err := URLTestWithStatus(context.Background(), server.URL, expected, dialer); err == nil {
+			t.Fatal("invalid policy accepted")
+		}
+	}
+	if dialer.calls.Load() != before {
+		t.Fatal("invalid policy made a network request")
+	}
+}
