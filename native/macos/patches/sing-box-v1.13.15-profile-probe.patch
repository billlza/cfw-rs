diff --git a/protocol/group/fallback.go b/protocol/group/fallback.go
new file mode 100644
index 0000000000000000000000000000000000000000..834a3a435c142048640b0db185ae435aad992c3a
--- /dev/null
+++ b/protocol/group/fallback.go
@@ -0,0 +1,94 @@
+package group
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/interrupt"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// A connection attempt captures one bounded, priority-ordered candidate list.
+// Existing streams/associations keep their original outbound. Retry ends at the
+// first established connection; application payload is never replayed.
+func (g *URLTestGroup) orderedCandidates(network string) []adapter.Outbound {
+	var healthy, untested []adapter.Outbound
+	for _, detour := range g.outbounds {
+		if !common.Contains(detour.Network(), network) {
+			continue
+		}
+		if g.history.LoadURLTestHistory(RealTag(detour)) != nil {
+			healthy = append(healthy, detour)
+		} else if !g.probed.Load() {
+			untested = append(untested, detour)
+		}
+	}
+	return append(healthy, untested...)
+}
+
+func (s *URLTest) dialCandidates(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	networkName := N.NetworkName(network)
+	if networkName != N.NetworkTCP && networkName != N.NetworkUDP {
+		return nil, E.Extend(N.ErrUnknownNetwork, network)
+	}
+	ctx, cancel := context.WithTimeout(ctx, C.TCPTimeout)
+	defer cancel()
+	var lastErr error
+	for _, detour := range s.connectionCandidates(ctx, networkName, destination) {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if interrupt.IsExternalConnectionFromContext(ctx) {
+			adapter.TouchOutboundActivity(ctx, detour.Tag())
+		}
+		conn, err := detour.DialContext(ctx, network, destination)
+		if err == nil {
+			s.rememberConnection(ctx, destination, detour.Tag())
+			return s.group.interruptGroup.NewConn(conn, interrupt.IsExternalConnectionFromContext(ctx)), nil
+		}
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		s.logger.DebugContext(ctx, "fallback outbound ", detour.Tag(), ": ", err)
+		s.group.history.DeleteURLTestHistory(RealTag(detour))
+		lastErr = err
+	}
+	if lastErr != nil {
+		return nil, E.Cause(lastErr, "health-checked members failed")
+	}
+	return nil, E.New("no healthy outbound supports ", networkName)
+}
+
+func (s *URLTest) listenPacketCandidates(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, cancel := context.WithTimeout(ctx, C.TCPTimeout)
+	defer cancel()
+	var lastErr error
+	for _, detour := range s.connectionCandidates(ctx, N.NetworkUDP, destination) {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if interrupt.IsExternalConnectionFromContext(ctx) {
+			adapter.TouchOutboundActivity(ctx, detour.Tag())
+		}
+		conn, err := detour.ListenPacket(ctx, destination)
+		if err == nil {
+			s.rememberConnection(ctx, destination, detour.Tag())
+			return s.group.interruptGroup.NewPacketConn(conn, interrupt.IsExternalConnectionFromContext(ctx)), nil
+		}
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		s.logger.DebugContext(ctx, "fallback UDP outbound ", detour.Tag(), ": ", err)
+		s.group.history.DeleteURLTestHistory(RealTag(detour))
+		lastErr = err
+	}
+	if lastErr != nil {
+		return nil, E.Cause(lastErr, "health-checked UDP members failed")
+	}
+	return nil, E.New("no healthy outbound supports UDP")
+}
