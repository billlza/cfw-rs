diff --git a/adapter/outbound/activity.go b/adapter/outbound/activity.go
new file mode 100644
index 0000000000000000000000000000000000000000..62322c06922e3ffb7fc7e74a44c21c9d806c8e54
--- /dev/null
+++ b/adapter/outbound/activity.go
@@ -0,0 +1,51 @@
+package outbound
+
+import "sync"
+
+type activitySubscription struct{ touch func() }
+type outboundActivity struct {
+	access      sync.RWMutex
+	subscribers map[string]map[*activitySubscription]struct{}
+}
+
+// WatchOutboundActivity belongs to this manager's lifetime. Callbacks run
+// outside its lock; cancelling a watcher is idempotent and releases its tags.
+func (m *Manager) WatchOutboundActivity(tags []string, touch func()) func() {
+	watcher := &activitySubscription{touch: touch}
+	m.activity.access.Lock()
+	if m.activity.subscribers == nil {
+		m.activity.subscribers = make(map[string]map[*activitySubscription]struct{})
+	}
+	for _, tag := range tags {
+		if m.activity.subscribers[tag] == nil {
+			m.activity.subscribers[tag] = make(map[*activitySubscription]struct{})
+		}
+		m.activity.subscribers[tag][watcher] = struct{}{}
+	}
+	m.activity.access.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			m.activity.access.Lock()
+			defer m.activity.access.Unlock()
+			for _, tag := range tags {
+				delete(m.activity.subscribers[tag], watcher)
+				if len(m.activity.subscribers[tag]) == 0 {
+					delete(m.activity.subscribers, tag)
+				}
+			}
+		})
+	}
+}
+
+func (m *Manager) TouchOutboundActivity(tag string) {
+	m.activity.access.RLock()
+	callbacks := make([]func(), 0, len(m.activity.subscribers[tag]))
+	for watcher := range m.activity.subscribers[tag] {
+		callbacks = append(callbacks, watcher.touch)
+	}
+	m.activity.access.RUnlock()
+	for _, callback := range callbacks {
+		callback()
+	}
+}
