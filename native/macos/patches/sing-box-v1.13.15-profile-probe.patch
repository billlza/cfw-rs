@@ -0,0 +1,143 @@
+package group
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func balanceFixture(t *testing.T, strategy string) *URLTest {
+	t.Helper()
+	outbound, err := NewLoadBalance(context.Background(), nil, nil, "balanced", option.LoadBalanceOutboundOptions{Outbounds: []string{"A", "B", "C"}, Strategy: strategy})
+	if err != nil {
+		t.Fatal(err)
+	}
+	proxy := outbound.(*URLTest)
+	history := urltest.NewHistoryStorage()
+	proxy.group = &URLTestGroup{balanced: true, history: history, interruptGroup: interrupt.NewGroup()}
+	for _, tag := range []string{"A", "B", "C"} {
+		proxy.group.outbounds = append(proxy.group.outbounds, selectionTestOutbound{name: tag})
+		history.StoreURLTestHistory(tag, &adapter.URLTestHistory{Time: time.Now(), Delay: 20})
+	}
+	proxy.group.probed.Store(true)
+	return proxy
+}
+
+func TestConsistentHashingIsStableAcrossPortsNetworksOrderAndSubdomains(t *testing.T) {
+	p := balanceFixture(t, "consistent-hashing")
+	ctx := context.Background()
+	choice := p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr("a.example.co.uk:443"))[0].Tag()
+	for _, target := range []string{"b.example.co.uk:80", "EXAMPLE.CO.UK.:8443", "example.co.uk:53"} {
+		for _, network := range []string{"tcp", "udp"} {
+			if got := p.connectionCandidates(ctx, network, M.ParseSocksaddr(target))[0].Tag(); got != choice {
+				t.Fatalf("%s/%s changed selection", target, network)
+			}
+		}
+	}
+	p.group.outbounds[0], p.group.outbounds[2] = p.group.outbounds[2], p.group.outbounds[0]
+	if got := p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr("a.example.co.uk:443"))[0].Tag(); got != choice {
+		t.Fatal("reordering shuffled destinations")
+	}
+	counts := map[string]int{}
+	for i := 0; i < 1024; i++ {
+		counts[p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr(fmt.Sprintf("site-%d.example:443", i)))[0].Tag()]++
+	}
+	for _, tag := range []string{"A", "B", "C"} {
+		if counts[tag] < 200 {
+			t.Fatalf("imbalanced sample: %v", counts)
+		}
+	}
+	if p.Now() != "" {
+		t.Fatal("a load-balancer must not claim one current node for every destination")
+	}
+	if RealTag(p) != "balanced" {
+		t.Fatal("a nested load-balancer lost its health-test target")
+	}
+}
+
+func TestStickySessionsRetainSelectionUntilExpiryOrFailureAndRemainBounded(t *testing.T) {
+	p := balanceFixture(t, "sticky-sessions")
+	destination := M.ParseSocksaddr("video.example.com:443")
+	ctx := adapter.WithContext(context.Background(), &adapter.InboundContext{Source: M.ParseSocksaddr("192.168.1.10:1234")})
+	other := adapter.WithContext(context.Background(), &adapter.InboundContext{Source: M.ParseSocksaddr("192.168.1.11:1234")})
+	if balanceKey(ctx, destination, true) == balanceKey(other, destination, true) {
+		t.Fatal("source address is absent from sticky key")
+	}
+	initial := p.connectionCandidates(ctx, "tcp", destination)[0].Tag()
+	retained := "A"
+	if initial == retained {
+		retained = "B"
+	}
+	p.rememberConnection(ctx, destination, retained)
+	if got := p.connectionCandidates(ctx, "udp", destination)[0].Tag(); got != retained {
+		t.Fatal("an established selection was not retained for the same source and site")
+	}
+	p.balance.access.Lock()
+	expired, _ := p.balance.sessions.Load(balanceKey(ctx, destination, true))
+	p.balance.sessions.StoreWithExpire(balanceKey(ctx, destination, true), expired, time.Now().Add(-time.Second))
+	p.balance.access.Unlock()
+	if got := p.connectionCandidates(ctx, "tcp", destination)[0].Tag(); got != initial {
+		t.Fatal("expired sticky entry remained active")
+	}
+	p.rememberConnection(ctx, destination, retained)
+	p.group.history.DeleteURLTestHistory(retained)
+	if got := p.connectionCandidates(ctx, "tcp", destination)[0].Tag(); got == retained {
+		t.Fatal("sticky entry pinned a failed node")
+	}
+	for i := 0; i < maxStickySessions+100; i++ {
+		p.rememberConnection(ctx, M.ParseSocksaddr(fmt.Sprintf("site-%d.example:443", i)), "A")
+	}
+	p.balance.access.Lock()
+	count := 0
+	p.balance.sessions.Range(func(string, string) { count++ })
+	p.balance.access.Unlock()
+	if count > maxStickySessions {
+		t.Fatal("unbounded sticky cache")
+	}
+}
+
+func TestLoadBalanceConcurrencyRoundRobinAndAllFailed(t *testing.T) {
+	for _, strategy := range []string{"consistent-hashing", "sticky-sessions", "round-robin"} {
+		p := balanceFixture(t, strategy)
+		var workers sync.WaitGroup
+		for i := 0; i < 8; i++ {
+			workers.Add(1)
+			go func(i int) {
+				defer workers.Done()
+				ctx := context.Background()
+				for j := 0; j < 1000; j++ {
+					destination := M.ParseSocksaddr(fmt.Sprintf("test-%d-%d.example:443", i, j))
+					chosen := p.connectionCandidates(ctx, "tcp", destination)
+					if len(chosen) != 3 {
+						t.Error("lost candidates")
+						return
+					}
+					p.rememberConnection(ctx, destination, chosen[0].Tag())
+				}
+			}(i)
+		}
+		workers.Wait()
+		for _, tag := range []string{"A", "B", "C"} {
+			p.group.history.DeleteURLTestHistory(tag)
+		}
+		if len(p.connectionCandidates(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))) != 0 {
+			t.Fatal("failed nodes remained eligible")
+		}
+	}
+	p := balanceFixture(t, "round-robin")
+	counts := map[string]int{}
+	for i := 0; i < 12; i++ {
+		counts[p.connectionCandidates(context.Background(), "tcp", M.ParseSocksaddr("example.com:443"))[0].Tag()]++
+	}
+	if counts["A"] != 4 || counts["B"] != 4 || counts["C"] != 4 {
+		t.Fatalf("round-robin: %v", counts)
+	}
+}
