+package group
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestFallbackPriorityRecoveryAndAllFailed(t *testing.T) {
+	history := urltest.NewHistoryStorage()
+	g := &URLTestGroup{ordered: true, history: history,
+		outbounds: []adapter.Outbound{selectionTestOutbound{name: "primary"}, selectionTestOutbound{name: "backup"}}, interruptGroup: interrupt.NewGroup()}
+	g.probed.Store(true)
+	healthy := func(tag string, delay uint16) {
+		history.StoreURLTestHistory(tag, &adapter.URLTestHistory{Time: time.Now(), Delay: delay})
+	}
+	expect := func(tag string) {
+		t.Helper()
+		g.performUpdateCheck()
+		proxy := &URLTest{ordered: true, group: g}
+		if actual := proxy.Now(); actual != tag {
+			t.Fatalf("selected %q, want %q", actual, tag)
+		}
+		for _, network := range []string{"tcp", "udp"} {
+			selected, available := g.Select(network)
+			if tag == "" {
+				if selected != nil || available {
+					t.Fatal("all-failed group retained a healthy appearance")
+				}
+				continue
+			}
+			if selected == nil || selected.Tag() != tag || !available {
+				t.Fatalf("%s selection does not match %s", network, tag)
+			}
+		}
+	}
+	healthy("primary", 600)
+	healthy("backup", 1)
+	expect("primary")
+	history.DeleteURLTestHistory("primary")
+	expect("backup")
+	healthy("primary", 650)
+	expect("primary")
+	history.DeleteURLTestHistory("primary")
+	history.DeleteURLTestHistory("backup")
+	expect("")
+}
+
+type fallbackDialTestOutbound struct {
+	selectionTestOutbound
+	call func(context.Context) (net.Conn, error)
+}
+
+func (s fallbackDialTestOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return s.call(ctx)
+}
+
+func TestFallbackRetriesBeforePayloadAndKeepsEstablishedConnectionOnRecovery(t *testing.T) {
+	var attempts []string
+	client, peer := net.Pipe()
+	defer peer.Close()
+	primary := &fallbackDialTestOutbound{selectionTestOutbound{name: "primary"}, func(context.Context) (net.Conn, error) {
+		attempts = append(attempts, "primary")
+		return nil, errors.New("offline")
+	}}
+	backup := &fallbackDialTestOutbound{selectionTestOutbound{name: "backup"}, func(context.Context) (net.Conn, error) {
+		attempts = append(attempts, "backup")
+		return client, nil
+	}}
+	history := urltest.NewHistoryStorage()
+	for _, name := range []string{"primary", "backup"} {
+		history.StoreURLTestHistory(name, &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	}
+	g := &URLTestGroup{ordered: true, history: history, outbounds: []adapter.Outbound{primary, backup}, interruptGroup: interrupt.NewGroup()}
+	g.probed.Store(true)
+	proxy := &URLTest{ordered: true, group: g, logger: log.NewNOPFactory().Logger()}
+	ctx := interrupt.ContextWithIsExternalConnection(context.Background())
+	conn, err := proxy.DialContext(ctx, "tcp", M.ParseSocksaddr("192.0.2.1:80"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if len(attempts) != 2 || attempts[0] != "primary" || attempts[1] != "backup" {
+		t.Fatalf("unexpected order: %v", attempts)
+	}
+	g.performUpdateCheck()
+	if proxy.Now() != "backup" {
+		t.Fatal("failed primary remained selected")
+	}
+	history.StoreURLTestHistory("primary", &adapter.URLTestHistory{Time: time.Now(), Delay: 300})
+	g.performUpdateCheck()
+	if proxy.Now() != "primary" {
+		t.Fatal("priority did not recover")
+	}
+	if err := conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { _, err := peer.Write([]byte("alive")); done <- err }()
+	body := make([]byte, 5)
+	if _, err := io.ReadFull(conn, body); err != nil {
+		t.Fatal("existing stream interrupted:", err)
+	}
+	if string(body) != "alive" {
+		t.Fatal("existing stream changed")
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestFallbackCallerCancellationDoesNotTryMoreNodesOrEraseHealth(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	var attempts int
+	first := &fallbackDialTestOutbound{selectionTestOutbound{name: "primary"}, func(context.Context) (net.Conn, error) { attempts++; cancel(); return nil, context.Canceled }}
+	second := &fallbackDialTestOutbound{selectionTestOutbound{name: "backup"}, func(context.Context) (net.Conn, error) {
+		t.Fatal("canceled request reached backup")
+		return nil, context.Canceled
+	}}
+	history := urltest.NewHistoryStorage()
+	history.StoreURLTestHistory("primary", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	g := &URLTestGroup{ordered: true, history: history, outbounds: []adapter.Outbound{first, second}, interruptGroup: interrupt.NewGroup()}
+	proxy := &URLTest{ordered: true, group: g, logger: log.NewNOPFactory().Logger()}
+	_, err := proxy.DialContext(ctx, "tcp", M.ParseSocksaddr("192.0.2.1:80"))
+	if !errors.Is(err, context.Canceled) || attempts != 1 || history.LoadURLTestHistory("primary") == nil {
+		t.Fatal("cancellation altered node health or retry scope")
+	}
+}
+
+type healthProbeTestManager struct {
+	adapter.OutboundManager
+	node adapter.Outbound
+}
+
+func (m healthProbeTestManager) Outbound(tag string) (adapter.Outbound, bool) {
+	return m.node, tag == m.node.Tag()
+}
+
+func TestGroupHealthChecksEndOnCallerCancellationAndClose(t *testing.T) {
+	for _, closeGroup := range []bool{false, true} {
+		t.Run(map[bool]string{false: "caller", true: "close"}[closeGroup], func(t *testing.T) {
+			started := make(chan struct{})
+			node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) { close(started); <-ctx.Done(); return nil, ctx.Err() }}
+			manager := healthProbeTestManager{node: node}
+			g, err := NewURLTestGroup(context.Background(), manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, "http://example.com/probe", time.Minute, 0, time.Minute, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer g.Close()
+			g.history.StoreURLTestHistory("node", &adapter.URLTestHistory{Time: time.Now().Add(-time.Hour), Delay: 10})
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { _, err := g.URLTest(ctx); done <- err }()
+			select {
+			case <-started:
+			case <-time.After(time.Second):
+				t.Fatal("health probe did not start")
+			}
+			if closeGroup {
+				if err := g.Close(); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				cancel()
+			}
+			select {
+			case err := <-done:
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("cancellation became %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("canceled health probe outlived its owner")
+			}
+			if g.history.LoadURLTestHistory("node") == nil {
+				t.Fatal("owner cancellation incorrectly marked the node down")
+			}
+		})
+	}
+}
diff --git a/protocol/group/health_check.go b/protocol/group/health_check.go
new file mode 100644
index 0000000000000000000000000000000000000000..61f5fad1c0990ce041428cf5b0c5cf98512499fb
--- /dev/null
+++ b/protocol/group/health_check.go
@@ -0,0 +1,116 @@
+package group
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing/common/batch"
+	"maps"
+	"sync"
+	"time"
+)
+
+func (g *URLTestGroup) CheckOutbounds(force bool) {
+	_, _ = g.urlTest(g.ctx, force)
+}
+
+type healthCheckRun struct {
+	done   chan struct{}
+	result map[string]uint16
+	err    error
+}
+
+func (g *URLTestGroup) URLTest(ctx context.Context) (map[string]uint16, error) {
+	return g.urlTest(ctx, true)
+}
+
+func (g *URLTestGroup) urlTest(ctx context.Context, force bool) (result map[string]uint16, err error) {
+	if err := g.ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	g.checkAccess.Lock()
+	if current := g.checking; current != nil {
+		g.checkAccess.Unlock()
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-g.ctx.Done():
+			return nil, g.ctx.Err()
+		case <-current.done:
+			return maps.Clone(current.result), current.err
+		}
+	}
+	current := &healthCheckRun{done: make(chan struct{})}
+	g.checking = current
+	g.checkAccess.Unlock()
+	defer func() {
+		g.checkAccess.Lock()
+		current.result, current.err = maps.Clone(result), err
+		g.checking = nil
+		close(current.done)
+		g.checkAccess.Unlock()
+	}()
+	result = make(map[string]uint16)
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(g.ctx, cancel)
+	defer stop()
+	defer cancel()
+	b, _ := batch.New(ctx, batch.WithConcurrencyNum[any](10))
+	checked := make(map[string]bool)
+	var resultAccess sync.Mutex
+	for _, detour := range g.outbounds {
+		tag := detour.Tag()
+		realTag := RealTag(detour)
+		if checked[realTag] {
+			continue
+		}
+		history := g.history.LoadURLTestHistory(realTag)
+		if !force && history != nil && time.Since(history.Time) < g.interval {
+			resultAccess.Lock()
+			result[tag] = history.Delay
+			resultAccess.Unlock()
+			continue
+		}
+		checked[realTag] = true
+		p, loaded := g.outbound.Outbound(realTag)
+		if !loaded {
+			continue
+		}
+		b.Go(realTag, func() (any, error) {
+			testCtx, cancel := context.WithTimeout(ctx, g.probeTimeout)
+			defer cancel()
+			t, err := urltest.URLTestWithStatus(testCtx, g.link, g.expectedStatus, p)
+			if err != nil {
+				if ctx.Err() != nil {
+					return nil, ctx.Err()
+				}
+				g.logger.Debug("outbound ", tag, " unavailable: ", err)
+				g.history.DeleteURLTestHistory(realTag)
+				if g.sharedHistory != nil {
+					g.sharedHistory.DeleteURLTestHistory(realTag)
+				}
+			} else {
+				g.logger.Debug("outbound ", tag, " available: ", t, "ms")
+				observed := &adapter.URLTestHistory{Time: time.Now(), Delay: t}
+				g.history.StoreURLTestHistory(realTag, observed)
+				if g.sharedHistory != nil {
+					g.sharedHistory.StoreURLTestHistory(realTag, observed)
+				}
+				resultAccess.Lock()
+				result[tag] = t
+				resultAccess.Unlock()
+			}
+			return nil, nil
+		})
+	}
+	b.Wait()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	g.probed.Store(true)
+	g.performUpdateCheck()
+	return result, nil
+}
