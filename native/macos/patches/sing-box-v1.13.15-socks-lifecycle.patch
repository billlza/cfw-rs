+func TestSOCKSCancelledAttemptDoesNotCloseConcurrentSession(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			f := newSocksFixture(t, "request")
+			f.stallFirst = true
+			f.start()
+			outbound := fixtureOutbound(t, f, time.Second, context.Background(), "", "")
+			first, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				conn, err := outbound.DialContext(first, network, M.ParseSocksaddr("203.0.113.1:443"))
+				if conn != nil {
+					conn.Close()
+				}
+				done <- err
+			}()
+			select {
+			case <-f.reached:
+			case <-time.After(time.Second):
+				t.Fatal("first handshake did not reach request")
+			}
+			conn, err := outbound.DialContext(context.Background(), network, M.ParseSocksaddr("203.0.113.1:443"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			cancel()
+			select {
+			case err = <-done:
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("expected cancellation, got %v", err)
+				}
+			case <-time.After(500 * time.Millisecond):
+				t.Fatal("first handshake did not stop")
+			}
+			if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			payload := []byte("independent-session")
+			if _, err = conn.Write(payload); err != nil {
+				t.Fatal(err)
+			}
+			got := make([]byte, 4096)
+			var count int
+			if network == "tcp" {
+				count, err = io.ReadFull(conn, got[:len(payload)])
+			} else {
+				count, err = conn.Read(got)
+			}
+			if err != nil {
+				t.Fatalf("cancellation closed an unrelated session: %v", err)
+			}
+			if !bytes.Equal(got[:count], payload) {
+				t.Fatal("concurrent session payload changed")
+			}
+		})
+	}
+}
