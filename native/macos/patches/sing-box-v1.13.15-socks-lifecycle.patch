+func TestSOCKSUDPUnspecifiedRelayUsesLogicalServer(t *testing.T) {
+	for _, bind := range []string{"0.0.0.0", "::", "203.0.113.25", "relay.example"} {
+		t.Run(bind, func(t *testing.T) {
+			f := newSocksFixture(t, "")
+			f.bind = bind
+			f.start()
+			expected := bind
+			if bind == "0.0.0.0" || bind == "::" {
+				expected = "198.51.100.10"
+			}
+			recording := &relayFixtureOutbound{f: f, expected: net.JoinHostPort(expected, fmt.Sprint(f.udp.LocalAddr().(*net.UDPAddr).Port)), calls: make(chan M.Socksaddr, 2)}
+			ctx := service.ContextWith[adapter.OutboundManager](context.Background(), &relayFixtureManager{recording})
+			outbound := fixtureOutbound(t, f, time.Second, ctx, "fixture", "198.51.100.10")
+			conn, err := outbound.DialContext(ctx, "udp", M.ParseSocksaddr("203.0.113.1:53"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			payload := []byte("relay-payload")
+			if _, err = conn.Write(payload); err != nil {
+				t.Fatal(err)
+			}
+			got := make([]byte, 4096)
+			count, readErr := conn.Read(got)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if string(got[:count]) != string(payload) {
+				t.Fatal("UDP payload changed")
+			}
+			if called := <-recording.calls; called.String() != recording.expected {
+				t.Fatal("detour or relay port was not preserved")
+			}
+		})
+	}
+}
