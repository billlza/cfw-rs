@@ -0,0 +1,170 @@
+package socks
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/protocol/socks"
+)
+
+// boundedClient keeps the upstream protocol implementation while giving each
+// setup attempt its own cancellation scope. A dial context owns the handshake,
+// not the lifetime of a successfully established connection.
+type boundedClient struct {
+	dialer   N.Dialer
+	server   M.Socksaddr
+	version  socks.Version
+	username string
+	password string
+	timeout  time.Duration
+	direct   bool
+}
+
+var _ N.Dialer = (*boundedClient)(nil)
+
+func (c *boundedClient) begin(ctx context.Context) (context.Context, *socks.Client, func(error) error) {
+	timeout := c.timeout
+	if timeout == 0 {
+		timeout = C.TCPConnectTimeout
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	scope := &handshakeDialer{Dialer: c.dialer, server: c.server, direct: c.direct}
+	done := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() {
+		scope.closeOwned()
+		close(done)
+	})
+	finish := func(err error) error {
+		// If cancellation won, wait for its close operation before releasing any
+		// connection to the caller. No callback may outlive this setup attempt.
+		if !stop() {
+			<-done
+		}
+		if cause := ctx.Err(); cause != nil {
+			err = errors.Join(cause, err)
+		}
+		cancel()
+		if err != nil {
+			return errors.Join(err, scope.closeOwned())
+		}
+		scope.release()
+		return nil
+	}
+	return ctx, socks.NewClient(scope, c.server, c.version, c.username, c.password), finish
+}
+
+func (c *boundedClient) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	ctx, client, finish := c.begin(ctx)
+	conn, err := client.DialContext(ctx, network, destination)
+	if err = finish(err); err != nil {
+		return nil, err
+	}
+	return conn, nil
+}
+
+func (c *boundedClient) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, client, finish := c.begin(ctx)
+	conn, err := client.ListenPacket(ctx, destination)
+	if err = finish(err); err != nil {
+		return nil, err
+	}
+	return conn, nil
+}
+
+type handshakeDialer struct {
+	N.Dialer
+	server M.Socksaddr
+	direct bool
+	peer   M.Socksaddr
+
+	access   sync.Mutex
+	owned    []io.Closer
+	closed   bool
+	closeErr error
+}
+
+func (d *handshakeDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if N.NetworkName(network) == N.NetworkUDP {
+		if destination.Port == 0 {
+			return nil, errors.New("socks5: UDP relay returned port zero")
+		}
+		if destination.Addr.IsUnspecified() {
+			// Some servers return a wildcard BND.ADDR. Keep the relay's port,
+			// and reach it through the same configured dialer/detour. A detour's
+			// RemoteAddr can be an earlier hop, so only direct sockets use it.
+			server := d.server
+			if d.direct && d.peer.IsIP() && !d.peer.Addr.IsUnspecified() {
+				server = d.peer
+			}
+			server.Port = destination.Port
+			destination = server
+		}
+	}
+	conn, err := d.Dialer.DialContext(ctx, network, destination)
+	if err != nil {
+		return nil, err
+	}
+	if err = d.own(ctx, conn); err != nil {
+		return nil, err
+	}
+	if N.NetworkName(network) == N.NetworkTCP {
+		d.peer = M.SocksaddrFromNet(conn.RemoteAddr())
+	}
+	return conn, nil
+}
+
+func (d *handshakeDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	conn, err := d.Dialer.ListenPacket(ctx, destination)
+	if err != nil {
+		return nil, err
+	}
+	if err = d.own(ctx, conn); err != nil {
+		return nil, err
+	}
+	return conn, nil
+}
+
+func (d *handshakeDialer) own(ctx context.Context, conn io.Closer) error {
+	d.access.Lock()
+	defer d.access.Unlock()
+	if err := ctx.Err(); err != nil {
+		return errors.Join(err, closeHandshakeConn(conn))
+	}
+	d.owned = append(d.owned, conn)
+	return nil
+}
+
+func closeHandshakeConn(conn io.Closer) error {
+	err := conn.Close()
+	// The upstream SOCKS client also closes its control socket on failure.
+	if errors.Is(err, net.ErrClosed) {
+		return nil
+	}
+	return err
+}
+
+func (d *handshakeDialer) closeOwned() error {
+	d.access.Lock()
+	defer d.access.Unlock()
+	if !d.closed {
+		d.closed = true
+		for _, conn := range d.owned {
+			d.closeErr = errors.Join(d.closeErr, closeHandshakeConn(conn))
+		}
+		d.owned = nil
+	}
+	return d.closeErr
+}
+
+func (d *handshakeDialer) release() {
+	d.access.Lock()
+	d.owned = nil
+	d.access.Unlock()
+}
