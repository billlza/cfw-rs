+func TestSOCKSListenPacketPreservesDatagramsAfterSetup(t *testing.T) {
+	f := newSocksFixture(t, "")
+	f.bind = "::"
+	f.start()
+	outbound := fixtureOutbound(t, f, 100*time.Millisecond, context.Background(), "", "")
+	ctx, cancel := context.WithCancel(context.Background())
+	destination := M.ParseSocksaddr("203.0.113.1:443")
+	conn, err := outbound.ListenPacket(ctx, destination)
+	cancel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	time.Sleep(120 * time.Millisecond)
+	if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	for _, size := range []int{1, 512, 1232, 2048} {
+		payload := bytes.Repeat([]byte{byte(size % 251)}, size)
+		if _, err = conn.WriteTo(payload, destination.UDPAddr()); err != nil {
+			t.Fatal(err)
+		}
+		received := make([]byte, 4096)
+		count, peer, err := conn.ReadFrom(received)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(payload, received[:count]) || peer.String() != destination.String() {
+			t.Fatalf("datagram size %d or its destination changed", size)
+		}
+	}
+}
