+
+func TestSystemHostsPrecedesExplicitResolverAndRemotePolicyWithoutHidingIOFailure(t *testing.T) {
+	port, seen := startPolicyTCP(t, false, "203.0.113.7")
+	hostsPath := filepath.Join(t.TempDir(), "hosts")
+	if err := os.WriteFile(hostsPath, []byte("127.0.0.1 local.example\n::1 local.example\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	config := func(path string) map[string]any {
+		return map[string]any{
+			"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+			"dns": map[string]any{"system_hosts": "system", "servers": []any{
+				map[string]any{"type": "hosts", "tag": "system", "path": []string{path}, "strict": true, "fallback_on_missing": true},
+				map[string]any{"type": "tcp", "tag": "remote", "server": "127.0.0.1", "server_port": port},
+			}, "final": "remote", "strategy": "ipv4_only"},
+		}
+	}
+	router, transports := startPolicyBox(t, config(hostsPath))
+	remote, ok := transports.Transport("remote")
+	if !ok {
+		t.Fatal("remote resolver missing")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	addresses, err := router.Lookup(ctx, "local.example", adapter.DNSQueryOptions{Transport: remote, Strategy: C.DomainStrategyIPv4Only})
+	if err != nil || len(addresses) != 1 || addresses[0] != netip.MustParseAddr("127.0.0.1") {
+		t.Fatalf("hosts lookup: %v %v", addresses, err)
+	}
+	if _, found := seen.Load("local.example."); found {
+		t.Fatal("hosts name leaked to an explicit upstream")
+	}
+	localReply, err := exchangePolicyAsync(t, router, ctx, policyQuestion("local.example"), adapter.DNSQueryOptions{Transport: remote})
+	if err != nil || localReply == nil || len(localReply.Answer) != 1 || localReply.Answer[0].(*mdns.A).A.String() != "127.0.0.1" {
+		t.Fatalf("async system hosts lookup: %v %v", localReply, err)
+	}
+	if _, found := seen.Load("local.example."); found {
+		t.Fatal("async hosts name leaked to explicit upstream")
+	}
+	query := new(mdns.Msg)
+	query.SetQuestion("local.example.", mdns.TypeAAAA)
+	response, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{})
+	if err != nil || len(response.Answer) != 0 {
+		t.Fatal("system hosts bypassed disabled IPv6")
+	}
+	query.SetQuestion("remote.example.", mdns.TypeA)
+	response, err = router.Exchange(ctx, query, adapter.DNSQueryOptions{})
+	if err != nil || len(response.Answer) != 1 {
+		t.Fatalf("absent local host did not reach DNS: %v", err)
+	}
+	if _, found := seen.Load("remote.example."); !found {
+		t.Fatal("ordinary DNS was skipped")
+	}
+
+	broken, _ := startPolicyBox(t, config(filepath.Join(t.TempDir(), "missing-hosts")))
+	query.SetQuestion("must-not-leak.example.", mdns.TypeA)
+	if _, err := broken.Exchange(ctx, query, adapter.DNSQueryOptions{}); err == nil {
+		t.Fatal("unreadable hosts became successful DNS fallback")
+	}
+	if _, err := exchangePolicyAsync(t, broken, ctx, query, adapter.DNSQueryOptions{}); err == nil {
+		t.Fatal("unreadable hosts became successful asynchronous DNS fallback")
+	}
+	if _, found := seen.Load("must-not-leak.example."); found {
+		t.Fatal("hosts I/O failure leaked to DNS")
+	}
+}
+
+func TestLocalHostsMissDoesNotConsumeTheEightRemoteAttemptBudget(t *testing.T) {
+	port, _ := startPolicyTCP(t, false, "203.0.113.9")
+	closed, _ := startPolicyTCP(t, true, "")
+	hostsPath := filepath.Join(t.TempDir(), "hosts")
+	if err := os.WriteFile(hostsPath, []byte("127.0.0.1 localhost\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	servers := []any{map[string]any{"type": "hosts", "tag": "system", "path": []string{hostsPath}, "strict": true, "fallback_on_missing": true}}
+	var rules []any
+	for i := 0; i < 8; i++ {
+		selectedPort := closed
+		if i == 7 {
+			selectedPort = port
+		}
+		tag := fmt.Sprintf("resolver-%d", i)
+		servers = append(servers, map[string]any{"type": "tcp", "tag": tag, "server": "127.0.0.1", "server_port": selectedPort})
+		if i < 7 {
+			rules = append(rules, evaluatedPolicyRules(map[string]any{"query_type": []string{"A"}}, tag)...)
+		}
+	}
+	router, _ := startPolicyBox(t, map[string]any{"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}}, "dns": map[string]any{"system_hosts": "system", "servers": servers, "rules": rules, "final": "resolver-7", "strategy": "ipv4_only"}})
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	query := new(mdns.Msg)
+	query.SetQuestion("budget.example.", mdns.TypeA)
+	response, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{})
+	if err != nil || len(response.Answer) != 1 {
+		t.Fatalf("eighth remote attempt was lost after local miss: %v", err)
+	}
+}
