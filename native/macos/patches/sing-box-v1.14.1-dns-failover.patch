+package dns
+
+import (
+	"context"
+	"errors"
+	"github.com/miekg/dns"
+	"net/netip"
+	"testing"
+)
+
+func TestNegativeDNSResultsRemainTerminalWithResponseFilters(t *testing.T) {
+	for _, response := range []*dns.Msg{
+		{MsgHdr: dns.MsgHdr{Rcode: dns.RcodeNameError}},
+		{MsgHdr: dns.MsgHdr{Rcode: dns.RcodeSuccess}, Ns: []dns.RR{&dns.SOA{Hdr: dns.RR_Header{Name: "example.", Rrtype: dns.TypeSOA, Ttl: 30}, Minttl: 30}}},
+	} {
+		if responseIsRejected(response, func([]netip.Addr) bool { return false }) {
+			t.Fatal("valid negative response retried because it had no allowed IP")
+		}
+	}
+	nx := RcodeError(dns.RcodeNameError)
+	if shouldContinueDNSRule(context.Background(), true, nx, 1) {
+		t.Fatal("negative lookup continued to another DNS rule")
+	}
+	if !onlyNegativeDNSResult(errors.Join(nx, nx)) {
+		t.Fatal("joined negative lookups were retried")
+	}
+	if onlyNegativeDNSResult(errors.Join(nx, errors.New("I/O failure"))) {
+		t.Fatal("mixed lookup errors hid the I/O failure")
+	}
+}
