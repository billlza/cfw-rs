+package option
+
+import (
+	"context"
+	"github.com/sagernet/sing/common/json"
+	"testing"
+)
+
+func TestDNSResponseFilterRejectsActionsBindingsAndQueryFields(t *testing.T) {
+	for _, predicate := range []string{
+		`{"ip_accept_any":true,"action":"route","server":"other"}`,
+		`{"type":"logical","mode":"and","rules":[{"ip_accept_any":true,"action":"respond"}]}`,
+		`{"domain":"example.test"}`,
+		`{"match_response":"prior","ip_accept_any":true}`,
+		`{"rule_set":"country","rule_set_ip_cidr_match_source":true}`,
+		`{}`,
+	} {
+		var rule DNSRule
+		source := `{"action":"evaluate","server":"primary","response_ip_accept_all":true,"response_filter":` + predicate + `}`
+		if err := json.UnmarshalContext(context.Background(), []byte(source), &rule); err == nil {
+			t.Fatalf("unsafe response_filter admitted: %s", predicate)
+		}
+	}
+	var rule DNSRule
+	source := `{"action":"evaluate","server":"primary","response_ip_accept_all":true,"response_filter":{"type":"logical","mode":"and","rules":[{"ip_accept_any":true},{"ip_cidr":"192.0.2.0/24","invert":true},{"rule_set":"country"}]}}`
+	if err := json.UnmarshalContext(context.Background(), []byte(source), &rule); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDNSResponseFilterBoundsAreEnforced(t *testing.T) {
+	for _, source := range []string{`{"action":"evaluate","server":"primary","response_filter":{}}`, `{"action":"evaluate","server":"primary","response_filter":null}`} {
+		var rule DNSRule
+		if err := json.UnmarshalContext(context.Background(), []byte(source), &rule); err == nil {
+			t.Fatal("explicit empty response_filter silently became absent")
+		}
+	}
+	predicate := `{"ip_accept_any":true}`
+	for i := 0; i < 10; i++ {
+		predicate = `{"type":"logical","mode":"and","rules":[` + predicate + `]}`
+	}
+	var filter DNSResponseFilter
+	if err := json.UnmarshalContext(context.Background(), []byte(predicate), &filter); err == nil {
+		t.Fatal("excessively deep response filter accepted")
+	}
+}
