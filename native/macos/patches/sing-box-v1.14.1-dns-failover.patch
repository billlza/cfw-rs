+func exchangePolicyAsync(t *testing.T, router adapter.DNSRouter, ctx context.Context, query *mdns.Msg, options adapter.DNSQueryOptions) (*mdns.Msg, error) {
+	t.Helper()
+	type result struct {
+		response *mdns.Msg
+		err      error
+	}
+	done := make(chan result, 1)
+	router.ExchangeAsync(ctx, query, options, func(response *mdns.Msg, err error) { done <- result{response, err} })
+	select {
+	case completed := <-done:
+		return completed.response, completed.err
+	case <-ctx.Done():
+		t.Fatal("asynchronous DNS callback did not complete within the query deadline")
+		return nil, ctx.Err()
+	}
+}
