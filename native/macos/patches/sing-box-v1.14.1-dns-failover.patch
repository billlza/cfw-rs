diff --git a/option/dns_response_filter.go b/option/dns_response_filter.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f2cb29ee34a9d699dbaf5cbb8c73bcb061d354c
--- /dev/null
+++ b/option/dns_response_filter.go
@@ -0,0 +1,77 @@
+package option
+
+import (
+	"context"
+	"reflect"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/schema"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+)
+
+// DNSResponseFilter is a bounded, action-free IP predicate evaluated against
+// the original DNS reply before address-family filtering or cache projection.
+// Query conditions and response bindings belong to the surrounding DNS rules.
+type DNSResponseFilter struct {
+	DNSRule
+}
+
+func (f *DNSResponseFilter) UnmarshalJSONContext(ctx context.Context, content []byte) error {
+	if err := json.UnmarshalContext(nestedRuleChildContext(ctx), content, &f.DNSRule); err != nil {
+		return err
+	}
+	return f.Validate()
+}
+
+func (f DNSResponseFilter) MarshalJSON() ([]byte, error) {
+	return f.DNSRule.MarshalJSON()
+}
+
+func (f DNSResponseFilter) DescribeSchema(builder schema.Builder) (*schema.Node, error) {
+	return builder.Define("DNSResponseFilter", func() (*schema.Node, error) {
+		return nestedRuleUnion(builder, reflect.TypeFor[RawDefaultDNSRule](), "DNSResponseFilter")
+	})
+}
+
+func (f DNSResponseFilter) Validate() error {
+	nodes := 0
+	var validate func(DNSRule, int) error
+	validate = func(rule DNSRule, depth int) error {
+		nodes++
+		if depth > 8 || nodes > 64 {
+			return E.New("DNS response_filter exceeds 8 levels or 64 predicates")
+		}
+		switch rule.Type {
+		case "", C.RuleTypeDefault:
+			o := rule.DefaultOptions
+			allowed := DefaultDNSRule{RawDefaultDNSRule: RawDefaultDNSRule{
+				IPCIDR: o.IPCIDR, IPIsPrivate: o.IPIsPrivate,
+				IPAcceptAny: o.IPAcceptAny, RuleSet: o.RuleSet, Invert: o.Invert,
+			}}
+			if !reflect.DeepEqual(o, allowed) {
+				return E.New("DNS response_filter accepts only IP predicates and pure-IP rule_set references; actions and query fields are forbidden")
+			}
+			if len(o.IPCIDR) == 0 && !o.IPIsPrivate && !o.IPAcceptAny && len(o.RuleSet) == 0 {
+				return E.New("empty DNS response_filter predicate")
+			}
+		case C.RuleTypeLogical:
+			o := rule.LogicalOptions
+			if !reflect.DeepEqual(o.DNSRuleAction, DNSRuleAction{}) {
+				return E.New("DNS response_filter cannot contain actions")
+			}
+			if len(o.Rules) == 0 || (o.Mode != C.LogicalTypeAnd && o.Mode != C.LogicalTypeOr) {
+				return E.New("invalid logical DNS response_filter")
+			}
+			for _, child := range o.Rules {
+				if err := validate(child, depth+1); err != nil {
+					return err
+				}
+			}
+		default:
+			return E.New("invalid DNS response_filter type: ", rule.Type)
+		}
+		return nil
+	}
+	return validate(f.DNSRule, 0)
+}
