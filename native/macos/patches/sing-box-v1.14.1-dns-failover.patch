+package option
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestDomainResolveOptionsFallbackJSON(t *testing.T) {
+	t.Parallel()
+
+	var options DomainResolveOptions
+	err := json.Unmarshal([]byte(`{"server":"primary","fallback_server":"secondary"}`), &options)
+	if err != nil {
+		t.Fatalf("decode fallback resolver: %v", err)
+	}
+	if options.Server != "primary" || options.FallbackServer != "secondary" {
+		t.Fatalf("unexpected resolver options: %#v", options)
+	}
+	encoded, err := json.Marshal(options)
+	if err != nil {
+		t.Fatalf("encode fallback resolver: %v", err)
+	}
+	if string(encoded) != `{"server":"primary","fallback_server":"secondary"}` {
+		t.Fatalf("unexpected fallback JSON: %s", encoded)
+	}
+
+	err = json.Unmarshal([]byte(`{"server":"same","fallback_server":"same"}`), &options)
+	if err == nil {
+		t.Fatal("duplicate primary and fallback resolver must be rejected")
+	}
+
+	err = json.Unmarshal([]byte(`"primary"`), &options)
+	if err != nil || options.Server != "primary" || options.FallbackServer != "" {
+		t.Fatalf("legacy single resolver changed: options=%#v err=%v", options, err)
+	}
+}
+
+func TestDomainResolverMultipleFallbacksAreBoundedAndUnambiguous(t *testing.T) {
+	for _, input := range []string{
+		`{"server":"one","fallback_servers":["two","three"]}`,
+		`{"server":"one","fallback_server":"two"}`,
+	} {
+		var options DomainResolveOptions
+		if err := json.Unmarshal([]byte(input), &options); err != nil {
+			t.Fatal(err)
+		}
+		result, err := json.Marshal(options)
+		if err != nil || string(result) != input {
+			t.Fatalf("lost ordered resolvers: %s %v", result, err)
+		}
+	}
+	for _, input := range []string{
+		`{"server":"one","fallback_servers":["one"]}`,
+		`{"server":"one","fallback_servers":[""]}`,
+		`{"server":"one","fallback_servers":["two","two"]}`,
+		`{"server":"one","fallback_server":"two","fallback_servers":["three"]}`,
+		`{"server":"one","fallback_servers":["2","3","4","5","6","7","8","9"]}`,
+	} {
+		var options DomainResolveOptions
+		if err := json.Unmarshal([]byte(input), &options); err == nil {
+			t.Fatalf("accepted invalid fallback graph: %s", input)
+		}
+	}
+}
+
+func TestDomainResolverPolicyIsExclusiveAndRoundTrips(t *testing.T) {
+	var options DomainResolveOptions
+	input := `{"policy":"direct"}`
+	if err := json.Unmarshal([]byte(input), &options); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(options)
+	if err != nil || string(encoded) != input {
+		t.Fatalf("policy round trip: %s %v", encoded, err)
+	}
+	for _, input := range []string{`{"policy":"direct","server":"main"}`, `{"policy":"direct","fallback_server":"main"}`, `{"policy":"direct","fallback_servers":["main"]}`} {
+		if err := json.Unmarshal([]byte(input), &options); err == nil {
+			t.Fatalf("ambiguous policy accepted: %s", input)
+		}
+	}
+}
