+func startPolicyBox(t *testing.T, config map[string]any) (adapter.DNSRouter, adapter.DNSTransportManager) {
+	ctx := startPolicyBoxContext(t, config)
+	return service.FromContext[adapter.DNSRouter](ctx), service.FromContext[adapter.DNSTransportManager](ctx)
+}
+func startPolicyBoxContext(t *testing.T, config map[string]any) context.Context {
+	t.Helper()
+	ctx := service.ContextWithDefaultRegistry(include.Context(context.Background()))
+	data, err := json.Marshal(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var opts option.Options
+	if err = SJSON.UnmarshalContext(ctx, data, &opts); err != nil {
+		t.Fatal(err)
+	}
+	instance, err := box.New(box.Options{Options: opts, Context: ctx})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = instance.Start(); err != nil {
+		instance.Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := instance.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return ctx
+}
+func evaluatedPolicyRules(condition map[string]any, server string) []any {
+	evaluate := make(map[string]any, len(condition)+2)
+	for key, value := range condition {
+		evaluate[key] = value
+	}
+	evaluate["action"], evaluate["server"] = "evaluate", server
+	return []any{evaluate, map[string]any{
+		"type": "logical", "mode": "and", "action": "respond",
+		"rules": []any{condition, map[string]any{"type": "logical", "mode": "or", "rules": []any{
+			map[string]any{"match_response": true, "response_rcode": "NOERROR"},
+			map[string]any{"match_response": true, "response_rcode": "NXDOMAIN"},
+		}}},
+	}}
+}
