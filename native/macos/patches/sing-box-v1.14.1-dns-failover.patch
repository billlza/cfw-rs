@@ -0,0 +1,45 @@
+package dns
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+func validateDNSResponseFilterMetadata(router adapter.Router, rule option.DNSRule, overrides map[string]adapter.RuleSetMetadata) error {
+	var filter *option.DNSResponseFilter
+	if rule.Type == C.RuleTypeLogical {
+		filter = rule.LogicalOptions.EvaluateOptions.ResponseFilter
+	} else {
+		filter = rule.DefaultOptions.EvaluateOptions.ResponseFilter
+	}
+	if filter == nil {
+		return nil
+	}
+	if err := filter.Validate(); err != nil {
+		return err
+	}
+	var inspect func(option.DNSRule) error
+	inspect = func(rule option.DNSRule) error {
+		if rule.Type == C.RuleTypeLogical {
+			for _, child := range rule.LogicalOptions.Rules {
+				if err := inspect(child); err != nil {
+					return err
+				}
+			}
+			return nil
+		}
+		for _, tag := range rule.DefaultOptions.RuleSet {
+			metadata, err := lookupDNSRuleSetMetadata(router, tag, overrides)
+			if err != nil {
+				return err
+			}
+			if metadata.ContainsNonIPCIDRRule {
+				return E.New("response_filter requires a pure-IP rule_set: ", tag)
+			}
+		}
+		return nil
+	}
+	return inspect(filter.DNSRule)
+}
