diff --git a/dns/hosts_miss_test.go b/dns/hosts_miss_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bf4f4730a8355df761b3b7b6459d5d84b7d98d06
--- /dev/null
+++ b/dns/hosts_miss_test.go
@@ -0,0 +1,19 @@
+package dns
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"testing"
+)
+
+func TestHostsMissDoesNotHideAJointIOFailure(t *testing.T) {
+	if !onlyHostsMiss(fmt.Errorf("lookup: %w", errors.Join(ErrHostsNotFound, ErrHostsNotFound))) {
+		t.Fatal("wrapped hosts absence rejected")
+	}
+	for _, err := range []error{nil, os.ErrPermission, errors.Join(ErrHostsNotFound, os.ErrPermission)} {
+		if onlyHostsMiss(err) {
+			t.Fatal("non-miss error admitted fallback")
+		}
+	}
+}
