+func newFallbackRouter(t *testing.T, client *fallbackDNSClient) *Router {
+	primary := &fallbackDNSTransport{tag: "primary"}
+	secondary := &fallbackDNSTransport{tag: "secondary"}
+	return &Router{
+		logger: logger.NOP(),
+		transport: &fallbackTransportManager{
+			primary:   primary,
+			secondary: secondary,
+		},
+		client:                client,
+		rules:                 nativeFallbackRules(t),
+		defaultDomainStrategy: C.DomainStrategyIPv4Only,
+	}
+}
