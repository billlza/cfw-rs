+package dns
+
+import (
+	"context"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/logger"
+)
+
+type responseFilterTransport struct {
+	TransportAdapter
+	response *mdns.Msg
+	calls    atomic.Int32
+}
+
+func (*responseFilterTransport) Start(adapter.StartStage) error { return nil }
+func (*responseFilterTransport) Close() error                   { return nil }
+func (*responseFilterTransport) Reset()                         {}
+func (t *responseFilterTransport) Exchange(ctx context.Context, query *mdns.Msg) (*mdns.Msg, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	t.calls.Add(1)
+	response := t.response.Copy()
+	response.Id, response.Question = query.Id, query.Question
+	return response, nil
+}
+func (t *responseFilterTransport) ExchangeAsync(ctx context.Context, query *mdns.Msg, callback func(*mdns.Msg, error)) {
+	callback(t.Exchange(ctx, query))
+}
+
+func responseFilterRR(t *testing.T, text string) mdns.RR {
+	t.Helper()
+	record, err := mdns.NewRR("example.test. 60 IN " + text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return record
+}
+
+func newResponseFilterRouter(t *testing.T, response *mdns.Msg, strategy C.DomainStrategy, qtype uint16) (*Router, *responseFilterTransport, *responseFilterTransport) {
+	t.Helper()
+	primary := &responseFilterTransport{TransportAdapter: NewTransportAdapter("tcp", "primary", nil), response: response}
+	fallbackResponse := FixedResponse(0, mdns.Question{Name: "example.test.", Qtype: qtype, Qclass: mdns.ClassINET}, []netip.Addr{netip.MustParseAddr("203.0.113.9"), netip.MustParseAddr("2001:db8:1::9")}, 60)
+	if qtype == mdns.TypeHTTPS {
+		fallbackResponse.Answer = []mdns.RR{responseFilterRR(t, "HTTPS 1 . ipv4hint=203.0.113.9")}
+	}
+	fallback := &responseFilterTransport{TransportAdapter: NewTransportAdapter("tcp", "secondary", nil), response: fallbackResponse}
+	filter := &option.DNSResponseFilter{DNSRule: option.DNSRule{Type: C.RuleTypeLogical, LogicalOptions: option.LogicalDNSRule{RawLogicalDNSRule: option.RawLogicalDNSRule{
+		Mode: C.LogicalTypeAnd,
+		Rules: []option.DNSRule{
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPAcceptAny: true}}},
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPCIDR: []string{"203.0.113.0/24", "2001:db8:1::/48"}}}},
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPCIDR: []string{"203.0.113.8/32"}, Invert: true}}},
+		},
+	}}}}
+	raw := []option.DNSRule{
+		{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{DNSRuleAction: option.DNSRuleAction{Action: C.RuleActionTypeEvaluate, EvaluateOptions: option.DNSEvaluateActionOptions{Server: "primary", ResponseFilter: filter, ResponseIPAcceptAll: true}}}},
+		{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{MatchResponse: &option.DNSRuleMatchResponse{Enabled: true}}, DNSRuleAction: option.DNSRuleAction{Action: C.RuleActionTypeRespond}}},
+	}
+	router := &Router{ctx: context.Background(), logger: logger.NOP(), transport: &fallbackTransportManager{primary: primary, secondary: fallback}, defaultDomainStrategy: strategy, client: NewClient(ClientOptions{Context: context.Background(), Logger: logger.NOP()})}
+	for _, source := range raw {
+		rule, err := R.NewDNSRule(context.Background(), logger.NOP(), source, true, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := rule.Start(); err != nil {
+			t.Fatal(err)
+		}
+		router.rules = append(router.rules, rule)
+	}
+	t.Cleanup(func() {
+		if err := router.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return router, primary, fallback
+}
+
+func TestNativeResponseFilterChecksAllOriginalAddressesAndNegativeAnswers(t *testing.T) {
+	soa := "SOA ns.example.test. hostmaster.example.test. 1 60 60 60 60"
+	cases := []struct {
+		name     string
+		qtype    uint16
+		answers  []string
+		rcode    int
+		soa      bool
+		fallback bool
+		ipv4Only bool
+	}{
+		{name: "mixed-A", qtype: mdns.TypeA, answers: []string{"A 203.0.113.1", "A 198.51.100.1"}, fallback: true},
+		{name: "mixed-A-reversed", qtype: mdns.TypeA, answers: []string{"A 198.51.100.1", "A 203.0.113.1"}, fallback: true},
+		{name: "mixed-AAAA", qtype: mdns.TypeAAAA, answers: []string{"AAAA 2001:db8:1::1", "AAAA 2001:db8:2::1"}, fallback: true},
+		{name: "banned-inside-allow-set", qtype: mdns.TypeA, answers: []string{"A 203.0.113.1", "A 203.0.113.8"}, fallback: true},
+		{name: "HTTPS-hidden-invalid-IPv6-hint", qtype: mdns.TypeHTTPS, answers: []string{"HTTPS 1 . ipv4hint=203.0.113.1 ipv6hint=2001:db8:2::1"}, fallback: true, ipv4Only: true},
+		{name: "HTTPS-all-allowed", qtype: mdns.TypeHTTPS, answers: []string{"HTTPS 1 . ipv4hint=203.0.113.1 ipv6hint=2001:db8:1::1"}, ipv4Only: true},
+		{name: "NXDOMAIN", qtype: mdns.TypeA, rcode: mdns.RcodeNameError, soa: true},
+		{name: "NODATA", qtype: mdns.TypeA, soa: true},
+		{name: "empty-without-SOA", qtype: mdns.TypeA, fallback: true},
+		{name: "CNAME-without-address", qtype: mdns.TypeA, answers: []string{"CNAME target.example.test."}, soa: true, fallback: true},
+	}
+	for _, test := range cases {
+		cacheModes := []bool{false}
+		if len(test.answers) > 0 || test.soa {
+			cacheModes = append(cacheModes, true)
+		}
+		for _, cached := range cacheModes {
+			for _, async := range []bool{false, true} {
+				name := test.name
+				if cached {
+					name += "/cached"
+				} else {
+					name += "/fresh"
+				}
+				if async {
+					name += "/async"
+				} else {
+					name += "/sync"
+				}
+				t.Run(name, func(t *testing.T) {
+					response := &mdns.Msg{MsgHdr: mdns.MsgHdr{Response: true, Rcode: test.rcode}}
+					for _, answer := range test.answers {
+						response.Answer = append(response.Answer, responseFilterRR(t, answer))
+					}
+					if test.soa {
+						response.Ns = []mdns.RR{responseFilterRR(t, soa)}
+					}
+					strategy := C.DomainStrategyAsIS
+					if test.ipv4Only {
+						strategy = C.DomainStrategyIPv4Only
+					}
+					router, primary, fallback := newResponseFilterRouter(t, response, strategy, test.qtype)
+					query := new(mdns.Msg).SetQuestion("example.test.", test.qtype)
+					if cached {
+						if _, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{Transport: primary}); err != nil {
+							t.Fatal(err)
+						}
+					}
+					var result *mdns.Msg
+					var err error
+					if async {
+						done := make(chan struct{})
+						router.ExchangeAsync(context.Background(), query, adapter.DNSQueryOptions{}, func(reply *mdns.Msg, failure error) { result, err = reply, failure; close(done) })
+						<-done
+					} else {
+						result, err = router.Exchange(context.Background(), query, adapter.DNSQueryOptions{})
+					}
+					if err != nil || result == nil {
+						t.Fatalf("response=%v error=%v", result, err)
+					}
+					if got := fallback.calls.Load() > 0; got != test.fallback {
+						t.Fatalf("fallback=%v want=%v response=%v", got, test.fallback, result)
+					}
+					if primary.calls.Load() != 1 {
+						t.Fatalf("primary queries=%d; cache must preserve and recheck original reply", primary.calls.Load())
+					}
+					if !test.fallback && result.Rcode != test.rcode {
+						t.Fatalf("negative rcode changed: %d", result.Rcode)
+					}
+					if test.ipv4Only {
+						for _, address := range MessageToAddresses(result) {
+							if address.Is6() {
+								t.Fatal("returned IPv6 hint despite IPv4-only strategy")
+							}
+						}
+					}
+				})
+			}
+		}
+	}
+}
