index 0000000000000000000000000000000000000000..b63a9a08294dc7fdfc69466ba106f4f0510dcbde
--- /dev/null
+++ b/dns/ordered_fallback.go
@@ -0,0 +1,158 @@
+package dns
+
+import (
+	"context"
+	"net/netip"
+
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+const maxDNSAttempts = 8
+
+var ErrHostsNotFound = E.New("hosts entry not found")
+
+func onlyHostsMiss(err error) bool {
+	if err == ErrHostsNotFound {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		children := joined.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !onlyHostsMiss(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyHostsMiss(wrapped.Unwrap())
+	}
+	return false
+}
+
+func exchangePoolError(response *dns.Msg, err error) error {
+	if err != nil {
+		return err
+	}
+	if response == nil {
+		return E.New("DNS transport returned an empty response")
+	}
+	if response.Rcode != dns.RcodeSuccess && response.Rcode != dns.RcodeNameError {
+		return RcodeError(response.Rcode)
+	}
+	if response.Rcode == dns.RcodeSuccess && len(response.Answer) == 0 && !isNODATAResponse(response) {
+		return E.New("DNS response is empty without negative authority")
+	}
+	return nil
+}
+
+func shouldContinueDNSRule(ctx context.Context, eligible bool, err error, attempts int) bool {
+	return eligible && err != nil && !onlyNegativeDNSResult(err) && attempts < maxDNSAttempts && ctx.Err() == nil
+}
+
+func shouldUseExplicitDNSFallback(ctx context.Context, fallback adapter.DNSTransport, err error) bool {
+	return fallback != nil && shouldContinueDNSRule(ctx, true, err, 0)
+}
+
+func dnsAttemptError(transport adapter.DNSTransport, err error) error {
+	if transport == nil {
+		return E.Cause(err, "DNS transport unavailable")
+	}
+	return E.Cause(err, "DNS server ", transport.Tag())
+}
+
+func explicitDNSPool(options adapter.DNSQueryOptions) ([]adapter.DNSTransport, error) {
+	if options.Transport == nil {
+		if options.FallbackTransport != nil || len(options.FallbackTransports) != 0 {
+			return nil, E.New("DNS fallbacks require an explicit primary transport")
+		}
+		return nil, nil
+	}
+	pool := []adapter.DNSTransport{options.Transport}
+	if options.FallbackTransport != nil {
+		pool = append(pool, options.FallbackTransport)
+	}
+	pool = append(pool, options.FallbackTransports...)
+	if len(pool) > maxDNSAttempts {
+		return nil, E.New("DNS fallback attempt limit exceeded")
+	}
+	seen := make(map[string]bool, len(pool))
+	for _, transport := range pool {
+		if transport == nil {
+			return nil, E.New("DNS fallback transport is unavailable")
+		}
+		if seen[transport.Tag()] {
+			return nil, E.New("duplicate DNS fallback transport: ", transport.Tag())
+		}
+		seen[transport.Tag()] = true
+	}
+	return pool, nil
+}
+
+func (r *Router) exchangeExplicitPoolAsync(ctx context.Context, message *dns.Msg, options adapter.DNSQueryOptions, callback func(*dns.Msg, adapter.DNSTransport, error)) {
+	pool, err := explicitDNSPool(options)
+	if err != nil {
+		callback(nil, nil, err)
+		return
+	}
+	options = r.finalizeExchangeOptions(options)
+	options.FallbackTransport, options.FallbackTransports = nil, nil
+	var failures []error
+	var attempt func(int)
+	attempt = func(index int) {
+		transport := pool[index]
+		options.Transport = transport
+		r.client.ExchangeAsync(adapter.OverrideContext(ctx), transport, message, options, nil, func(response *dns.Msg, err error) {
+			if len(pool) > 1 {
+				err = exchangePoolError(response, err)
+			}
+			if err == nil {
+				callback(response, transport, nil)
+				return
+			}
+			failures = append(failures, dnsAttemptError(transport, err))
+			if index+1 < len(pool) && shouldUseExplicitDNSFallback(ctx, pool[index+1], err) {
+				attempt(index + 1)
+				return
+			}
+			callback(nil, transport, E.Errors(failures...))
+		})
+	}
+	attempt(0)
+}
+
+func (r *Router) exchangeExplicitPool(ctx context.Context, message *dns.Msg, options adapter.DNSQueryOptions) (*dns.Msg, adapter.DNSTransport, error) {
+	result := make(chan exchangeWithRulesResult, 1)
+	r.exchangeExplicitPoolAsync(ctx, message, options, func(response *dns.Msg, transport adapter.DNSTransport, err error) {
+		result <- exchangeWithRulesResult{response: response, transport: transport, err: err}
+	})
+	completed := <-result
+	return completed.response, completed.transport, completed.err
+}
+
+func (r *Router) lookupExplicitPool(ctx context.Context, domain string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	pool, err := explicitDNSPool(options)
+	if err != nil {
+		return nil, err
+	}
+	options = r.finalizeExchangeOptions(options)
+	options.FallbackTransport, options.FallbackTransports = nil, nil
+	var failures []error
+	for index, transport := range pool {
+		options.Transport = transport
+		addresses, err := r.client.Lookup(adapter.OverrideContext(ctx), transport, domain, options, nil)
+		if err == nil {
+			return addresses, nil
+		}
+		failures = append(failures, dnsAttemptError(transport, err))
+		if index+1 == len(pool) || !shouldUseExplicitDNSFallback(ctx, pool[index+1], err) {
+			break
+		}
+	}
+	return nil, E.Errors(failures...)
+}
diff --git a/dns/policy.go b/dns/policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..4d537dddafcf10761daf507af2b46ee999552efd
--- /dev/null
+++ b/dns/policy.go
@@ -0,0 +1,105 @@
+package dns
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+type dnsPolicy struct {
+	rules []adapter.DNSRule
+	final string
+}
+
+func (r *Router) ValidateDNSPolicy(policy string) error {
+	return r.validatePolicy(adapter.DNSQueryOptions{Policy: policy})
+}
+
+func routerInitializePolicies(r *Router, start bool) error {
+	if len(r.policyOptions) > 8 {
+		return E.New("at most eight named DNS policies are supported")
+	}
+	policies := make(map[string]dnsPolicy, len(r.policyOptions))
+	complete := false
+	defer func() {
+		if !complete {
+			for _, policy := range policies {
+				closeRules(policy.rules)
+			}
+		}
+	}()
+	for _, source := range r.policyOptions {
+		if source.Tag == "" || source.Tag == "default" || len(source.Tag) > 128 || source.Final == "" || len(source.Rules) > 4096 {
+			return E.New("invalid named DNS policy")
+		}
+		if _, exists := policies[source.Tag]; exists {
+			return E.New("duplicate DNS policy: ", source.Tag)
+		}
+		if start {
+			if _, found := r.transport.Transport(source.Final); !found {
+				return E.New("DNS policy ", source.Tag, " final server not found: ", source.Final)
+			}
+		}
+		// A concrete terminal route prevents errors from entering the default
+		// policy. The native walker, including async evaluation, is shared.
+		rawRules := append([]option.DNSRule(nil), source.Rules...)
+		rawRules = append(rawRules, option.DNSRule{
+			Type: C.RuleTypeDefault,
+			DefaultOptions: option.DefaultDNSRule{DNSRuleAction: option.DNSRuleAction{
+				Action:       C.RuleActionTypeRoute,
+				RouteOptions: option.DNSRouteActionOptions{Server: source.Final},
+			}},
+		})
+		rules, _, _, err := r.buildRuleList(rawRules, start, true)
+		if err != nil {
+			return E.Cause(err, "DNS policy ", source.Tag)
+		}
+		policies[source.Tag] = dnsPolicy{rules: rules, final: source.Final}
+	}
+	if err := r.closePolicies(); err != nil {
+		return err
+	}
+	r.policies = policies
+	complete = true
+	return nil
+}
+
+func (r *Router) closePolicies() error {
+	var errs []error
+	for tag, policy := range r.policies {
+		for index, rule := range policy.rules {
+			if err := rule.Close(); err != nil {
+				errs = append(errs, E.Cause(err, "close DNS policy ", tag, " rule[", index, "]"))
+			}
+		}
+	}
+	return E.Errors(errs...)
+}
+
+func (r *Router) validatePolicy(options adapter.DNSQueryOptions) error {
+	if options.Policy == "" {
+		return nil
+	}
+	if options.Transport != nil || options.FallbackTransport != nil || len(options.FallbackTransports) != 0 {
+		return E.New("DNS policy cannot be combined with explicit resolver transports")
+	}
+	if options.Policy != "default" {
+		policy, found := r.policies[options.Policy]
+		if !found {
+			return E.New("DNS policy not found: ", options.Policy)
+		}
+		if _, found := r.transport.Transport(policy.final); !found {
+			return E.New("DNS policy final server is unavailable: ", policy.final)
+		}
+	}
+	return nil
+}
+
+// Called after validatePolicy and while the router's state is held for reading.
+func (r *Router) policyRules(tag string) ([]adapter.DNSRule, bool) {
+	if tag == "" || tag == "default" {
+		return r.rules, r.legacyDNSMode
+	}
+	return r.policies[tag].rules, false
+}
