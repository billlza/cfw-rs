@@ -0,0 +1,84 @@
+package dns
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"reflect"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+type routedDialer struct {
+	router  adapter.DNSConnectionRouter
+	domain  string
+	timeout time.Duration
+}
+type dnsRoutingDepth struct{}
+
+func newRoutedDialer(ctx context.Context, options option.RemoteDNSServerOptions) (N.Dialer, error) {
+	remaining := options.DialerOptions
+	remaining.DomainResolver = nil
+	remaining.ConnectTimeout = 0
+	if !reflect.ValueOf(remaining).IsZero() {
+		return nil, E.New("routed DNS accepts bootstrap and timeout, not detour or socket overrides")
+	}
+	router, ok := service.FromContext[adapter.Router](ctx).(adapter.DNSConnectionRouter)
+	if !ok {
+		return nil, E.New("DNS route selection is unavailable")
+	}
+	timeout := time.Duration(options.ConnectTimeout)
+	if timeout == 0 {
+		timeout = 5 * time.Second
+	}
+	if timeout < time.Millisecond || timeout > 30*time.Second {
+		return nil, E.New("routed DNS connect timeout is outside 1ms..30s")
+	}
+	routed := &routedDialer{router: router, timeout: timeout}
+	var base N.Dialer = routed
+	if options.ServerIsDomain() {
+		routed.domain = options.Server
+		resolver := options.DomainResolver
+		if resolver == nil || resolver.Server == "" || resolver.Policy != "" {
+			return nil, E.New("routed DNS domain endpoints require explicit bootstrap servers")
+		}
+		query := adapter.DNSQueryOptions{Strategy: C.DomainStrategy(resolver.Strategy), DisableCache: resolver.DisableCache, RewriteTTL: resolver.RewriteTTL, ClientSubnet: resolver.ClientSubnet.Build(netip.Prefix{})}
+		base = dialer.NewResolveDialer(ctx, base, false, resolver.Server, resolver.FallbackTags(), query, 0)
+	}
+	return base, nil
+}
+
+func (d *routedDialer) context(ctx context.Context) (context.Context, context.CancelFunc, error) {
+	depth, _ := ctx.Value(dnsRoutingDepth{}).(int)
+	if depth >= 4 {
+		return nil, nil, E.New("DNS routing dependency cycle")
+	}
+	ctx, cancel := context.WithTimeout(context.WithValue(ctx, dnsRoutingDepth{}, depth+1), d.timeout)
+	return ctx, cancel, nil
+}
+
+func (d *routedDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	ctx, cancel, err := d.context(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer cancel()
+	return d.router.DialDNSConnection(ctx, network, destination, d.domain)
+}
+
+func (d *routedDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, cancel, err := d.context(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer cancel()
+	return d.router.ListenDNSPacket(ctx, destination, d.domain)
+}
diff --git a/dns/routed_dialer_test.go b/dns/routed_dialer_test.go
