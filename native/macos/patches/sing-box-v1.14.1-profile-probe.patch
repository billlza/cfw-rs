+)
+
+type migrationFlowPort struct {
+	adapter.Outbound
+	name   string
+	action adapter.PreMatchAction
+}
+
+func (p *migrationFlowPort) Tag() string                                            { return p.name }
+func (p *migrationFlowPort) Type() string                                           { return "migration-test-port" }
+func (p *migrationFlowPort) Network() []string                                      { return []string{N.NetworkTCP, N.NetworkUDP} }
+func (p *migrationFlowPort) PreMatchFlow(string, netip.Addr) adapter.PreMatchAction { return p.action }
+func (p *migrationFlowPort) PortAddresses() (netip.Addr, netip.Addr) {
+	return netip.Addr{}, netip.Addr{}
+}
+func (p *migrationFlowPort) PortMTU() uint32               { return 1500 }
+func (p *migrationFlowPort) AttachReturn(tun.Return) error { return nil }
+func (p *migrationFlowPort) DetachReturn(tun.Return) error { return nil }
+func (p *migrationFlowPort) WritePackets([][]byte) error   { return nil }
+
+type migrationFlowGroup struct {
+	adapter.Outbound
+	selected   adapter.Outbound
+	err        error
+	metadata   adapter.InboundContext
+	selections atomic.Int32
+	commits    atomic.Int32
+}
+
+func (g *migrationFlowGroup) Tag() string       { return "balanced" }
+func (g *migrationFlowGroup) Type() string      { return C.TypeLoadBalance }
+func (g *migrationFlowGroup) Network() []string { return []string{N.NetworkTCP, N.NetworkUDP} }
+func (g *migrationFlowGroup) Now() string       { return "" }
+func (g *migrationFlowGroup) All() []string     { return []string{"first", "second"} }
+func (g *migrationFlowGroup) SelectFlowOutbound(_ context.Context, metadata adapter.InboundContext) (adapter.Outbound, func(), error) {
+	g.selections.Add(1)
+	g.metadata = metadata
+	return g.selected, func() { g.commits.Add(1) }, g.err
+}
+
+type migrationFlowManager struct {
+	adapter.OutboundManager
+	group *migrationFlowGroup
+}
+
+func (m migrationFlowManager) Default() adapter.Outbound { return m.group }
+func (m migrationFlowManager) Outbound(tag string) (adapter.Outbound, bool) {
+	return m.group, tag == m.group.Tag()
+}
+
+type migrationFlowDNS struct{ adapter.DNSRouter }
+
+func (migrationFlowDNS) LookupReverseMapping(netip.Addr) (string, bool) { return "", false }
+
+type migrationFlowDNSTransports struct{ adapter.DNSTransportManager }
+
+func (migrationFlowDNSTransports) FakeIP() adapter.FakeIPTransport { return nil }
+
+type migrationFlowRule struct {
+	adapter.Rule
+	action adapter.RuleAction
+}
+
+func (r migrationFlowRule) Match(*adapter.InboundContext) bool { return true }
+func (r migrationFlowRule) String() string                     { return "" }
+func (r migrationFlowRule) Action() adapter.RuleAction         { return r.action }
+
+func migrationFlowRouter(group *migrationFlowGroup, action adapter.RuleAction) *Router {
+	router := &Router{ctx: context.Background(), logger: log.NewNOPFactory().Logger(),
+		outbound: migrationFlowManager{group: group}, dns: migrationFlowDNS{}, dnsTransport: migrationFlowDNSTransports{}}
+	if action != nil {
+		router.rules = []adapter.Rule{migrationFlowRule{action: action}}
+	}
+	return router
+}
+
+func TestFlowGroupMigrationJudgeFlowRetainsConcretePortAndCommitsOnAdmission(t *testing.T) {
+	for _, bypass := range []bool{false, true} {
+		t.Run(map[bool]string{false: "route", true: "bypass"}[bypass], func(t *testing.T) {
+			first := &migrationFlowPort{name: "first", action: adapter.PreMatchFlow}
+			group := &migrationFlowGroup{selected: first}
+			var action adapter.RuleAction
+			if bypass {
+				action = &R.RuleActionBypass{Outbound: group.Tag()}
+			}
+			router := migrationFlowRouter(group, action)
+			source := netip.MustParseAddrPort("192.0.2.10:12345")
+			destination := netip.MustParseAddrPort("198.51.100.20:443")
+			verdict := adapter.JudgeFlow(router, "cfw-tunnel", C.TypeTun, 17, source, destination, nil)
+			want := tun.ActionFlow
+			if bypass {
+				want = tun.ActionBypass
+			}
+			if verdict.Action != want || verdict.Port != first || verdict.NewTracker == nil {
+				t.Fatalf("lost concrete flow port: action=%v port=%v", verdict.Action, verdict.Port)
+			}
+			if group.metadata.Source.AddrPort() != source || group.metadata.Destination.AddrPort() != destination || group.metadata.Network != N.NetworkUDP {
+				t.Fatal("flow selection lost source, destination, or protocol")
+			}
+			if group.commits.Load() != 0 {
+				t.Fatal("pre-match committed an unadmitted flow")
+			}
+			group.selected = &migrationFlowPort{name: "second", action: adapter.PreMatchFlow}
+			var workers sync.WaitGroup
+			for range 8 {
+				workers.Go(func() { verdict.NewTracker().CloseFlow(tun.FlowCloseFinished) })
+			}
+			workers.Wait()
+			if group.commits.Load() != 1 || verdict.Port != first {
+				t.Fatal("flow commit repeated or an established flow changed ports")
+			}
+		})
+	}
+}
+
+func TestFlowGroupMigrationSelectionFailureCannotBypassPolicy(t *testing.T) {
+	for _, bypass := range []bool{false, true} {
+		group := &migrationFlowGroup{err: errors.New("no healthy member")}
+		var action adapter.RuleAction
+		if bypass {
+			action = &R.RuleActionBypass{Outbound: group.Tag()}
+		}
+		verdict := adapter.JudgeFlow(migrationFlowRouter(group, action), "cfw-tunnel", C.TypeTun, 17,
+			netip.MustParseAddrPort("192.0.2.10:12345"), netip.MustParseAddrPort("198.51.100.20:443"), nil)
+		if verdict.Action != tun.ActionReject || verdict.Port != nil || group.commits.Load() != 0 {
+			t.Fatalf("bypass=%v selection failure became %+v", bypass, verdict)
+		}
+	}
+}
+
+func TestFlowGroupMigrationRetainsConcreteOutboundRejection(t *testing.T) {
+	group := &migrationFlowGroup{selected: &migrationFlowPort{name: "first", action: adapter.PreMatchReject}}
+	verdict := adapter.JudgeFlow(migrationFlowRouter(group, nil), "cfw-tunnel", C.TypeTun, 17,
+		netip.MustParseAddrPort("192.0.2.10:12345"), netip.MustParseAddrPort("198.51.100.20:443"), nil)
+	if verdict.Action != tun.ActionReject || group.commits.Load() != 0 {
+		t.Fatal("outbound rejection was bypassed or committed")
+	}
+}
