+func TestNestedHealthBatchPreservesEveryMemberAndPolicyIsolation(t *testing.T) {
+	for _, samePolicy := range []bool{false, true} {
+		t.Run(map[bool]string{false: "isolated", true: "shared-target"}[samePolicy], func(t *testing.T) {
+			var requests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests.Add(1)
+				if r.URL.Path == "/ok" {
+					w.WriteHeader(204)
+				} else {
+					w.WriteHeader(503)
+				}
+			}))
+			defer server.Close()
+			manager := migrationOutboundManager{members: make(map[string]adapter.Outbound)}
+			var leaves []adapter.Outbound
+			for _, tag := range []string{"first", "second"} {
+				leaf := &fallbackDialTestOutbound{selectionTestOutbound{name: tag}, func(ctx context.Context) (net.Conn, error) {
+					return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+				}}
+				manager.members[tag] = leaf
+				leaves = append(leaves, leaf)
+			}
+			ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+			childGroup, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), leaves, server.URL+"/ok", time.Minute, 0, time.Minute, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer childGroup.Close()
+			childGroup.expectedStatus = "204"
+			child := &URLTest{Adapter: outbound.NewAdapter(C.TypeURLTest, "nested", []string{"tcp", "udp"}, nil),
+				tags: []string{"first", "second"}, group: childGroup}
+			manager.members[child.Tag()] = child
+			link := server.URL + "/bad"
+			if samePolicy {
+				link = server.URL + "/ok"
+			}
+			parent, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{child}, link, time.Minute, 0, time.Minute, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer parent.Close()
+			parent.expectedStatus = "204"
+			result, err := parent.URLTest(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, tag := range []string{"first", "second"} {
+				if childGroup.history.LoadURLTestHistory(tag) == nil {
+					t.Fatal("nested batch omitted a member")
+				}
+				if samePolicy && (result[tag] == 0 || parent.history.LoadURLTestHistory(tag) == nil) {
+					t.Fatal("matching policy lost measured history")
+				}
+				if !samePolicy && parent.history.LoadURLTestHistory(tag) != nil {
+					t.Fatal("parent borrowed a different target's success")
+				}
+			}
+			if samePolicy && (requests.Load() != 2 || result[child.Tag()] == 0) {
+				t.Fatalf("matching nested policy was measured repeatedly: %d requests, %v", requests.Load(), result)
+			}
+			if !samePolicy && (requests.Load() != 4 || len(result) != 0) {
+				t.Fatalf("strict parent policy became successful: %d requests, %v", requests.Load(), result)
+			}
+		})
+	}
+}
+
+func TestNestedHealthPlanRejectsCyclesAndMissingMembers(t *testing.T) {
+	for _, cyclic := range []bool{false, true} {
+		selector := migrationSelector{selectionTestOutbound: selectionTestOutbound{name: "selector"}, selected: "missing", members: []string{"missing"}}
+		if cyclic {
+			selector.selected, selector.members = "selector", []string{"selector"}
+		}
+		manager := migrationOutboundManager{members: map[string]adapter.Outbound{"selector": selector}}
+		ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+		group, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{selector}, "http://example.com", time.Minute, 0, time.Minute, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer group.Close()
+		if _, err := group.URLTest(ctx); err == nil {
+			t.Fatalf("cyclic=%v invalid graph became an empty successful probe", cyclic)
+		}
+	}
+}
+
+func TestFlowSelectionCommitsStickyStateOnlyOnAdmission(t *testing.T) {
+	proxy := balanceFixture(t, "sticky-sessions")
+	metadata := adapter.InboundContext{Source: M.ParseSocksaddr("192.0.2.10:12345"), Destination: M.ParseSocksaddr("video.example.com:443"), Network: "udp"}
+	manager := new(outbound.Manager)
+	var activity atomic.Int32
+	stopWatching := manager.WatchOutboundActivity([]string{"A", "B", "C"}, func() { activity.Add(1) })
+	defer stopWatching()
+	baseContext := service.ContextWith[adapter.OutboundManager](context.Background(), manager)
+	selected, commit, err := proxy.SelectFlowOutbound(baseContext, metadata)
+	if err != nil || selected == nil || commit == nil {
+		t.Fatalf("select flow: %v", err)
+	}
+	ctx := adapter.WithContext(baseContext, &metadata)
+	key := balanceKey(ctx, metadata.Destination, true)
+	proxy.balance.access.Lock()
+	_, present := proxy.balance.sessions.Load(key)
+	proxy.balance.access.Unlock()
+	if present || activity.Load() != 0 {
+		t.Fatal("unadmitted flow published a sticky session")
+	}
+	commit()
+	proxy.balance.access.Lock()
+	remembered, present := proxy.balance.sessions.Load(key)
+	proxy.balance.access.Unlock()
+	if !present || remembered != selected.Tag() || activity.Load() != 1 {
+		t.Fatal("admitted flow lost its selected member")
+	}
+	for _, member := range proxy.group.outbounds {
+		proxy.group.history.DeleteURLTestHistory(member.Tag())
+	}
+	if next, _, err := proxy.SelectFlowOutbound(context.Background(), metadata); err == nil || next != nil {
+		t.Fatal("failed group bypassed health policy for a flow")
+	}
+}
