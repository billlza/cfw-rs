@@ -0,0 +1,37 @@
+package outbound
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestActivityWatchersAreScopedCancellableAndConcurrent(t *testing.T) {
+	manager := new(Manager)
+	var a, b atomic.Int32
+	stopA := manager.WatchOutboundActivity([]string{"node", "other"}, func() { a.Add(1) })
+	stopB := manager.WatchOutboundActivity([]string{"node"}, func() { b.Add(1) })
+	var workers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		workers.Go(func() {
+			for j := 0; j < 100; j++ {
+				manager.TouchOutboundActivity("node")
+			}
+		})
+	}
+	workers.Wait()
+	if a.Load() != 800 || b.Load() != 800 {
+		t.Fatal("activity lost or duplicated")
+	}
+	stopA()
+	stopA()
+	manager.TouchOutboundActivity("node")
+	manager.TouchOutboundActivity("other")
+	if a.Load() != 800 || b.Load() != 801 {
+		t.Fatal("watcher cancellation changed another provider")
+	}
+	stopB()
+	if len(manager.activity.subscribers) != 0 {
+		t.Fatal("cancelled watcher retained resources")
+	}
+}
