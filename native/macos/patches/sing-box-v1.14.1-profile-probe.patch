+func TestGroupHealthChecksEndOnCallerCancellationAndClose(t *testing.T) {
+	for _, closeGroup := range []bool{false, true} {
+		t.Run(map[bool]string{false: "caller", true: "close"}[closeGroup], func(t *testing.T) {
+			started := make(chan struct{})
+			node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) { close(started); <-ctx.Done(); return nil, ctx.Err() }}
+			manager := healthProbeTestManager{node: node}
+			g, err := NewURLTestGroup(service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage()), manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, "http://example.com/probe", time.Minute, 0, time.Minute, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer g.Close()
+			g.history.StoreURLTestHistory("node", &adapter.URLTestHistory{Time: time.Now().Add(-time.Hour), Delay: 10})
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { _, err := g.URLTest(ctx); done <- err }()
+			select {
+			case <-started:
+			case <-time.After(time.Second):
+				t.Fatal("health probe did not start")
+			}
+			if closeGroup {
+				if err := g.Close(); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				cancel()
+			}
+			select {
+			case err := <-done:
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("cancellation became %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("canceled health probe outlived its owner")
+			}
+			if g.history.LoadURLTestHistory("node") == nil {
+				t.Fatal("owner cancellation incorrectly marked the node down")
+			}
+		})
+	}
+}
diff --git a/protocol/group/health_check.go b/protocol/group/health_check.go
new file mode 100644
index 0000000000000000000000000000000000000000..411f1b8f112c387951cafb8e7047916cacc48444
--- /dev/null
+++ b/protocol/group/health_check.go
@@ -0,0 +1,218 @@
+package group
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing/common/batch"
+	E "github.com/sagernet/sing/common/exceptions"
+	"maps"
+	"sync"
+	"time"
+)
+
+func (g *URLTestGroup) CheckOutbounds(ctx context.Context, force bool) {
+	_, _ = g.urlTest(ctx, force)
+}
+
+type healthCheckRun struct {
+	done   chan struct{}
+	result map[string]uint16
+	err    error
+}
+
+func (g *URLTestGroup) URLTest(ctx context.Context) (map[string]uint16, error) {
+	return g.urlTest(ctx, true)
+}
+
+func (g *URLTestGroup) urlTest(ctx context.Context, force bool) (result map[string]uint16, err error) {
+	if err := g.ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	g.checkAccess.Lock()
+	if current := g.checking; current != nil {
+		g.checkAccess.Unlock()
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-g.ctx.Done():
+			return nil, g.ctx.Err()
+		case <-current.done:
+			return maps.Clone(current.result), current.err
+		}
+	}
+	current := &healthCheckRun{done: make(chan struct{})}
+	g.checking = current
+	g.checkAccess.Unlock()
+	defer func() {
+		g.checkAccess.Lock()
+		current.result, current.err = maps.Clone(result), err
+		g.checking = nil
+		close(current.done)
+		g.checkAccess.Unlock()
+	}()
+	result = make(map[string]uint16)
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(g.ctx, cancel)
+	defer stop()
+	defer cancel()
+	plan, err := g.planHealthChecks()
+	if err != nil {
+		return nil, err
+	}
+	nestedBatch, _ := batch.New(ctx, batch.WithConcurrencyNum[any](10))
+	var reuseAccess sync.Mutex
+	reusable := make(map[string]*adapter.URLTestHistory)
+	for _, nested := range plan.nested {
+		nestedBatch.Go(nested.Tag(), func() (any, error) {
+			if _, err := nested.group.urlTest(ctx, force); err != nil {
+				return nil, err
+			}
+			if g.link == nested.group.link && g.expectedStatus == nested.group.expectedStatus && g.probeTimeout == nested.group.probeTimeout {
+				reuseAccess.Lock()
+				for _, detour := range plan.leaves {
+					if observed := nested.group.history.LoadURLTestHistory(detour.Tag()); observed != nil && time.Since(observed.Time) < g.interval {
+						reusable[detour.Tag()] = observed
+					}
+				}
+				reuseAccess.Unlock()
+			}
+			return nil, nil
+		})
+	}
+	if nestedErr := nestedBatch.Wait(); nestedErr != nil {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		return nil, E.Cause(nestedErr.Err, "nested health-check group ", nestedErr.Key)
+	}
+	// A balanced group has no single Now() member. Measure the group through
+	// its own selected dialer as well as visiting every underlying member.
+	for _, outboundGroup := range plan.groups {
+		if RealTag(g.outbound, outboundGroup) == outboundGroup.Tag() {
+			plan.leaves = append(plan.leaves, outboundGroup)
+		}
+	}
+	b, _ := batch.New(ctx, batch.WithConcurrencyNum[any](10))
+	var resultAccess sync.Mutex
+	for _, detour := range plan.leaves {
+		tag := detour.Tag()
+		history := g.history.LoadURLTestHistory(tag)
+		if observed := reusable[tag]; observed != nil {
+			g.history.StoreURLTestHistory(tag, observed)
+			resultAccess.Lock()
+			result[tag] = observed.Delay
+			resultAccess.Unlock()
+			continue
+		}
+		if !force && history != nil && time.Since(history.Time) < g.interval {
+			resultAccess.Lock()
+			result[tag] = history.Delay
+			resultAccess.Unlock()
+			continue
+		}
+		b.Go(tag, func() (any, error) {
+			testCtx, cancel := context.WithTimeout(ctx, g.probeTimeout)
+			defer cancel()
+			delay, err := urltest.URLTestWithStatus(testCtx, g.link, g.expectedStatus, detour)
+			if err != nil {
+				if ctx.Err() != nil {
+					return nil, ctx.Err()
+				}
+				g.logger.Debug("outbound ", tag, " unavailable: ", err)
+				g.history.DeleteURLTestHistory(tag)
+				if g.sharedHistory != nil {
+					g.sharedHistory.DeleteURLTestHistory(tag)
+				}
+			} else {
+				g.logger.Debug("outbound ", tag, " available: ", delay, "ms")
+				observed := &adapter.URLTestHistory{Time: time.Now(), Delay: delay}
+				g.history.StoreURLTestHistory(tag, observed)
+				if g.sharedHistory != nil {
+					g.sharedHistory.StoreURLTestHistory(tag, observed)
+				}
+				resultAccess.Lock()
+				result[tag] = delay
+				resultAccess.Unlock()
+			}
+			return nil, nil
+		})
+	}
+	if batchErr := b.Wait(); batchErr != nil {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		return nil, batchErr
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	for _, outboundGroup := range plan.groups {
+		if observed := g.history.LoadURLTestHistory(RealTag(g.outbound, outboundGroup)); observed != nil {
+			result[outboundGroup.Tag()] = observed.Delay
+		}
+	}
+	g.probed.Store(true)
+	g.performUpdateCheck()
+	return result, nil
+}
+
+// Resolve the graph before starting work so a cycle or missing member is an
+// explicit error, not an empty successful batch or a single-flight deadlock.
+type healthProbePlan struct {
+	leaves []adapter.Outbound
+	nested []*URLTest
+	groups []adapter.OutboundGroup
+}
+
+func (g *URLTestGroup) planHealthChecks() (healthProbePlan, error) {
+	var plan healthProbePlan
+	seen, active := make(map[string]bool), make(map[string]bool)
+	var visit func(adapter.Outbound, bool) error
+	visit = func(detour adapter.Outbound, insideHealthGroup bool) error {
+		tag := detour.Tag()
+		if active[tag] {
+			return E.New("cyclic health-check group: ", tag)
+		}
+		if seen[tag] {
+			return nil
+		}
+		seen[tag] = true
+		group, isGroup := detour.(adapter.OutboundGroup)
+		if !isGroup {
+			plan.leaves = append(plan.leaves, detour)
+			return nil
+		}
+		active[tag] = true
+		defer delete(active, tag)
+		plan.groups = append(plan.groups, group)
+		if nested, isHealthGroup := detour.(*URLTest); isHealthGroup {
+			if nested.group == nil {
+				return E.New("health-check group is not started: ", tag)
+			}
+			if !insideHealthGroup {
+				plan.nested = append(plan.nested, nested)
+			}
+			insideHealthGroup = true
+		}
+		for _, memberTag := range group.All() {
+			member, loaded := g.outbound.Outbound(memberTag)
+			if !loaded {
+				return E.New("health-check member not found: ", memberTag)
+			}
+			if err := visit(member, insideHealthGroup); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	for _, detour := range g.outbounds {
+		if err := visit(detour, false); err != nil {
+			return healthProbePlan{}, err
+		}
+	}
+	return plan, nil
+}
diff --git a/protocol/group/health_policy_test.go b/protocol/group/health_policy_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..60cd77de8f76cd2e9b8db3721b9b891f9d8fa33f
--- /dev/null
+++ b/protocol/group/health_policy_test.go
@@ -0,0 +1,90 @@
+package group
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/service"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHealthPoliciesDoNotBorrowAnotherURLsSuccess(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/ok" {
+			w.WriteHeader(204)
+		} else {
+			w.WriteHeader(503)
+		}
+	}))
+	defer server.Close()
+	node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}}
+	manager := healthProbeTestManager{node: node}
+	ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+	first, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL+"/ok", time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	first.expectedStatus = "204"
+	if result, err := first.URLTest(ctx); err != nil || len(result) != 1 {
+		t.Fatalf("first: %v %v", result, err)
+	}
+	second, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL+"/bad", time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	second.expectedStatus = "204"
+	result, err := second.urlTest(ctx, false)
+	if err != nil || len(result) != 0 || second.history.LoadURLTestHistory("node") != nil {
+		t.Fatal("provider reused a different URL's success")
+	}
+	if first.history.LoadURLTestHistory("node") == nil {
+		t.Fatal("one provider's failure erased another policy")
+	}
+}
+
+func TestOverlappingHealthChecksCoalesceAndReturnObservedResults(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		once.Do(func() { close(started) })
+		<-release
+		w.WriteHeader(204)
+	}))
+	defer server.Close()
+	node := &fallbackDialTestOutbound{selectionTestOutbound{name: "node"}, func(ctx context.Context) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+	}}
+	g, err := NewURLTestGroup(service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage()), healthProbeTestManager{node: node}, log.NewNOPFactory().Logger(), []adapter.Outbound{node}, server.URL, time.Minute, 0, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer g.Close()
+	first := make(chan map[string]uint16, 1)
+	go func() {
+		result, err := g.URLTest(context.Background())
+		if err != nil {
+			t.Error(err)
+		}
+		first <- result
+	}()
+	<-started
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if _, err := g.URLTest(ctx); err == nil {
+		t.Fatal("waiting caller cancellation became empty success")
+	}
+	close(release)
+	if result := <-first; len(result) != 1 {
+		t.Fatal("coalesced run lost its result")
+	}
+}
diff --git a/protocol/group/loadbalance.go b/protocol/group/loadbalance.go
new file mode 100644
index 0000000000000000000000000000000000000000..179035d2cf00b0795202898c8adf2ebce7d43a6f
--- /dev/null
+++ b/protocol/group/loadbalance.go
@@ -0,0 +1,138 @@
+package group
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/cache"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	"golang.org/x/net/publicsuffix"
+)
+
+const maxStickySessions = 1024
+
+type loadBalancePolicy struct {
+	strategy string
+	cursor   atomic.Uint64
+	// Serialize the cache's value access as well as mutation. The upstream LRU
+	// protects its index, but Load returns a value after releasing its index lock.
+	access   sync.Mutex
+	sessions *cache.LruCache[string, string]
+}
+
+func NewLoadBalance(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.LoadBalanceOutboundOptions) (adapter.Outbound, error) {
+	if options.InterruptExistConnections {
+		return nil, E.New("load-balance keeps established sessions on their original outbound")
+	}
+	strategy := options.Strategy
+	if strategy == "" {
+		strategy = "consistent-hashing"
+	}
+	if strategy != "consistent-hashing" && strategy != "sticky-sessions" && strategy != "round-robin" {
+		return nil, E.New("unsupported load-balance strategy")
+	}
+	proxy, err := newHealthCheckGroup(ctx, router, logger, tag, option.URLTestOutboundOptions{
+		Outbounds: options.Outbounds, URL: options.URL, Interval: options.Interval,
+		IdleTimeout: options.IdleTimeout, Lazy: options.Lazy, Hidden: options.Hidden, Timeout: options.Timeout, ExpectedStatus: options.ExpectedStatus,
+	}, C.TypeLoadBalance)
+	if err != nil {
+		return nil, err
+	}
+	proxy.balance = &loadBalancePolicy{strategy: strategy,
+		sessions: cache.New[string, string](cache.WithSize[string, string](maxStickySessions), cache.WithAge[string, string](600))}
+	return proxy, nil
+}
+
+func balanceDestination(destination M.Socksaddr) string {
+	if !destination.IsDomain() {
+		return destination.Addr.Unmap().String()
+	}
+	host := strings.TrimSuffix(strings.ToLower(destination.Fqdn), ".")
+	if domain, err := publicsuffix.EffectiveTLDPlusOne(host); err == nil {
+		return domain
+	}
+	return host
+}
+
+func balanceKey(ctx context.Context, destination M.Socksaddr, sticky bool) string {
+	key := balanceDestination(destination)
+	if sticky {
+		source := ""
+		if metadata := adapter.ContextFrom(ctx); metadata != nil && metadata.Source.Addr.IsValid() {
+			source = metadata.Source.Addr.Unmap().String()
+		}
+		key = source + "\x00" + key
+	}
+	return key
+}
+
+func (s *URLTest) connectionCandidates(ctx context.Context, network string, destination M.Socksaddr) []adapter.Outbound {
+	candidates := s.group.orderedCandidates(network)
+	if s.balance == nil || len(candidates) == 0 {
+		return candidates
+	}
+	p := s.balance
+	if p.strategy == "round-robin" {
+		first := int((p.cursor.Add(1) - 1) % uint64(len(candidates)))
+		return append(candidates[first:], candidates[:first]...)
+	}
+	key := balanceKey(ctx, destination, p.strategy == "sticky-sessions")
+	// Rendezvous hashing depends on member identities, not their list positions.
+	// Adding/removing a member does not reshuffle unrelated destinations.
+	type scored struct {
+		outbound adapter.Outbound
+		score    uint64
+	}
+	scores := make([]scored, len(candidates))
+	for i, node := range candidates {
+		digest := sha256.Sum256([]byte(key + "\x00" + node.Tag()))
+		scores[i] = scored{node, binary.BigEndian.Uint64(digest[:8])}
+	}
+	sort.Slice(scores, func(i, j int) bool {
+		if scores[i].score == scores[j].score {
+			return scores[i].outbound.Tag() < scores[j].outbound.Tag()
+		}
+		return scores[i].score > scores[j].score
+	})
+	for i, node := range scores {
+		candidates[i] = node.outbound
+	}
+	if p.strategy == "sticky-sessions" {
+		p.access.Lock()
+		selected, exists := p.sessions.Load(key)
+		p.access.Unlock()
+		if exists {
+			for i, node := range candidates {
+				if node.Tag() == selected {
+					copy(candidates[1:i+1], candidates[:i])
+					candidates[0] = node
+					break
+				}
+			}
+		}
+	}
+	return candidates
+}
+
+func (s *URLTest) rememberConnection(ctx context.Context, destination M.Socksaddr, tag string) {
+	if s.balance == nil || s.balance.strategy != "sticky-sessions" {
+		return
+	}
+	p := s.balance
+	key := balanceKey(ctx, destination, true)
+	p.access.Lock()
+	defer p.access.Unlock()
+	if current, exists := p.sessions.Load(key); !exists || current != tag {
+		p.sessions.Store(key, tag)
+	}
+}
diff --git a/protocol/group/loadbalance_test.go b/protocol/group/loadbalance_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..87ff65e7539dba9b4d2dda2182f3657c951e4751
--- /dev/null
+++ b/protocol/group/loadbalance_test.go
@@ -0,0 +1,143 @@
+package group
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func balanceFixture(t *testing.T, strategy string) *URLTest {
+	t.Helper()
+	outbound, err := NewLoadBalance(context.Background(), nil, nil, "balanced", option.LoadBalanceOutboundOptions{Outbounds: []string{"A", "B", "C"}, Strategy: strategy})
+	if err != nil {
+		t.Fatal(err)
+	}
+	proxy := outbound.(*URLTest)
+	history := urltest.NewHistoryStorage()
+	proxy.group = &URLTestGroup{balanced: true, history: history, interruptGroup: interrupt.NewGroup()}
+	for _, tag := range []string{"A", "B", "C"} {
+		proxy.group.outbounds = append(proxy.group.outbounds, selectionTestOutbound{name: tag})
+		history.StoreURLTestHistory(tag, &adapter.URLTestHistory{Time: time.Now(), Delay: 20})
+	}
+	proxy.group.probed.Store(true)
+	return proxy
+}
+
+func TestConsistentHashingIsStableAcrossPortsNetworksOrderAndSubdomains(t *testing.T) {
+	p := balanceFixture(t, "consistent-hashing")
+	ctx := context.Background()
+	choice := p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr("a.example.co.uk:443"))[0].Tag()
+	for _, target := range []string{"b.example.co.uk:80", "EXAMPLE.CO.UK.:8443", "example.co.uk:53"} {
+		for _, network := range []string{"tcp", "udp"} {
+			if got := p.connectionCandidates(ctx, network, M.ParseSocksaddr(target))[0].Tag(); got != choice {
+				t.Fatalf("%s/%s changed selection", target, network)
+			}
+		}
+	}
+	p.group.outbounds[0], p.group.outbounds[2] = p.group.outbounds[2], p.group.outbounds[0]
+	if got := p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr("a.example.co.uk:443"))[0].Tag(); got != choice {
+		t.Fatal("reordering shuffled destinations")
+	}
+	counts := map[string]int{}
+	for i := 0; i < 1024; i++ {
+		counts[p.connectionCandidates(ctx, "tcp", M.ParseSocksaddr(fmt.Sprintf("site-%d.example:443", i)))[0].Tag()]++
+	}
+	for _, tag := range []string{"A", "B", "C"} {
+		if counts[tag] < 200 {
+			t.Fatalf("imbalanced sample: %v", counts)
+		}
+	}
+	if p.Now() != "" {
+		t.Fatal("a load-balancer must not claim one current node for every destination")
+	}
+	if RealTag(nil, p) != "balanced" {
+		t.Fatal("a nested load-balancer lost its health-test target")
+	}
+}
+
+func TestStickySessionsRetainSelectionUntilExpiryOrFailureAndRemainBounded(t *testing.T) {
+	p := balanceFixture(t, "sticky-sessions")
+	destination := M.ParseSocksaddr("video.example.com:443")
+	ctx := adapter.WithContext(context.Background(), &adapter.InboundContext{Source: M.ParseSocksaddr("192.168.1.10:1234")})
+	other := adapter.WithContext(context.Background(), &adapter.InboundContext{Source: M.ParseSocksaddr("192.168.1.11:1234")})
+	if balanceKey(ctx, destination, true) == balanceKey(other, destination, true) {
+		t.Fatal("source address is absent from sticky key")
+	}
+	initial := p.connectionCandidates(ctx, "tcp", destination)[0].Tag()
+	retained := "A"
+	if initial == retained {
+		retained = "B"
+	}
+	p.rememberConnection(ctx, destination, retained)
+	if got := p.connectionCandidates(ctx, "udp", destination)[0].Tag(); got != retained {
+		t.Fatal("an established selection was not retained for the same source and site")
+	}
+	p.balance.access.Lock()
+	expired, _ := p.balance.sessions.Load(balanceKey(ctx, destination, true))
+	p.balance.sessions.StoreWithExpire(balanceKey(ctx, destination, true), expired, time.Now().Add(-time.Second))
+	p.balance.access.Unlock()
+	if got := p.connectionCandidates(ctx, "tcp", destination)[0].Tag(); got != initial {
+		t.Fatal("expired sticky entry remained active")
+	}
+	p.rememberConnection(ctx, destination, retained)
+	p.group.history.DeleteURLTestHistory(retained)
+	if got := p.connectionCandidates(ctx, "tcp", destination)[0].Tag(); got == retained {
+		t.Fatal("sticky entry pinned a failed node")
+	}
+	for i := 0; i < maxStickySessions+100; i++ {
+		p.rememberConnection(ctx, M.ParseSocksaddr(fmt.Sprintf("site-%d.example:443", i)), "A")
+	}
+	p.balance.access.Lock()
+	count := 0
+	p.balance.sessions.Range(func(string, string) { count++ })
+	p.balance.access.Unlock()
+	if count > maxStickySessions {
+		t.Fatal("unbounded sticky cache")
+	}
+}
+
+func TestLoadBalanceConcurrencyRoundRobinAndAllFailed(t *testing.T) {
+	for _, strategy := range []string{"consistent-hashing", "sticky-sessions", "round-robin"} {
+		p := balanceFixture(t, strategy)
+		var workers sync.WaitGroup
+		for i := 0; i < 8; i++ {
+			workers.Add(1)
+			go func(i int) {
+				defer workers.Done()
+				ctx := context.Background()
