+func TestFallbackRetriesBeforePayloadAndKeepsEstablishedConnectionOnRecovery(t *testing.T) {
+	var attempts []string
+	client, peer := net.Pipe()
+	defer peer.Close()
+	primary := &fallbackDialTestOutbound{selectionTestOutbound{name: "primary"}, func(context.Context) (net.Conn, error) {
+		attempts = append(attempts, "primary")
+		return nil, errors.New("offline")
+	}}
+	backup := &fallbackDialTestOutbound{selectionTestOutbound{name: "backup"}, func(context.Context) (net.Conn, error) {
+		attempts = append(attempts, "backup")
+		return client, nil
+	}}
+	history := urltest.NewHistoryStorage()
+	for _, name := range []string{"primary", "backup"} {
+		history.StoreURLTestHistory(name, &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	}
+	g := &URLTestGroup{ordered: true, history: history, outbounds: []adapter.Outbound{primary, backup}, interruptGroup: interrupt.NewGroup()}
+	g.probed.Store(true)
+	proxy := &URLTest{ordered: true, group: g, logger: log.NewNOPFactory().Logger()}
+	ctx := interrupt.ContextWithIsExternalConnection(context.Background())
+	conn, err := proxy.DialContext(ctx, "tcp", M.ParseSocksaddr("192.0.2.1:80"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if len(attempts) != 2 || attempts[0] != "primary" || attempts[1] != "backup" {
+		t.Fatalf("unexpected order: %v", attempts)
+	}
+	g.performUpdateCheck()
+	if proxy.Now() != "backup" {
+		t.Fatal("failed primary remained selected")
+	}
+	history.StoreURLTestHistory("primary", &adapter.URLTestHistory{Time: time.Now(), Delay: 300})
+	g.performUpdateCheck()
+	if proxy.Now() != "primary" {
+		t.Fatal("priority did not recover")
+	}
+	if err := conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { _, err := peer.Write([]byte("alive")); done <- err }()
+	body := make([]byte, 5)
+	if _, err := io.ReadFull(conn, body); err != nil {
+		t.Fatal("existing stream interrupted:", err)
+	}
+	if string(body) != "alive" {
+		t.Fatal("existing stream changed")
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
