+type urlTestSelection struct {
+	tcp adapter.Outbound
+	udp adapter.Outbound
+}
+
+func (g *URLTestGroup) selected(network string) adapter.Outbound {
+	selection := g.selection.Load()
+	if selection == nil {
+		return nil
+	}
+	switch network {
+	case N.NetworkUDP:
+		return selection.udp
+	case N.NetworkTCP:
+		return selection.tcp
+	default:
+		return nil
+	}
+}
