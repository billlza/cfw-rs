diff --git a/experimental/libbox/profile_probe.go b/experimental/libbox/profile_probe.go
new file mode 100644
index 0000000000000000000000000000000000000000..0d50e010b078eb1a3c71cab4ee3805b5a2c13868
--- /dev/null
+++ b/experimental/libbox/profile_probe.go
@@ -0,0 +1,171 @@
+package libbox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"sync"
+	"time"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/option"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Profile probes originate application requests only: no inbounds, controller,
+// system interface, routing policy, persistent cache, or background URL tests.
+// One bounded batch may run per process. Its Box is always closed before reply.
+var profileProbeSlot = make(chan struct{}, 1)
+
+type profileProbeResult struct {
+	Name      string  `json:"name"`
+	Delay     *uint32 `json:"delay"`
+	ErrorKind *string `json:"error_kind"`
+}
+
+func profileProbeContext() context.Context {
+	// Do not read libbox Setup globals: a profile probe may overlap the first
+	// connected runtime's setup, and it never needs persistent directories.
+	return box.Context(context.Background(), include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry(), include.CertificateProviderRegistry())
+}
+
+func TestProfileProxies(configuration, namesJSON string, timeoutMS int32) (string, error) {
+	return TestProfileProxiesWithTarget(configuration, namesJSON, timeoutMS, "", "")
+}
+
+func TestProfileProxiesWithTarget(configuration, namesJSON string, timeoutMS int32, targetURL, expectedStatus string) (string, error) {
+	if err := urltest.ValidateProbeTarget(targetURL); err != nil {
+		return "", err
+	}
+	if _, err := urltest.ParseExpectedStatus(expectedStatus); err != nil {
+		return "", err
+	}
+	select {
+	case profileProbeSlot <- struct{}{}:
+		defer func() { <-profileProbeSlot }()
+	default:
+		return "", errors.New("profile probe already running")
+	}
+	if len(configuration) == 0 || len(configuration) > 4*1024*1024 || len(namesJSON) > 32768 || timeoutMS < 100 || timeoutMS > 10000 {
+		return "", errors.New("invalid profile probe bounds")
+	}
+	var names []string
+	if err := json.Unmarshal([]byte(namesJSON), &names); err != nil || len(names) == 0 || len(names) > 32 {
+		return "", errors.New("invalid profile probe targets")
+	}
+	seen := make(map[string]bool, len(names))
+	for _, name := range names {
+		if name == "" || len(name) > 512 || seen[name] {
+			return "", errors.New("invalid profile probe target")
+		}
+		seen[name] = true
+	}
+	ctx, cancel := context.WithTimeout(profileProbeContext(), time.Duration(timeoutMS)*time.Millisecond)
+	defer cancel()
+	options, err := profileProbeOptions(ctx, configuration)
+	if err != nil {
+		return "", err
+	}
+	instance, err := box.New(box.Options{Context: ctx, Options: options})
+	if err != nil {
+		return "", errors.New("profile probe configuration rejected")
+	}
+	return runProfileProbeWithTarget(ctx, instance, names, targetURL, expectedStatus)
+}
+
+func profileProbeOptions(ctx context.Context, configuration string) (option.Options, error) {
+	var root map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(configuration), &root); err != nil {
+		return option.Options{}, errors.New("invalid profile probe document")
+	}
+	for key := range root {
+		if key != "outbounds" && key != "endpoints" && key != "dns" && key != "route" {
+			return option.Options{}, errors.New("unsupported profile probe section")
+		}
+	}
+	var route map[string]json.RawMessage
+	if data, ok := root["route"]; ok {
+		if err := json.Unmarshal(data, &route); err != nil {
+			return option.Options{}, errors.New("invalid profile probe resolver")
+		}
+		for key := range route {
+			if key != "default_domain_resolver" {
+				return option.Options{}, errors.New("profile probe cannot configure routes")
+			}
+		}
+	}
+	options, err := parseConfig(ctx, configuration)
+	if err != nil {
+		return option.Options{}, errors.New("profile probe configuration rejected")
+	}
+	for _, endpoint := range options.Endpoints {
+		wireguard, ok := endpoint.Options.(*option.WireGuardEndpointOptions)
+		if endpoint.Type != "wireguard" || !ok || wireguard.System || wireguard.ListenPort != 0 {
+			return option.Options{}, errors.New("profile probe requires a userspace client endpoint")
+		}
+	}
+	for _, outbound := range options.Outbounds {
+		switch outbound.Type {
+		case C.TypeURLTest, C.TypeFallback, C.TypeLoadBalance:
+			return option.Options{}, errors.New("profile probe cannot start background tests")
+		case C.TypeBridge, C.TypeTor:
+			return option.Options{}, errors.New("profile probe cannot start platform services")
+		}
+	}
+	options.Log = &option.LogOptions{Disabled: true}
+	return options, nil
+}
+
+func runProfileProbe(ctx context.Context, instance *box.Box, names []string) (string, error) {
+	return runProfileProbeWithTarget(ctx, instance, names, "", "")
+}
+
+func runProfileProbeWithTarget(ctx context.Context, instance *box.Box, names []string, targetURL, expectedStatus string) (response string, err error) {
+	defer func() {
+		if closeErr := instance.Close(); closeErr != nil {
+			response = ""
+			err = errors.Join(err, errors.New("profile probe cleanup failed"))
+		}
+	}()
+	if startErr := instance.Start(); startErr != nil {
+		return "", errors.New("profile probe startup failed")
+	}
+	results := make([]profileProbeResult, len(names))
+	var workers sync.WaitGroup
+	for index, name := range names {
+		workers.Go(func() {
+			result := profileProbeResult{Name: name}
+			var dialer N.Dialer
+			if outbound, ok := instance.Outbound().Outbound(name); ok {
+				dialer = outbound
+			} else if endpoint, ok := instance.Endpoint().Get(name); ok {
+				dialer = endpoint
+			}
+			if dialer == nil {
+				kind := "not_found"
+				result.ErrorKind = &kind
+			} else {
+				delay, probeErr := urltest.URLTestWithStatus(ctx, targetURL, expectedStatus, dialer)
+				if probeErr != nil {
+					kind := "probe_failed"
+					var networkError net.Error
+					if errors.Is(probeErr, context.DeadlineExceeded) || errors.As(probeErr, &networkError) && networkError.Timeout() {
+						kind = "timeout"
+					}
+					result.ErrorKind = &kind
+				} else {
+					value := max(uint32(delay), 1)
+					result.Delay = &value
+				}
+			}
+			results[index] = result
+		})
+	}
+	workers.Wait()
+	data, err := json.Marshal(results)
+	return string(data), err
+}
