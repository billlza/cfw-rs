+	"sync"
+	"testing"
+	"time"
+)
+
+func TestURLTestPreservesExplicitZeroTolerance(t *testing.T) {
+	for _, test := range []struct {
+		input    string
+		expected uint16
+	}{
+		{input: "{\"outbounds\":[\"node\"]}", expected: 50},
+		{input: "{\"outbounds\":[\"node\"],\"tolerance\":0}", expected: 0},
+		{input: "{\"outbounds\":[\"node\"],\"tolerance\":150}", expected: 150},
+	} {
+		var options option.URLTestOutboundOptions
+		if err := json.Unmarshal([]byte(test.input), &options); err != nil {
+			t.Fatal(err)
+		}
+		outbound, err := NewURLTest(context.Background(), nil, nil, "auto", options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		settings := outbound.(*URLTest)
+		group, err := NewURLTestGroup(service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage()), nil, nil, nil, "https://example.com", time.Minute, settings.tolerance, 2*time.Minute, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if group.tolerance != test.expected {
+			t.Fatalf("tolerance=%d, want %d", group.tolerance, test.expected)
+		}
+	}
+}
+
+func TestURLTestToleranceCannotOverflowToPreferASlowerNode(t *testing.T) {
+	history := urltest.NewHistoryStorage()
+	history.StoreURLTestHistory("fast", &adapter.URLTestHistory{Time: time.Now(), Delay: 1000})
+	history.StoreURLTestHistory("slow", &adapter.URLTestHistory{Time: time.Now(), Delay: 65500})
+	g := &URLTestGroup{history: history, tolerance: 100, outbounds: []adapter.Outbound{selectionTestOutbound{name: "fast"}, selectionTestOutbound{name: "slow"}}}
+	selected, ok := g.Select("tcp")
+	if !ok || selected.Tag() != "fast" {
+		t.Fatal("latency tolerance overflow selected the slower node")
+	}
+}
+
+type selectionTestOutbound struct {
+	adapter.Outbound
+	name string
+}
+
+func (s selectionTestOutbound) Tag() string       { return s.name }
+func (s selectionTestOutbound) Network() []string { return []string{"tcp", "udp"} }
+
+func TestURLTestConcurrentSelectionPublication(t *testing.T) {
+	history := urltest.NewHistoryStorage()
+	group := &URLTestGroup{history: history, outbounds: []adapter.Outbound{selectionTestOutbound{name: "A"}, selectionTestOutbound{name: "B"}}, interruptGroup: interrupt.NewGroup()}
+	proxy := &URLTest{group: group}
+	var readers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for j := 0; j < 10000; j++ {
+				name := proxy.Now()
+				if name != "" && name != "A" && name != "B" {
+					t.Error("torn selection")
+				}
+				group.Select("tcp")
+				group.Select("udp")
+			}
+		}()
+	}
+	for i := 0; i < 10000; i++ {
+		history.StoreURLTestHistory("A", &adapter.URLTestHistory{Time: time.Now(), Delay: uint16(10 + i%2*20)})
+		history.StoreURLTestHistory("B", &adapter.URLTestHistory{Time: time.Now(), Delay: 20})
+		group.performUpdateCheck()
+	}
+	readers.Wait()
+}
