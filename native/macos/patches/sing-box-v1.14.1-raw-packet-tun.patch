@@ -0,0 +1,91 @@
+package libbox
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/control"
+	"github.com/sagernet/sing/common/logger"
+)
+
+type networkChangeFixture struct {
+	adapter.NetworkManager
+	finder  *control.DefaultInterfaceFinder
+	current control.Interface
+}
+
+func (m *networkChangeFixture) UpdateInterfaces() error {
+	m.finder.UpdateInterfaces([]control.Interface{m.current})
+	return nil
+}
+
+func (m *networkChangeFixture) InterfaceFinder() control.InterfaceFinder { return m.finder }
+
+func TestSameWiFiInterfaceNotifiesOnHotspotSubnetChange(t *testing.T) {
+	network := &networkChangeFixture{
+		finder: control.NewDefaultInterfaceFinder(),
+		current: control.Interface{Name: "en0", Index: 7, MTU: 1500, Flags: net.FlagUp,
+			Addresses: []netip.Prefix{netip.MustParsePrefix("192.168.0.103/24")}},
+	}
+	monitor := &platformDefaultInterfaceMonitor{
+		platformInterfaceWrapper: &platformInterfaceWrapper{networkManager: network},
+		logger:                   logger.NOP(),
+	}
+	var observed []string
+	monitor.RegisterCallback(func(current *control.Interface, _ int) {
+		if current == nil {
+			observed = append(observed, "unavailable")
+			return
+		}
+		observed = append(observed, current.Addresses[0].String())
+	})
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	network.current.Addresses = []netip.Prefix{netip.MustParsePrefix("172.20.10.2/28")}
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	if len(observed) != 2 || observed[1] != "172.20.10.2/28" {
+		t.Fatalf("network handoff was lost behind the unchanged en0 identity: %v", observed)
+	}
+	monitor.UpdateDefaultInterface("en0", 7, true, false)
+	monitor.UpdateDefaultInterface("en0", 7, true, false)
+	monitor.UpdateDefaultInterface("", -1, false, false)
+	monitor.UpdateDefaultInterface("", -1, false, false)
+	monitor.UpdateDefaultInterface("en0", 7, true, false)
+	if len(observed) != 5 || observed[3] != "unavailable" {
+		t.Fatalf("cost, loss or recovery notification was incorrect: %v", observed)
+	}
+	network.current.Addresses = []netip.Prefix{netip.MustParsePrefix("172.20.10.3/28")}
+	monitor.UpdateDefaultInterface("en0", 7, true, false)
+	if len(observed) != 6 {
+		t.Fatalf("changed IPv4 lease did not invalidate existing connections: %v", observed)
+	}
+}
+
+func TestPrivacyAddressRotationDoesNotResetSameNetwork(t *testing.T) {
+	network := &networkChangeFixture{
+		finder: control.NewDefaultInterfaceFinder(),
+		current: control.Interface{Name: "en0", Index: 7, MTU: 1500, Flags: net.FlagUp,
+			Addresses: []netip.Prefix{netip.MustParsePrefix("2001:db8:1::1/64")}},
+	}
+	monitor := &platformDefaultInterfaceMonitor{
+		platformInterfaceWrapper: &platformInterfaceWrapper{networkManager: network},
+		logger:                   logger.NOP(),
+	}
+	updates := 0
+	monitor.RegisterCallback(func(_ *control.Interface, _ int) { updates++ })
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	network.current.Addresses = []netip.Prefix{
+		netip.MustParsePrefix("2001:db8:1::2/64"), netip.MustParsePrefix("2001:db8:1::3/64"),
+	}
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	if updates != 1 {
+		t.Fatalf("privacy address rotation reset the network %d times", updates)
+	}
+	network.current.Addresses = []netip.Prefix{netip.MustParsePrefix("2001:db8:2::1/64")}
+	monitor.UpdateDefaultInterface("en0", 7, false, false)
+	if updates != 2 {
+		t.Fatalf("changed IPv6 network did not trigger a reset: %d", updates)
+	}
+}
