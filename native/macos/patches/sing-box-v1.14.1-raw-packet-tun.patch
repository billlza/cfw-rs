+//go:build !darwin
+
+package libbox
+
+import (
+	"fmt"
+	"os"
+
+	tun "github.com/sagernet/sing-tun"
+)
+
+func newRawPacketTun(fd int32, _ *tun.Options) (tun.Tun, error) {
+	if fd >= 0 {
+		if file := os.NewFile(uintptr(fd), rawPacketTunName); file != nil {
+			_ = file.Close()
+		}
+	}
+	return nil, fmt.Errorf("%w", errRawPacketTunUnsupported)
+}
