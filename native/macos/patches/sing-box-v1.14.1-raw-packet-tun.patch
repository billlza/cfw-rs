+// Moving between Wi-Fi networks keeps the same interface name and index.
+// Compare routing-relevant network state so DNS transports and connections are
+// reset for a new subnet. IPv6 privacy-address rotation within one prefix does
+// not turn into a reconnect loop.
+type interfaceNetworkIdentity struct {
+	name                   string
+	index, mtu             int
+	flags                  net.Flags
+	networks               string
+	expensive, constrained bool
+}
+
+func networkIdentity(network *control.Interface, expensive, constrained bool) interfaceNetworkIdentity {
+	prefixes := make([]string, 0, len(network.Addresses))
+	for _, prefix := range network.Addresses {
+		if prefix.IsValid() {
+			if prefix.Addr().Is4() {
+				// A changed IPv4 lease invalidates existing source addresses even
+				// when both leases belong to the same subnet.
+				prefixes = append(prefixes, prefix.String())
+			} else {
+				prefixes = append(prefixes, prefix.Masked().String())
+			}
+		}
+	}
+	slices.Sort(prefixes)
+	prefixes = slices.Compact(prefixes)
+	return interfaceNetworkIdentity{
+		name: network.Name, index: network.Index, mtu: network.MTU, flags: network.Flags,
+		networks: strings.Join(prefixes, ","), expensive: expensive, constrained: constrained,
+	}
+}
