@@ -231,6 +250,52 @@ func (s *CommandServer) CloseService() error {
 	return s.StartedService.CloseService()
 }
 
+const (
+	RuntimeEndpointConflictMixed      int32 = int32(adapter.EndpointConflictMixed)
+	RuntimeEndpointConflictController int32 = int32(adapter.EndpointConflictController)
+)
+
+type RuntimeStartConflict struct {
+	Kind int32
+	Port int32
+}
+
+// StartOrReloadServiceReportingConflict preserves every ordinary start error.
+// Only an exact product listener EADDRINUSE is converted to structured data so
+// the embedding application can retry after its own cleanup and Off proof.
+func (s *CommandServer) StartOrReloadServiceReportingConflict(configContent string, options *OverrideOptions) (*RuntimeStartConflict, error) {
+	err := s.StartOrReloadService(configContent, options)
+	if err == nil {
+		return nil, nil
+	}
+	conflict := runtimeStartConflict(err)
+	if conflict == nil {
+		return nil, err
+	}
+	return conflict, nil
+}
+
+func runtimeStartConflict(err error) *RuntimeStartConflict {
+	if containsMultiError(err) || !errors.Is(err, syscall.EADDRINUSE) {
+		return nil
+	}
+	role, port, isConflict := adapter.EndpointConflictFromError(err)
+	if !isConflict || port == 0 || (role != adapter.EndpointConflictMixed && role != adapter.EndpointConflictController) {
+		return nil
+	}
+	return &RuntimeStartConflict{Kind: int32(role), Port: int32(port)}
+}
+
+func containsMultiError(err error) bool {
+	for err != nil {
+		if _, ok := err.(interface{ Unwrap() []error }); ok {
+			return true
+		}
+		err = errors.Unwrap(err)
+	}
+	return false
+}
+
 func (s *CommandServer) WriteMessage(level int32, message string) {
 	s.StartedService.WriteMessage(log.Level(level), message)
 }
