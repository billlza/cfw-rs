diff --git a/daemon/started_service_test.go b/daemon/started_service_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..87038bf836fc6f830caecafee22004e4c8b42577
--- /dev/null
+++ b/daemon/started_service_test.go
@@ -0,0 +1,101 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter/certificate"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	serviceRegistry "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/dns/transport/local"
+)
+
+func TestStartedServiceRuntimeStatusAndFatalCleanup(t *testing.T) {
+	service := NewStartedService(ServiceOptions{Context: context.Background()})
+	defer service.Close()
+
+	status, message := service.RuntimeStatus()
+	if status != ServiceStatus_IDLE || message != "" {
+		t.Fatalf("unexpected initial status: %v %q", status, message)
+	}
+
+	service.SetError(errors.New("test failure"))
+	status, message = service.RuntimeStatus()
+	if status != ServiceStatus_FATAL || message != "test failure" {
+		t.Fatalf("unexpected fatal status: %v %q", status, message)
+	}
+
+	if err := service.CloseService(); err != nil {
+		t.Fatalf("clean fatal service: %v", err)
+	}
+	status, message = service.RuntimeStatus()
+	if status != ServiceStatus_IDLE || message != "" {
+		t.Fatalf("unexpected cleaned status: %v %q", status, message)
+	}
+}
+
+func TestCloseServiceRetainsInstanceWhenCleanupFails(t *testing.T) {
+	startedService := NewStartedService(ServiceOptions{
+		Context: testServiceContext(),
+	})
+	defer startedService.Close()
+	instance := newClosedTestInstance(t, startedService)
+	startedService.serviceAccess.Lock()
+	startedService.instance = instance
+	startedService.updateStatus(ServiceStatus_STARTED)
+	startedService.serviceAccess.Unlock()
+
+	if err := startedService.CloseService(); err == nil {
+		t.Fatal("expected cleanup failure")
+	}
+	startedService.serviceAccess.RLock()
+	defer startedService.serviceAccess.RUnlock()
+	if startedService.instance != instance || startedService.serviceStatus.Status != ServiceStatus_FATAL {
+		t.Fatal("failed cleanup released instance ownership or reported a false idle state")
+	}
+}
+
+func TestReloadRetainsPreviousInstanceWhenCleanupFails(t *testing.T) {
+	startedService := NewStartedService(ServiceOptions{
+		Context: testServiceContext(),
+	})
+	defer startedService.Close()
+	instance := newClosedTestInstance(t, startedService)
+	startedService.serviceAccess.Lock()
+	startedService.instance = instance
+	startedService.updateStatus(ServiceStatus_STARTED)
+	startedService.serviceAccess.Unlock()
+
+	if err := startedService.StartOrReloadService(context.Background(), "{}", nil); err == nil {
+		t.Fatal("expected previous-instance cleanup failure")
+	}
+	startedService.serviceAccess.RLock()
+	defer startedService.serviceAccess.RUnlock()
+	if startedService.instance != instance || startedService.serviceStatus.Status != ServiceStatus_FATAL {
+		t.Fatal("failed replacement cleanup released previous instance ownership")
+	}
+}
+
+func newClosedTestInstance(t *testing.T, service *StartedService) *Instance {
+	t.Helper()
+	instance, err := service.newInstance(context.Background(), "{}", nil)
+	if err != nil {
+		t.Fatalf("create test instance: %v", err)
+	}
+	if err := instance.Close(); err != nil {
+		t.Fatalf("close test instance: %v", err)
+	}
+	return instance
+}
+
+func testServiceContext() context.Context {
+	dnsRegistry := dns.NewTransportRegistry()
+	local.RegisterTransport(dnsRegistry)
+	return box.Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(),
+		endpoint.NewRegistry(), dnsRegistry, serviceRegistry.NewRegistry(), certificate.NewRegistry())
+}
