index 0000000000000000000000000000000000000000..62b60b74db427d0e609d9086ade0a4f337c3a641
--- /dev/null
+++ b/experimental/libbox/config_privacy_test.go
@@ -0,0 +1,72 @@
+package libbox
+
+import (
+	"bytes"
+	"context"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/sagernet/sing-box/daemon"
+	"github.com/sagernet/sing/service"
+)
+
+func TestRejectedRuntimeConfigurationIsNeverPersisted(t *testing.T) {
+	base := t.TempDir()
+	previous := sBasePath
+	sBasePath = base
+	t.Cleanup(func() { sBasePath = previous })
+	ctx := service.ContextWithDefaultRegistry(context.Background())
+	started := daemon.NewStartedService(daemon.ServiceOptions{Context: ctx})
+	t.Cleanup(started.Close)
+	server := &CommandServer{StartedService: started, ctx: ctx}
+	canary := "cfm-test-ephemeral-runtime-credential"
+	err := server.StartOrReloadService(`{"password":"`+canary+`",`, &OverrideOptions{})
+	if err == nil {
+		t.Fatal("malformed runtime configuration was accepted")
+	}
+	assertReportExcludesCanary(t, base, canary)
+}
+
+func TestCrashArchiveDoesNotCopyLegacyConfiguration(t *testing.T) {
+	base := t.TempDir()
+	previous := sBasePath
+	sBasePath = base
+	t.Cleanup(func() { sBasePath = previous })
+	canary := "cfm-test-legacy-configuration-credential"
+	if err := os.WriteFile(filepath.Join(base, "configuration.json"), []byte(canary), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	crash := filepath.Join(base, "crash.log")
+	if err := os.WriteFile(crash, []byte("test crash diagnostic"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	reports := filepath.Join(base, "reports")
+	archiveCrashReport(crash, reports)
+	assertReportExcludesCanary(t, reports, canary)
+	logs, err := filepath.Glob(filepath.Join(reports, "*", "go.log"))
+	if err != nil || len(logs) != 1 {
+		t.Fatalf("crash diagnostic was not preserved: %v %v", logs, err)
+	}
+}
+
+func assertReportExcludesCanary(t *testing.T, root, canary string) {
+	t.Helper()
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil || entry.IsDir() {
+			return err
+		}
+		content, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if bytes.Contains(content, []byte(canary)) {
+			t.Errorf("runtime credential persisted in %s", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
