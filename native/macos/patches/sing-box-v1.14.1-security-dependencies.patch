index 0000000000000000000000000000000000000000..d70a2f7e6561b3ca5566edccde5e524fe04e1339
--- /dev/null
+++ b/common/tls/pinning.go
@@ -0,0 +1,65 @@
+package tls
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"crypto/x509"
+	"errors"
+	"time"
+)
+
+// An explicitly pinned leaf key/certificate is its own trust anchor. It must
+// still be current and identify the configured server. No CA fallback or
+// insecure retry occurs after a pin mismatch.
+func verifyPinnedServer(certPins, keyPins, rawCerts [][]byte, name string, clock func() time.Time) error {
+	if len(rawCerts) == 0 || name == "" || (len(certPins) > 0 && len(keyPins) > 0) {
+		return errors.New("invalid pinned server certificate input")
+	}
+	pins := keyPins
+	if len(certPins) > 0 {
+		pins = certPins
+	}
+	if len(pins) == 0 || len(pins) > 8 {
+		return errors.New("invalid TLS pin count")
+	}
+	for _, pin := range pins {
+		if len(pin) != sha256.Size {
+			return errors.New("invalid TLS pin size")
+		}
+	}
+	leaf, err := x509.ParseCertificate(rawCerts[0])
+	if err != nil {
+		return errors.New("invalid leaf certificate")
+	}
+	now := time.Now()
+	if clock != nil {
+		now = clock()
+	}
+	if now.Before(leaf.NotBefore) || now.After(leaf.NotAfter) {
+		return errors.New("pinned certificate is outside its validity period")
+	}
+	if err = leaf.VerifyHostname(name); err != nil {
+		return errors.New("pinned certificate does not identify the configured server")
+	}
+	if len(leaf.ExtKeyUsage) > 0 {
+		permitsServer := false
+		for _, usage := range leaf.ExtKeyUsage {
+			permitsServer = permitsServer || usage == x509.ExtKeyUsageAny || usage == x509.ExtKeyUsageServerAuth
+		}
+		if !permitsServer {
+			return errors.New("pinned certificate does not permit server authentication")
+		}
+	}
+	var hash [32]byte
+	if len(certPins) > 0 {
+		hash = sha256.Sum256(rawCerts[0])
+	} else {
+		hash = sha256.Sum256(leaf.RawSubjectPublicKeyInfo)
+	}
+	for _, pin := range pins {
+		if bytes.Equal(hash[:], pin) {
+			return nil
+		}
+	}
+	return errors.New("remote certificate does not match a configured TLS pin")
+}
