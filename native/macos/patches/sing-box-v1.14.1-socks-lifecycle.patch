+func TestSOCKSCancelledAttemptDoesNotCloseConcurrentSession(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			f := newSocksFixture(t, "request")
+			f.stallFirst = true
+			f.start()
+			outbound := fixtureOutbound(t, f, time.Second, context.Background(), "", "")
+			first, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				conn, err := outbound.DialContext(first, network, M.ParseSocksaddr("203.0.113.1:443"))
+				if conn != nil {
+					conn.Close()
+				}
+				done <- err
+			}()
+			select {
+			case <-f.reached:
+			case <-time.After(time.Second):
+				t.Fatal("first handshake did not reach request")
+			}
+			conn, err := outbound.DialContext(context.Background(), network, M.ParseSocksaddr("203.0.113.1:443"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			cancel()
+			select {
+			case err = <-done:
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("expected cancellation, got %v", err)
+				}
+			case <-time.After(500 * time.Millisecond):
+				t.Fatal("first handshake did not stop")
+			}
+			if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			payload := []byte("independent-session")
+			if _, err = conn.Write(payload); err != nil {
+				t.Fatal(err)
+			}
+			got := make([]byte, 4096)
+			var count int
+			if network == "tcp" {
+				count, err = io.ReadFull(conn, got[:len(payload)])
+			} else {
+				count, err = conn.Read(got)
+			}
+			if err != nil {
+				t.Fatalf("cancellation closed an unrelated session: %v", err)
+			}
+			if !bytes.Equal(got[:count], payload) {
+				t.Fatal("concurrent session payload changed")
+			}
+		})
+	}
+}
+
+func TestSOCKSListenPacketPreservesDatagramsAfterSetup(t *testing.T) {
+	f := newSocksFixture(t, "")
+	f.bind = "::"
+	f.start()
+	outbound := fixtureOutbound(t, f, 100*time.Millisecond, context.Background(), "", "")
+	ctx, cancel := context.WithCancel(context.Background())
+	destination := M.ParseSocksaddr("203.0.113.1:443")
+	conn, err := outbound.ListenPacket(ctx, destination)
+	cancel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	time.Sleep(120 * time.Millisecond)
+	if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	for _, size := range []int{1, 512, 1232, 2048} {
+		payload := bytes.Repeat([]byte{byte(size % 251)}, size)
+		if _, err = conn.WriteTo(payload, destination.UDPAddr()); err != nil {
+			t.Fatal(err)
+		}
+		received := make([]byte, 4096)
+		count, peer, err := conn.ReadFrom(received)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(payload, received[:count]) || peer.String() != destination.String() {
+			t.Fatalf("datagram size %d or its destination changed", size)
+		}
+	}
+}
+
+func TestSOCKSAuthenticationFailureClosesControl(t *testing.T) {
+	f := newSocksFixture(t, "")
+	f.rejectAuth = true
+	f.start()
+	outbound := fixtureOutbound(t, f, time.Second, context.Background(), "", "")
+	conn, err := outbound.DialContext(context.Background(), "udp", M.ParseSocksaddr("203.0.113.1:53"))
+	if conn != nil {
+		conn.Close()
+	}
+	if err == nil || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("authentication failure was lost: %v", err)
+	}
+	select {
+	case <-f.closed:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("failed authentication retained its control socket")
+	}
+	if f.count.Load() != 1 {
+		t.Fatal("failed authentication was retried")
+	}
+}
diff --git a/cmd/cfm-build-workspace/main.go b/cmd/cfm-build-workspace/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..9f01d6ca2e8fb9eac95961da1555ddd5a550130d
--- /dev/null
+++ b/cmd/cfm-build-workspace/main.go
@@ -0,0 +1,188 @@
+// Build an isolated workspace with the source-bound sing v0.9.4 packet-address
+// correction. The original source and checksum-verified module cache stay intact.
+package main
+
+import (
+	"crypto/sha256"
+	"errors"
+	"flag"
+	"fmt"
+	"go/format"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+type sourceEdit struct{ before, after string }
+type sourcePatch struct {
+	path, digest string
+	edits        []sourceEdit
+}
+
+var patches = []sourcePatch{
+	{
+		path: "common/bufio/bind.go", digest: "581bcc7042231a0d4e76da58372bde94ad59d59e460b6f84200b193976d4bc9e",
+		edits: []sourceEdit{
+			{"\"net\"", "\"net\"\n\t\"sync\""},
+			{"remoteAddr M.Socksaddr", "remoteAddr M.Socksaddr\n\tremoteAddrAccess sync.RWMutex"},
+			{"c.remoteAddr = M.SocksaddrFromNet(addr)", "c.setRemoteAddr(M.SocksaddrFromNet(addr))"},
+			{"c.remoteAddr = destination", "c.setRemoteAddr(destination)"},
+			{"c.remoteAddr.UDPAddr()", "c.remoteAddress().UDPAddr()"},
+			{"WritePacket(buffer, c.remoteAddr)", "WritePacket(buffer, c.remoteAddress())"},
+			{"return c.remoteAddr", "return c.remoteAddress()"},
+			{"func (c *serverPacketConn) Read(p []byte)", `// Copy the address under a short lock; never hold it across blocking I/O.
+func (c *serverPacketConn) setRemoteAddr(addr M.Socksaddr) {
+	c.remoteAddrAccess.Lock()
+	c.remoteAddr = addr
+	c.remoteAddrAccess.Unlock()
+}
+
+func (c *serverPacketConn) remoteAddress() M.Socksaddr {
+	c.remoteAddrAccess.RLock()
+	defer c.remoteAddrAccess.RUnlock()
+	return c.remoteAddr
+}
+
+func (c *serverPacketConn) Read(p []byte)`},
+		},
+	},
+	{
+		path: "common/bufio/bind_wait.go", digest: "ee1581ff0a07d1858f5edafc5c767e9cc884a2462cf350e55ffacfa65dd59203",
+		edits: []sourceEdit{{"w.remoteAddr = destination", "w.setRemoteAddr(destination)"}},
+	},
+}
+
+func rewrite(patch sourcePatch, input []byte) ([]byte, error) {
+	if fmt.Sprintf("%x", sha256.Sum256(input)) != patch.digest {
+		return nil, fmt.Errorf("%s: sing v0.9.4 source checksum mismatch", patch.path)
+	}
+	source := string(input)
+	for _, edit := range patch.edits {
+		if strings.Count(source, edit.before) != 1 {
+			return nil, fmt.Errorf("%s: source edit is not unique", patch.path)
+		}
+		source = strings.Replace(source, edit.before, edit.after, 1)
+	}
+	return format.Source([]byte(source))
+}
+
+func copySources(source, destination string) error {
+	var copied int64
+	return filepath.WalkDir(source, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		relative, err := filepath.Rel(source, path)
+		if err != nil {
+			return err
+		}
+		if relative == ".git" {
+			return filepath.SkipDir
+		}
+		target := filepath.Join(destination, relative)
+		if entry.IsDir() {
+			return os.MkdirAll(target, 0o700)
+		}
+		metadata, err := entry.Info()
+		if err != nil || !metadata.Mode().IsRegular() || metadata.Size() > 16<<20 {
+			return fmt.Errorf("refuse nonregular or oversized build input: %s", relative)
+		}
+		copied += metadata.Size()
+		if copied > 256<<20 {
+			return errors.New("build source copy exceeds 256 MiB")
+		}
+		content, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		return os.WriteFile(target, content, 0o600|metadata.Mode().Perm()&0o111)
+	})
+}
+
+func prepare(sourceRoot, moduleRoot, output string) (workspace string, resultErr error) {
+	if !filepath.IsAbs(sourceRoot) || !filepath.IsAbs(moduleRoot) || !filepath.IsAbs(output) {
+		return "", errors.New("source, module and output paths must be absolute")
+	}
+	realSource, err := filepath.EvalSymlinks(sourceRoot)
+	if err != nil || realSource != filepath.Clean(sourceRoot) || strings.HasPrefix(filepath.Clean(output)+string(os.PathSeparator), realSource+string(os.PathSeparator)) {
+		return "", errors.New("build workspace must be outside the real source directory")
+	}
+	realRoot, err := filepath.EvalSymlinks(moduleRoot)
+	if err != nil || realRoot != filepath.Clean(moduleRoot) || filepath.Base(realRoot) != "sing@v0.9.4" {
+		return "", errors.New("module source must be the real sing v0.9.4 directory")
+	}
+	if strings.HasPrefix(filepath.Clean(output)+string(os.PathSeparator), realRoot+string(os.PathSeparator)) {
+		return "", errors.New("build workspace must be outside the verified module directory")
+	}
+	goMod, err := os.ReadFile(filepath.Join(realSource, "go.mod"))
+	if err != nil || !strings.Contains(string(goMod), "\tgithub.com/sagernet/sing v0.9.4\n") || strings.Contains(string(goMod), "replace ") {
+		return "", errors.New("unexpected sing-box module declaration")
+	}
+	// Validate and rewrite both files before creating the isolated workspace.
+	contents := make(map[string][]byte, len(patches))
+	for _, patch := range patches {
+		path := filepath.Join(realRoot, patch.path)
+		metadata, err := os.Lstat(path)
+		if err != nil || !metadata.Mode().IsRegular() || metadata.Size() > 65536 {
+			return "", fmt.Errorf("%s: expected a bounded regular source file", patch.path)
+		}
+		input, err := os.ReadFile(path)
+		if err != nil {
+			return "", err
+		}
+		contents[patch.path], err = rewrite(patch, input)
+		if err != nil {
+			return "", err
+		}
+	}
+	if err := os.Mkdir(output, 0o700); err != nil {
+		return "", err
+	}
+	defer func() {
+		if resultErr != nil {
+			resultErr = errors.Join(resultErr, os.RemoveAll(output))
+		}
+	}()
+	if err := copySources(realSource, output); err != nil {
+		return "", err
+	}
+	moduleCopy := filepath.Join(output, "cfw-dependencies", "sing")
+	if err := copySources(realRoot, moduleCopy); err != nil {
+		return "", err
+	}
+	for relative, content := range contents {
+		path := filepath.Join(moduleCopy, relative)
+		if err := os.WriteFile(path, content, 0o600); err != nil {
+			return "", err
+		}
+	}
+	// A fixed relative replacement keeps ephemeral absolute paths out of module
+	// build identities. Both trees, including the dependency license, are copied.
+	goMod = append(goMod, []byte("\nreplace github.com/sagernet/sing v0.9.4 => ./cfw-dependencies/sing\n")...)
+	if err := os.WriteFile(filepath.Join(output, "go.mod"), goMod, 0o600); err != nil {
+		return "", err
+	}
+	return output, nil
+}
+
+func main() {
+	moduleRoot := flag.String("module-source", "", "verified sing v0.9.4 module directory")
+	output := flag.String("output", "", "new private build workspace")
+	flag.Parse()
+	if flag.NArg() != 0 {
+		fmt.Fprintln(os.Stderr, "unexpected build-workspace arguments")
+		os.Exit(1)
+	}
+	sourceRoot, err := os.Getwd()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	path, err := prepare(sourceRoot, *moduleRoot, *output)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	fmt.Println(path)
+}
