+)
+
+func setupBudgetDNS(t *testing.T, answer bool) (int, *atomic.Int32) {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := new(atomic.Int32)
+	ready, done := make(chan struct{}), make(chan error, 1)
+	server := &mdns.Server{PacketConn: conn, Net: "udp", NotifyStartedFunc: func() { close(ready) }, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, query *mdns.Msg) {
+		seen.Add(1)
+		if !answer {
+			return // A real UDP black hole: receive the query and send no reply.
+		}
+		response := new(mdns.Msg)
+		response.SetReply(query)
+		response.Answer = []mdns.RR{&mdns.A{Hdr: mdns.RR_Header{Name: query.Question[0].Name, Rrtype: mdns.TypeA, Class: mdns.ClassINET}, A: net.ParseIP("127.0.0.1")}}
+		if err := w.WriteMsg(response); err != nil {
+			t.Error(err)
+		}
+	})}
+	go func() { done <- server.ActivateAndServe() }()
+	select {
+	case <-ready:
+	case err := <-done:
+		t.Fatalf("DNS fixture did not start: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := server.Shutdown(); err != nil {
+			t.Error(err)
+		}
+		if err := <-done; err != nil {
+			t.Error(err)
+		}
+	})
+	return conn.LocalAddr().(*net.UDPAddr).Port, seen
+}
+
+func TestSOCKSBootstrapFallbackSurvivesPrimaryTimeout(t *testing.T) {
+	proxyPort := unusedDNSProbePort(t)
+	startPolicyBoxContext(t, map[string]any{
+		"log":       map[string]any{"disabled": true},
+		"inbounds":  []any{map[string]any{"type": "socks", "listen": "127.0.0.1", "listen_port": proxyPort}},
+		"outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+	})
+	primaryPort, primaryQueries := setupBudgetDNS(t, false)
+	fallbackPort, fallbackQueries := setupBudgetDNS(t, true)
+	ctx := startPolicyBoxContext(t, map[string]any{
+		"log": map[string]any{"disabled": true},
+		"dns": map[string]any{"strategy": "ipv4_only", "servers": []any{
+			map[string]any{"type": "udp", "tag": "primary", "server": "127.0.0.1", "server_port": primaryPort},
+			map[string]any{"type": "udp", "tag": "fallback", "server": "127.0.0.1", "server_port": fallbackPort},
+		}},
+		"outbounds": []any{map[string]any{"type": "socks", "tag": "node", "version": "5", "server": "proxy.invalid", "server_port": proxyPort,
+			"domain_resolver": map[string]any{"server": "primary", "fallback_server": "fallback", "strategy": "ipv4_only"}}},
+	})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { fmt.Fprint(w, "fallback-established") }))
+	defer server.Close()
+	outbound, exists := service.FromContext[adapter.OutboundManager](ctx).Outbound("node")
+	if !exists {
+		t.Fatal("fixture outbound missing")
+	}
+	callCtx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	started := time.Now()
+	conn, err := outbound.DialContext(callCtx, "tcp", M.ParseSocksaddr(strings.TrimPrefix(server.URL, "http://")))
+	if err != nil {
+		t.Fatalf("bootstrap fallback never completed; elapsed=%v primary=%d fallback=%d: %v", time.Since(started), primaryQueries.Load(), fallbackQueries.Load(), err)
+	}
+	defer conn.Close()
+	if primaryQueries.Load() == 0 || fallbackQueries.Load() == 0 {
+		t.Fatal("both real DNS transports must be exercised")
+	}
+	t.Logf("real DNS fallback and SOCKS negotiation completed in %v", time.Since(started))
+	cancel()
+	if err := conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: fixture\r\nConnection: close\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, 1024))
+	if err != nil || response.StatusCode != 200 || string(body) != "fallback-established" {
+		t.Fatalf("established payload not retained: status=%d body=%q err=%v", response.StatusCode, body, err)
+	}
+}
