+func TestSOCKSUDPResolverRecoversAfterCancelledHandshake(t *testing.T) {
+	f := newSocksFixture(t, "request")
+	f.stallFirst = true
+	f.dnsReply = true
+	f.start()
+	outbound := fixtureOutbound(t, f, 150*time.Millisecond, context.Background(), "", "")
+	transport := D.NewUDPRaw(log.NewNOPFactory().NewLogger("dns"), dns.NewTransportAdapter("udp", "dns", nil), outbound, M.ParseSocksaddr("9.9.9.9:53"))
+	defer transport.Close()
+	query := new(mdns.Msg)
+	query.SetQuestion("fixture.invalid.", mdns.TypeA)
+	ctx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	_, err := transport.Exchange(ctx, query)
+	cancel()
+	if err == nil {
+		t.Fatal("stalled handshake unexpectedly returned a DNS answer")
+	}
+	select {
+	case <-f.closed:
+	case <-time.After(400 * time.Millisecond):
+		t.Error("expired DNS dial retained its TCP control connection")
+	}
+	next, cancelNext := context.WithTimeout(context.Background(), 600*time.Millisecond)
+	response, err := transport.Exchange(next, query)
+	cancelNext()
+	if err != nil {
+		t.Errorf("same DNS transport could not recover after timeout: %v", err)
+		return
+	}
+	if len(response.Answer) != 1 {
+		t.Fatal("recovered DNS answer missing")
+	}
+	third, cancelThird := context.WithTimeout(context.Background(), 500*time.Millisecond)
+	defer cancelThird()
+	if response, err = transport.Exchange(third, query); err != nil || len(response.Answer) != 1 {
+		t.Fatalf("successful UDP session did not survive query cancellation: %v", err)
+	}
+	if f.count.Load() != 2 {
+		t.Fatalf("expected one failed and one reusable dial; got %d", f.count.Load())
+	}
+}
+
+func TestSOCKSUDPConnectedDestinationDoesNotChangeAfterReceivingAnotherSource(t *testing.T) {
+	f := newSocksFixture(t, "")
+	f.replyFrom = "198.51.100.9:53"
+	f.observedUDP = make(chan string, 8)
+	f.start()
+	outbound := fixtureOutbound(t, f, time.Second, context.Background(), "", "")
+	destination := M.ParseSocksaddr("203.0.113.1:443")
+	conn, err := outbound.DialContext(context.Background(), "udp", destination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		if _, err = conn.Write([]byte("fixed-destination")); err != nil {
+			t.Fatal(err)
+		}
+		body := make([]byte, 128)
+		n, readErr := conn.Read(body)
+		if readErr != nil || string(body[:n]) != "fixed-destination" {
+			t.Fatalf("read %q: %v", body[:n], readErr)
+		}
+		if got := <-f.observedUDP; got != destination.String() {
+			t.Fatalf("sent to %s after receiving another source", got)
+		}
+	}
+	if conn.RemoteAddr().String() != destination.String() {
+		t.Fatal("connected remote address changed")
+	}
+}
