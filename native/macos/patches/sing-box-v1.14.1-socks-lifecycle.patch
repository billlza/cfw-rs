+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestWorkspacePreservesSourcesAndRejectsDrift(t *testing.T) {
+	cache := os.Getenv("GOMODCACHE")
+	if !filepath.IsAbs(cache) {
+		t.Fatal("test requires the verified absolute module cache")
+	}
+	parent, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	module := filepath.Join(parent, "sing@v0.9.4")
+	source := filepath.Join(parent, "source")
+	if err = os.Mkdir(source, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	goMod := []byte("module github.com/sagernet/sing-box\n\nrequire (\n\tgithub.com/sagernet/sing v0.9.4\n)\n")
+	if err = os.WriteFile(filepath.Join(source, "go.mod"), goMod, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	original := make(map[string][]byte)
+	for _, patch := range patches {
+		input, err := os.ReadFile(filepath.Join(cache, "github.com/sagernet/sing@v0.9.4", patch.path))
+		if err != nil {
+			t.Fatal(err)
+		}
+		path := filepath.Join(module, patch.path)
+		if err = os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(path, input, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		original[path] = input
+	}
+	output := filepath.Join(t.TempDir(), "workspace")
+	workspace, err := prepare(source, module, output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(workspace, "go.mod"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasSuffix(string(data), "\nreplace github.com/sagernet/sing v0.9.4 => ./cfw-dependencies/sing\n") {
+		t.Fatalf("missing exact relative module replacement: %s", data)
+	}
+	unchanged, err := os.ReadFile(filepath.Join(source, "go.mod"))
+	if err != nil || !bytes.Equal(unchanged, goMod) {
+		t.Fatal("source go.mod was modified", err)
+	}
+	for path, before := range original {
+		after, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(before, after) {
+			t.Fatal("module cache source was modified", err)
+		}
+		relative, err := filepath.Rel(module, path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		patched, err := os.ReadFile(filepath.Join(output, "cfw-dependencies", "sing", relative))
+		if err != nil || bytes.Equal(before, patched) {
+			t.Fatal("workspace did not contain corrected source", err)
+		}
+	}
+	if _, err = prepare(source, module, output); err == nil {
+		t.Fatal("overwrote existing output")
+	}
+	for _, protected := range []string{source, module} {
+		inside := filepath.Join(protected, "workspace")
+		if _, err = prepare(source, module, inside); err == nil {
+			t.Fatal("accepted a workspace inside verified inputs")
+		}
+		if _, err = os.Stat(inside); !os.IsNotExist(err) {
+			t.Fatal("workspace rejection modified verified inputs", err)
+		}
+	}
+	for _, patch := range patches {
+		path := filepath.Join(module, patch.path)
+		if err = os.WriteFile(path, append(bytes.Clone(original[path]), '\n'), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		rejected := filepath.Join(t.TempDir(), "rejected")
+		if _, err = prepare(source, module, rejected); err == nil {
+			t.Fatal("accepted changed module source", patch.path)
+		}
+		if _, err = os.Stat(rejected); !os.IsNotExist(err) {
+			t.Fatal("source rejection left output", err)
+		}
+		if err = os.WriteFile(path, original[path], 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
