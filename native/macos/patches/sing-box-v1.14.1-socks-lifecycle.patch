diff --git a/protocol/socks/outbound_lifecycle_test.go b/protocol/socks/outbound_lifecycle_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9e3ffc7ebde119ee02ea0963ad03a87818290e9d
--- /dev/null
+++ b/protocol/socks/outbound_lifecycle_test.go
@@ -0,0 +1,749 @@
+package socks
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/dns"
+	D "github.com/sagernet/sing-box/dns/transport"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+
+	mdns "github.com/miekg/dns"
+)
+
+// Real local SOCKS control/data sockets; no external endpoints or OS settings.
+type socksFixture struct {
+	tcp         net.Listener
+	udp         net.PacketConn
+	stall       string
+	phaseDelay  time.Duration
+	stallFirst  bool
+	bind        string
+	zeroPort    bool
+	dnsReply    bool
+	replyFrom   string
+	observedUDP chan string
+	rejectAuth  bool
+	reached     chan int
+	closed      chan int
+	count       atomic.Int32
+	access      sync.Mutex
+	conns       []net.Conn
+	workers     sync.WaitGroup
+	stopOnce    sync.Once
+	closing     bool
+}
+
+func newSocksFixture(t *testing.T, stall string) *socksFixture {
+	t.Helper()
+	tcp, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	udp, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		tcp.Close()
+		t.Fatal(err)
+	}
+	f := &socksFixture{tcp: tcp, udp: udp, stall: stall, bind: "127.0.0.1", reached: make(chan int, 16), closed: make(chan int, 16)}
+	t.Cleanup(f.close)
+	return f
+}
+
+func (f *socksFixture) start() {
+	f.workers.Add(2)
+	go func() {
+		defer f.workers.Done()
+		for {
+			conn, err := f.tcp.Accept()
+			if err != nil {
+				return
+			}
+			f.access.Lock()
+			if f.closing {
+				f.access.Unlock()
+				conn.Close()
+				return
+			}
+			f.conns = append(f.conns, conn)
+			f.access.Unlock()
+			id := int(f.count.Add(1))
+			f.workers.Add(1)
+			go func() {
+				defer f.workers.Done()
+				defer conn.Close()
+				defer func() { f.closed <- id }()
+				f.serve(conn, id)
+			}()
+		}
+	}()
+	go func() {
+		defer f.workers.Done()
+		buffer := make([]byte, 4096)
+		for {
+			count, peer, err := f.udp.ReadFrom(buffer)
+			if err != nil {
+				return
+			}
+			packet := append([]byte(nil), buffer[:count]...)
+			if f.replyFrom != "" {
+				reader := bytes.NewReader(packet[3:])
+				target, parseErr := M.SocksaddrSerializer.ReadAddrPort(reader)
+				if parseErr != nil {
+					return
+				}
+				f.observedUDP <- target.String()
+				response := bytes.NewBuffer([]byte{0, 0, 0})
+				if M.SocksaddrSerializer.WriteAddrPort(response, M.ParseSocksaddr(f.replyFrom)) != nil {
+					return
+				}
+				response.Write(packet[len(packet)-reader.Len():])
+				packet = response.Bytes()
+			}
+			if f.dnsReply {
+				offset, err := socksAddressLength(packet[3:])
+				if err != nil {
+					continue
+				}
+				offset += 3
+				var query mdns.Msg
+				if query.Unpack(packet[offset:]) != nil {
+					continue
+				}
+				response := new(mdns.Msg)
+				response.SetReply(&query)
+				response.Answer = []mdns.RR{&mdns.A{Hdr: mdns.RR_Header{Name: query.Question[0].Name, Rrtype: mdns.TypeA, Class: mdns.ClassINET, Ttl: 30}, A: net.ParseIP("203.0.113.9")}}
+				raw, err := response.Pack()
+				if err != nil {
+					continue
+				}
+				packet = append(packet[:offset], raw...)
+			}
+			if _, err = f.udp.WriteTo(packet, peer); err != nil {
+				return
+			}
+		}
+	}()
+}
+
+func (f *socksFixture) close() {
+	f.stopOnce.Do(func() {
+		f.tcp.Close()
+		f.udp.Close()
+		f.access.Lock()
+		f.closing = true
+		for _, c := range f.conns {
+			c.Close()
+		}
+		f.access.Unlock()
+		f.workers.Wait()
+	})
+}
+func readN(conn net.Conn, size int) ([]byte, error) {
+	data := make([]byte, size)
+	_, err := io.ReadFull(conn, data)
+	return data, err
+}
+func (f *socksFixture) waitAt(conn net.Conn, id int, phase string) bool {
+	if f.phaseDelay > 0 {
+		time.Sleep(f.phaseDelay)
+	}
+	if f.stall != phase || f.stallFirst && id != 1 {
+		return false
+	}
+	f.reached <- id
+	var buffer [1]byte
+	conn.Read(buffer[:])
+	return true
+}
+func (f *socksFixture) serve(conn net.Conn, id int) {
+	header, err := readN(conn, 2)
+	if err != nil || header[0] != 5 {
+		return
+	}
+	if _, err = readN(conn, int(header[1])); err != nil {
+		return
+	}
+	if f.waitAt(conn, id, "method") {
+		return
+	}
+	if _, err = conn.Write([]byte{5, 2}); err != nil {
+		return
+	}
+	header, err = readN(conn, 2)
+	if err != nil || header[0] != 1 {
+		return
+	}
+	if _, err = readN(conn, int(header[1])); err != nil {
+		return
+	}
+	size, err := readN(conn, 1)
+	if err != nil {
+		return
+	}
+	if _, err = readN(conn, int(size[0])); err != nil {
+		return
+	}
+	if f.waitAt(conn, id, "authentication") {
+		return
+	}
+	authStatus := byte(0)
+	if f.rejectAuth {
+		authStatus = 1
+	}
+	if _, err = conn.Write([]byte{1, authStatus}); err != nil {
+		return
+	}
+	if f.rejectAuth {
+		var buffer [1]byte
+		conn.Read(buffer[:])
+		return
+	}
+	header, err = readN(conn, 4)
+	if err != nil || header[0] != 5 {
+		return
+	}
+	switch header[3] {
+	case 1:
+		_, err = readN(conn, 6)
+	case 4:
+		_, err = readN(conn, 18)
+	case 3:
+		size, err = readN(conn, 1)
+		if err == nil {
+			_, err = readN(conn, int(size[0])+2)
+		}
+	default:
+		return
+	}
+	if err != nil {
+		return
+	}
+	if f.waitAt(conn, id, "request") {
+		return
+	}
+	port := uint16(f.udp.LocalAddr().(*net.UDPAddr).Port)
+	if f.zeroPort {
+		port = 0
+	}
+	response := []byte{5, 0, 0}
+	if ip, err := netip.ParseAddr(f.bind); err == nil {
+		if ip.Is4() {
+			response = append(response, 1)
+		} else {
+			response = append(response, 4)
+		}
+		response = append(response, ip.AsSlice()...)
+	} else {
+		response = append(response, 3, byte(len(f.bind)))
+		response = append(response, []byte(f.bind)...)
+	}
+	response = binary.BigEndian.AppendUint16(response, port)
+	if _, err = conn.Write(response); err != nil {
+		return
+	}
+	if header[1] == 1 {
+		io.Copy(conn, conn)
+	} else {
+		var buffer [1]byte
+		conn.Read(buffer[:])
+	}
+}
+
+func socksAddressLength(data []byte) (int, error) {
+	if len(data) < 1 {
+		return 0, io.ErrUnexpectedEOF
+	}
+	switch data[0] {
+	case 1:
+		if len(data) >= 7 {
+			return 7, nil
+		}
+	case 4:
+		if len(data) >= 19 {
+			return 19, nil
+		}
+	case 3:
+		if len(data) >= 2 && len(data) >= int(data[1])+4 {
+			return int(data[1]) + 4, nil
+		}
+	}
+	return 0, io.ErrUnexpectedEOF
+}
+
+func fixtureOutbound(t *testing.T, f *socksFixture, timeout time.Duration, ctx context.Context, detour string, server string) adapter.Outbound {
+	t.Helper()
+	if server == "" {
+		server = "127.0.0.1"
+	}
+	options := option.SOCKSOutboundOptions{ServerOptions: option.ServerOptions{Server: server, ServerPort: uint16(f.tcp.Addr().(*net.TCPAddr).Port)},
+		DialerOptions: option.DialerOptions{ConnectTimeout: badoption.Duration(timeout), Detour: detour}, Username: "fixture-user", Password: "fixture-password"}
+	result, err := NewOutbound(ctx, nil, log.NewNOPFactory().NewLogger("fixture"), "node", options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestSOCKSHandshakeCancellation(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, phase := range []string{"method", "authentication", "request"} {
+			t.Run(network+"/"+phase, func(t *testing.T) {
+				f := newSocksFixture(t, phase)
+				f.start()
+				outbound := fixtureOutbound(t, f, time.Second, context.Background(), "", "")
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				done := make(chan error, 1)
+				go func() {
+					conn, err := outbound.DialContext(ctx, network, M.ParseSocksaddr("203.0.113.1:443"))
+					if conn != nil {
+						conn.Close()
+					}
+					done <- err
+				}()
+				select {
+				case <-f.reached:
+				case <-time.After(time.Second):
+					t.Fatal("server did not reach scripted handshake stage")
+				}
+				cancel()
+				select {
+				case err := <-done:
+					if !errors.Is(err, context.Canceled) {
+						t.Errorf("expected cancellation, got %v", err)
+					}
+				case <-time.After(500 * time.Millisecond):
+					t.Error("SOCKS handshake ignored cancellation")
+					f.close()
+					<-done
+					return
+				}
+				select {
+				case <-f.closed:
+				case <-time.After(500 * time.Millisecond):
+					t.Error("cancelled handshake did not close its control connection")
+				}
+			})
+		}
+	}
+}
+
+func TestSOCKSConnectTimeoutIncludesHandshake(t *testing.T) {
+	f := newSocksFixture(t, "request")
+	f.start()
+	outbound := fixtureOutbound(t, f, 100*time.Millisecond, context.Background(), "", "")
+	done := make(chan error, 1)
+	start := time.Now()
+	go func() {
+		conn, err := outbound.DialContext(context.Background(), "udp", M.ParseSocksaddr("203.0.113.1:53"))
+		if conn != nil {
+			conn.Close()
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Errorf("expected configured handshake deadline, got %v", err)
+		}
+		if time.Since(start) > 500*time.Millisecond {
+			t.Error("handshake exceeded its configured bound")
+		}
+	case <-time.After(600 * time.Millisecond):
+		t.Error("connect_timeout did not bound the SOCKS handshake")
+		f.close()
+		<-done
+	}
+}
+
+func TestSOCKSDefaultBudgetAllowsCompleteNegotiation(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			t.Parallel()
+			f := newSocksFixture(t, "")
+			// Model three successful round trips over a congested upstream.
+			// TCP connects immediately; protocol negotiation takes six seconds.
+			f.phaseDelay = 2 * time.Second
+			f.start()
+			outbound := fixtureOutbound(t, f, 0, context.Background(), "", "")
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			started := time.Now()
+			conn, err := outbound.DialContext(ctx, network, M.ParseSocksaddr("203.0.113.1:443"))
+			if err != nil {
+				t.Fatalf("working SOCKS negotiation cut short after %v: %v", time.Since(started), err)
+			}
+			defer conn.Close()
+			t.Logf("real %s negotiation completed in %v", network, time.Since(started))
+			cancel()
+			if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			payload := []byte("retained-after-slow-negotiation")
+			if _, err = conn.Write(payload); err != nil {
+				t.Fatal(err)
+			}
+			got := make([]byte, 4096)
+			var n int
+			if network == "tcp" {
+				n, err = io.ReadFull(conn, got[:len(payload)])
+			} else {
+				n, err = conn.Read(got)
+			}
+			if err != nil || !bytes.Equal(got[:n], payload) {
+				t.Fatalf("established connection did not retain payload: %q %v", got[:n], err)
+			}
+		})
+	}
+}
+
+func TestSOCKSSuccessfulConnectionsOutliveDialContext(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			f := newSocksFixture(t, "")
+			f.start()
+			outbound := fixtureOutbound(t, f, 100*time.Millisecond, context.Background(), "", "")
+			ctx, cancel := context.WithCancel(context.Background())
+			conn, err := outbound.DialContext(ctx, network, M.ParseSocksaddr("203.0.113.1:443"))
+			cancel()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			time.Sleep(120 * time.Millisecond)
+			if err = conn.SetDeadline(time.Now().Add(time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 3; i++ {
+				payload := []byte("retained-session")
+				if _, err = conn.Write(payload); err != nil {
+					t.Fatal(err)
+				}
+				got := make([]byte, 4096)
+				var count int
+				var readErr error
+				if network == "tcp" {
+					count, readErr = io.ReadFull(conn, got[:len(payload)])
+				} else {
+					count, readErr = conn.Read(got)
+				}
+				if readErr != nil {
+					t.Fatal(readErr)
+				}
+				if string(got[:count]) != string(payload) {
+					t.Fatal("session payload changed")
+				}
+			}
+		})
+	}
+}
