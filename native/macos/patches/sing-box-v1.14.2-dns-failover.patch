+package dns_test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+func unusedDNSProbePort(t *testing.T) int {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return port
+}
+
+func TestRoutedDNSUsesActualSOCKSTransportsAndRetainsUDPAfterDialCancellation(t *testing.T) {
+	proxyPort := unusedDNSProbePort(t)
+	startPolicyBoxContext(t, map[string]any{
+		"log":       map[string]any{"disabled": true},
+		"inbounds":  []any{map[string]any{"type": "socks", "listen": "127.0.0.1", "listen_port": proxyPort}},
+		"outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+	})
+	closedProxy := unusedDNSProbePort(t)
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			var server mdns.Server
+			server.Net = network
+			server.Handler = mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+				r := new(mdns.Msg)
+				r.SetReply(q)
+				rr, err := mdns.NewRR(q.Question[0].Name + " 0 IN A 203.0.113.25")
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				r.Answer = append(r.Answer, rr)
+				if err := w.WriteMsg(r); err != nil {
+					t.Error(err)
+				}
+			})
+			var port int
+			var err error
+			if network == "tcp" {
+				server.Listener, err = net.Listen("tcp", "127.0.0.1:0")
+				if err == nil {
+					port = server.Listener.Addr().(*net.TCPAddr).Port
+				}
+			} else {
+				server.PacketConn, err = net.ListenPacket("udp", "127.0.0.1:0")
+				if err == nil {
+					port = server.PacketConn.LocalAddr().(*net.UDPAddr).Port
+				}
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			go func() {
+				if err := server.ActivateAndServe(); err != nil {
+					t.Error(err)
+				}
+			}()
+			t.Cleanup(func() {
+				if err := server.Shutdown(); err != nil {
+					t.Error(err)
+				}
+			})
+			config := func(target string) map[string]any {
+				return map[string]any{
+					"log":       map[string]any{"disabled": true},
+					"outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}, map[string]any{"type": "socks", "tag": "proxy", "server": "127.0.0.1", "server_port": proxyPort}, map[string]any{"type": "socks", "tag": "closed", "server": "127.0.0.1", "server_port": closedProxy}},
+					"route": map[string]any{"final": "direct", "rules": []any{
+						map[string]any{"port": port, "action": "hijack-dns"},
+						map[string]any{"action": "resolve"},
+						map[string]any{"port": port, "action": "route", "outbound": target},
+					}},
+					"dns": map[string]any{"final": "routed", "servers": []any{map[string]any{"type": network, "tag": "routed", "server": "127.0.0.1", "server_port": port, "respect_rules": true}}},
+				}
+			}
+			router, _ := startPolicyBox(t, config("proxy"))
+			for index := 0; index < 3; index++ {
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				query := new(mdns.Msg)
+				query.SetQuestion(fmt.Sprintf("packet-%d.example.", index), mdns.TypeA)
+				response, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{})
+				cancel()
+				if err != nil || len(response.Answer) != 1 {
+					t.Fatalf("routed query %d: %v", index, err)
+				}
+			}
+			failed, _ := startPolicyBox(t, config("closed"))
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			query := new(mdns.Msg)
+			query.SetQuestion("must-not-go-direct.example.", mdns.TypeA)
+			if _, err := failed.Exchange(ctx, query, adapter.DNSQueryOptions{}); err == nil {
+				t.Fatal("unreachable routed proxy silently used DIRECT")
+			}
+		})
+	}
+}
+
+func TestDirectOutboundResolvesUsingNamedPolicyBeforeDialing(t *testing.T) {
+	port, seen := startPolicyTCP(t, false, "127.0.0.1")
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	served := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err == nil {
+			defer conn.Close()
+			_, err = conn.Write([]byte("policy socket"))
+		}
+		served <- err
+	}()
+	ctx := startPolicyBoxContext(t, map[string]any{
+		"log":       map[string]any{"disabled": true},
+		"outbounds": []any{map[string]any{"type": "direct", "tag": "direct", "domain_resolver": map[string]any{"policy": "direct"}}},
+		"dns":       map[string]any{"final": "closed", "servers": []any{map[string]any{"type": "tcp", "tag": "closed", "server": "127.0.0.1", "server_port": unusedDNSProbePort(t)}, map[string]any{"type": "tcp", "tag": "internal", "server": "127.0.0.1", "server_port": port}}, "policies": []any{map[string]any{"tag": "direct", "final": "internal"}}},
+	})
+	outbound, found := service.FromContext[adapter.OutboundManager](ctx).Outbound("direct")
+	if !found {
+		t.Fatal("direct outbound missing")
+	}
+	queryContext, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	conn, err := outbound.DialContext(queryContext, "tcp", M.Socksaddr{Fqdn: "policy.example", Port: uint16(listener.Addr().(*net.TCPAddr).Port)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if err := conn.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	content, err := io.ReadAll(conn)
+	if err != nil || string(content) != "policy socket" {
+		t.Fatalf("policy did not reach real socket: %q %v", content, err)
+	}
+	if err := <-served; err != nil {
+		t.Fatal(err)
+	}
+	if _, found := seen.Load("policy.example."); !found {
+		t.Fatal("named policy resolver was skipped")
+	}
+}
