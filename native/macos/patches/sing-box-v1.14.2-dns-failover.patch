+++ b/dns/dialer_query_options_test.go
@@ -0,0 +1,103 @@
+package dns_test
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+// Exercise the new upstream helper through a real service registry. No network
+// query is sent: these cases verify resolver selection before dialing begins.
+func TestDomainResolverQueryOptionsPreservePolicyAndFallbackPrecedence(t *testing.T) {
+	for _, test := range []struct {
+		name, defaults, explicit, server, policy string
+		fallbacks                                []string
+		wantError                                bool
+	}{
+		{name: "explicit-server-over-default-policy", defaults: `{"policy":"default-policy"}`, explicit: `{"server":"primary","fallback_servers":["secondary","third"]}`, server: "primary", fallbacks: []string{"secondary", "third"}},
+		{name: "default-server-fallbacks", defaults: `{"server":"secondary","fallback_servers":["third","primary"]}`, server: "secondary", fallbacks: []string{"third", "primary"}},
+		{name: "explicit-server-does-not-inherit-fallbacks", defaults: `{"server":"secondary","fallback_servers":["third"]}`, explicit: `{"server":"primary"}`, server: "primary"},
+		{name: "explicit-policy-over-default-server", defaults: `{"server":"secondary","fallback_servers":["third"]}`, explicit: `{"policy":"explicit-policy"}`, policy: "explicit-policy"},
+		{name: "default-policy", defaults: `{"policy":"default-policy"}`, policy: "default-policy"},
+		{name: "unknown-explicit-fallback", defaults: `{"policy":"default-policy"}`, explicit: `{"server":"primary","fallback_server":"missing"}`, wantError: true},
+		{name: "unknown-explicit-policy", defaults: `{"server":"secondary"}`, explicit: `{"policy":"missing"}`, wantError: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var defaults map[string]any
+			if err := json.Unmarshal([]byte(test.defaults), &defaults); err != nil {
+				t.Fatal(err)
+			}
+			addOptions := func(value map[string]any) {
+				value["timeout"], value["strategy"] = "2s", "ipv4_only"
+				value["disable_cache"], value["disable_optimistic_cache"] = true, true
+				value["rewrite_ttl"], value["client_subnet"] = 19, "192.0.2.0/24"
+			}
+			addOptions(defaults)
+			ctx := startPolicyBoxContext(t, map[string]any{
+				"log":   map[string]any{"disabled": true},
+				"route": map[string]any{"default_domain_resolver": defaults},
+				"dns": map[string]any{
+					"final":    "primary",
+					"servers":  []any{policyTCP("primary", 53001), policyTCP("secondary", 53002), policyTCP("third", 53003)},
+					"policies": []any{map[string]any{"tag": "default-policy", "final": "secondary"}, map[string]any{"tag": "explicit-policy", "final": "third"}},
+				},
+			})
+			var explicit *option.DomainResolveOptions
+			if test.explicit != "" {
+				var fields map[string]any
+				if err := json.Unmarshal([]byte(test.explicit), &fields); err != nil {
+					t.Fatal(err)
+				}
+				addOptions(fields)
+				encoded, err := json.Marshal(fields)
+				if err != nil {
+					t.Fatal(err)
+				}
+				explicit = new(option.DomainResolveOptions)
+				if err := json.Unmarshal(encoded, explicit); err != nil {
+					t.Fatal(err)
+				}
+			}
+			query, err := dialer.NewDNSQueryOptions(ctx, explicit, true)
+			resolved, dialErr := dialer.NewWithOptions(dialer.Options{Context: ctx, Options: option.DialerOptions{DomainResolver: explicit}, RemoteIsDomain: true, NewDialer: true})
+			if test.wantError {
+				if err == nil || dialErr == nil || resolved != nil {
+					t.Fatalf("missing resolver must fail in both paths: helper=%v dialer=%v", err, dialErr)
+				}
+				return
+			}
+			if err != nil || dialErr != nil {
+				t.Fatalf("helper=%v dialer=%v", err, dialErr)
+			}
+			withQuery, ok := resolved.(interface {
+				QueryOptions() adapter.DNSQueryOptions
+			})
+			if !ok || !reflect.DeepEqual(query, withQuery.QueryOptions()) {
+				t.Fatal("dialer dropped the helper's resolver policy or fallback options")
+			}
+			if query.Policy != test.policy || query.Timeout != 2*time.Second || query.Strategy != C.DomainStrategyIPv4Only || !query.DisableCache || !query.DisableOptimisticCache || query.RewriteTTL == nil || *query.RewriteTTL != 19 || query.ClientSubnet.String() != "192.0.2.0/24" {
+				t.Fatalf("resolver options changed: %+v", query)
+			}
+			if test.server == "" {
+				if query.Transport != nil {
+					t.Fatal("policy selection inherited an explicit transport")
+				}
+			} else if query.Transport == nil || query.Transport.Tag() != test.server {
+				t.Fatalf("wrong transport: %v", query.Transport)
+			}
+			var tags []string
+			for _, fallback := range query.FallbackTransports {
+				tags = append(tags, fallback.Tag())
+			}
+			if !reflect.DeepEqual(tags, test.fallbacks) {
+				t.Fatalf("fallback order %v, want %v", tags, test.fallbacks)
+			}
+		})
+	}
+}
