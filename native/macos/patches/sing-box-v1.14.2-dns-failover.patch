+
+// ResolveDNSFallbacks is shared by eager and deferred dialers. An unavailable
+// explicit resolver is configuration failure, never implicit system DNS.
+func ResolveDNSFallbacks(manager DNSTransportManager, tags []string) ([]DNSTransport, error) {
+	if len(tags) > 7 {
+		return nil, E.New("at most seven DNS fallbacks are supported")
+	}
+	transports := make([]DNSTransport, 0, len(tags))
+	for _, tag := range tags {
+		transport, loaded := manager.Transport(tag)
+		if !loaded {
+			return nil, E.New("domain resolver fallback not found: " + tag)
+		}
+		transports = append(transports, transport)
+	}
+	return transports, nil
+}
