+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	var valueOK atomic.Bool
+	m := newQueryMultiplexer(queryMultiplexerOptions{
+		probeReuse: true,
+		dial: func(ctx context.Context) (net.Conn, error) {
+			valueOK.Store(ctx.Value(key{}) == "request-value")
+			close(entered)
+			<-ctx.Done()
+			close(cancelled)
+			<-release
+			return client, nil
+		},
+		write: func(net.Conn, *mDNS.Msg, uint16) error { return errors.New("must not write late connection") },
+	})
+	m.maybeStartProbe(context.WithValue(context.Background(), key{}, "request-value"), lifecycleQuery())
+	lifecycleAwait(t, entered, "probe dial entered")
+	var closeErr error
+	go func() { closeErr = m.Close(); close(finished) }()
+	select {
+	case <-finished:
+		t.Error("Close returned before admitted dial was cancelled and drained")
+	case <-cancelled:
+	case <-time.After(6 * time.Second):
+		t.Error("probe dial was not cancelled")
+	}
+	close(release)
+	lifecycleAwait(t, cancelled, "dial cancellation, including old 5s timeout")
+	lifecycleAwait(t, finished, "Close after releasing dial")
+	if closeErr != nil {
+		t.Error(closeErr)
+	}
+	if !valueOK.Load() {
+		t.Error("request context value was lost")
+	}
+	server.SetWriteDeadline(time.Now().Add(time.Second))
