@@ -0,0 +1,72 @@
+package route
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/adapter"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var _ adapter.DNSConnectionRouter = (*Router)(nil)
+
+func (r *Router) dnsOutbound(ctx context.Context, network string, destination M.Socksaddr, domain string) (context.Context, adapter.Outbound, M.Socksaddr, error) {
+	if !destination.IsIP() {
+		return ctx, nil, destination, E.New("routed DNS requires a bootstrapped numeric destination")
+	}
+	metadata := adapter.InboundContext{InternalDNS: true, Inbound: "internal-dns", Network: network, Destination: destination, Domain: domain}
+	ctx = adapter.WithContext(ctx, &metadata)
+	rule, _, _, _, err := r.matchRule(ctx, &metadata, nil, nil)
+	if err != nil {
+		return ctx, nil, destination, err
+	}
+	outbound := r.outbound.Default()
+	if rule != nil {
+		switch action := rule.Action().(type) {
+		case *R.RuleActionRoute:
+			var loaded bool
+			outbound, loaded = r.outbound.Outbound(action.Outbound)
+			if !loaded {
+				return ctx, nil, destination, E.New("DNS route outbound not found: ", action.Outbound)
+			}
+		case *R.RuleActionBypass:
+			var loaded bool
+			outbound, loaded = r.outbound.Outbound(action.Outbound)
+			if !loaded {
+				return ctx, nil, destination, E.New("DNS bypass outbound not found: ", action.Outbound)
+			}
+		case *R.RuleActionReject:
+			return ctx, nil, destination, action.Error(ctx)
+		default:
+			return ctx, nil, destination, E.New("DNS socket matched an unsupported route action")
+		}
+	}
+	if outbound == nil || !common.Contains(outbound.Network(), network) {
+		return ctx, nil, destination, E.New("selected DNS outbound does not support ", network)
+	}
+	if metadata.Destination.IsDomain() {
+		return ctx, nil, destination, E.New("DNS route cannot override its bootstrapped destination with a domain")
+	}
+	return ctx, outbound, metadata.Destination, nil
+}
+
+func (r *Router) DialDNSConnection(ctx context.Context, network string, destination M.Socksaddr, domain string) (net.Conn, error) {
+	network = N.NetworkName(network)
+	ctx, outbound, destination, err := r.dnsOutbound(ctx, network, destination, domain)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.DialContext(ctx, network, destination)
+}
+
+func (r *Router) ListenDNSPacket(ctx context.Context, destination M.Socksaddr, domain string) (net.PacketConn, error) {
+	ctx, outbound, destination, err := r.dnsOutbound(ctx, N.NetworkUDP, destination, domain)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.ListenPacket(ctx, destination)
+}
