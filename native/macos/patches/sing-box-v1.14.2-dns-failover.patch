+func nativeFallbackRules(t *testing.T) []adapter.DNSRule {
+	t.Helper()
+	filter := &option.DNSResponseFilter{DNSRule: option.DNSRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPAcceptAny: true}}}}
+	raw := []option.DNSRule{
