+package dns
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"testing"
+)
+
+func TestHostsMissDoesNotHideAJointIOFailure(t *testing.T) {
+	if !onlyHostsMiss(fmt.Errorf("lookup: %w", errors.Join(ErrHostsNotFound, ErrHostsNotFound))) {
+		t.Fatal("wrapped hosts absence rejected")
+	}
+	for _, err := range []error{nil, os.ErrPermission, errors.Join(ErrHostsNotFound, os.ErrPermission)} {
+		if onlyHostsMiss(err) {
+			t.Fatal("non-miss error admitted fallback")
+		}
+	}
+}
diff --git a/dns/ordered_fallback.go b/dns/ordered_fallback.go
new file mode 100644
index 0000000000000000000000000000000000000000..b63a9a08294dc7fdfc69466ba106f4f0510dcbde
--- /dev/null
+++ b/dns/ordered_fallback.go
@@ -0,0 +1,158 @@
+package dns
+
+import (
+	"context"
+	"net/netip"
+
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+const maxDNSAttempts = 8
+
+var ErrHostsNotFound = E.New("hosts entry not found")
+
+func onlyHostsMiss(err error) bool {
+	if err == ErrHostsNotFound {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		children := joined.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !onlyHostsMiss(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyHostsMiss(wrapped.Unwrap())
+	}
+	return false
+}
+
+func exchangePoolError(response *dns.Msg, err error) error {
+	if err != nil {
+		return err
+	}
+	if response == nil {
+		return E.New("DNS transport returned an empty response")
+	}
+	if response.Rcode != dns.RcodeSuccess && response.Rcode != dns.RcodeNameError {
+		return RcodeError(response.Rcode)
+	}
+	if response.Rcode == dns.RcodeSuccess && len(response.Answer) == 0 && !isNODATAResponse(response) {
+		return E.New("DNS response is empty without negative authority")
+	}
+	return nil
+}
+
+func shouldContinueDNSRule(ctx context.Context, eligible bool, err error, attempts int) bool {
+	return eligible && err != nil && !onlyNegativeDNSResult(err) && attempts < maxDNSAttempts && ctx.Err() == nil
+}
+
+func shouldUseExplicitDNSFallback(ctx context.Context, fallback adapter.DNSTransport, err error) bool {
+	return fallback != nil && shouldContinueDNSRule(ctx, true, err, 0)
+}
+
+func dnsAttemptError(transport adapter.DNSTransport, err error) error {
+	if transport == nil {
+		return E.Cause(err, "DNS transport unavailable")
+	}
+	return E.Cause(err, "DNS server ", transport.Tag())
+}
+
+func explicitDNSPool(options adapter.DNSQueryOptions) ([]adapter.DNSTransport, error) {
+	if options.Transport == nil {
+		if options.FallbackTransport != nil || len(options.FallbackTransports) != 0 {
+			return nil, E.New("DNS fallbacks require an explicit primary transport")
+		}
+		return nil, nil
+	}
+	pool := []adapter.DNSTransport{options.Transport}
+	if options.FallbackTransport != nil {
+		pool = append(pool, options.FallbackTransport)
+	}
+	pool = append(pool, options.FallbackTransports...)
+	if len(pool) > maxDNSAttempts {
+		return nil, E.New("DNS fallback attempt limit exceeded")
+	}
+	seen := make(map[string]bool, len(pool))
+	for _, transport := range pool {
+		if transport == nil {
+			return nil, E.New("DNS fallback transport is unavailable")
+		}
+		if seen[transport.Tag()] {
+			return nil, E.New("duplicate DNS fallback transport: ", transport.Tag())
+		}
+		seen[transport.Tag()] = true
+	}
+	return pool, nil
+}
+
+func (r *Router) exchangeExplicitPoolAsync(ctx context.Context, message *dns.Msg, options adapter.DNSQueryOptions, callback func(*dns.Msg, adapter.DNSTransport, error)) {
+	pool, err := explicitDNSPool(options)
+	if err != nil {
+		callback(nil, nil, err)
+		return
+	}
+	options = r.finalizeExchangeOptions(options)
+	options.FallbackTransport, options.FallbackTransports = nil, nil
+	var failures []error
+	var attempt func(int)
+	attempt = func(index int) {
+		transport := pool[index]
+		options.Transport = transport
+		r.client.ExchangeAsync(adapter.OverrideContext(ctx), transport, message, options, nil, func(response *dns.Msg, err error) {
+			if len(pool) > 1 {
+				err = exchangePoolError(response, err)
+			}
+			if err == nil {
+				callback(response, transport, nil)
+				return
+			}
+			failures = append(failures, dnsAttemptError(transport, err))
+			if index+1 < len(pool) && shouldUseExplicitDNSFallback(ctx, pool[index+1], err) {
+				attempt(index + 1)
+				return
+			}
+			callback(nil, transport, E.Errors(failures...))
+		})
+	}
+	attempt(0)
+}
+
+func (r *Router) exchangeExplicitPool(ctx context.Context, message *dns.Msg, options adapter.DNSQueryOptions) (*dns.Msg, adapter.DNSTransport, error) {
+	result := make(chan exchangeWithRulesResult, 1)
+	r.exchangeExplicitPoolAsync(ctx, message, options, func(response *dns.Msg, transport adapter.DNSTransport, err error) {
+		result <- exchangeWithRulesResult{response: response, transport: transport, err: err}
+	})
+	completed := <-result
+	return completed.response, completed.transport, completed.err
+}
+
+func (r *Router) lookupExplicitPool(ctx context.Context, domain string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	pool, err := explicitDNSPool(options)
+	if err != nil {
+		return nil, err
+	}
+	options = r.finalizeExchangeOptions(options)
+	options.FallbackTransport, options.FallbackTransports = nil, nil
+	var failures []error
+	for index, transport := range pool {
+		options.Transport = transport
+		addresses, err := r.client.Lookup(adapter.OverrideContext(ctx), transport, domain, options, nil)
+		if err == nil {
+			return addresses, nil
+		}
+		failures = append(failures, dnsAttemptError(transport, err))
+		if index+1 == len(pool) || !shouldUseExplicitDNSFallback(ctx, pool[index+1], err) {
+			break
+		}
+	}
+	return nil, E.Errors(failures...)
+}
diff --git a/dns/policy.go b/dns/policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..4d537dddafcf10761daf507af2b46ee999552efd
--- /dev/null
+++ b/dns/policy.go
@@ -0,0 +1,105 @@
+package dns
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+type dnsPolicy struct {
+	rules []adapter.DNSRule
+	final string
+}
+
+func (r *Router) ValidateDNSPolicy(policy string) error {
+	return r.validatePolicy(adapter.DNSQueryOptions{Policy: policy})
+}
+
+func routerInitializePolicies(r *Router, start bool) error {
+	if len(r.policyOptions) > 8 {
+		return E.New("at most eight named DNS policies are supported")
+	}
+	policies := make(map[string]dnsPolicy, len(r.policyOptions))
+	complete := false
+	defer func() {
+		if !complete {
+			for _, policy := range policies {
+				closeRules(policy.rules)
+			}
+		}
+	}()
+	for _, source := range r.policyOptions {
+		if source.Tag == "" || source.Tag == "default" || len(source.Tag) > 128 || source.Final == "" || len(source.Rules) > 4096 {
+			return E.New("invalid named DNS policy")
+		}
+		if _, exists := policies[source.Tag]; exists {
+			return E.New("duplicate DNS policy: ", source.Tag)
+		}
+		if start {
+			if _, found := r.transport.Transport(source.Final); !found {
+				return E.New("DNS policy ", source.Tag, " final server not found: ", source.Final)
+			}
+		}
+		// A concrete terminal route prevents errors from entering the default
+		// policy. The native walker, including async evaluation, is shared.
+		rawRules := append([]option.DNSRule(nil), source.Rules...)
+		rawRules = append(rawRules, option.DNSRule{
+			Type: C.RuleTypeDefault,
+			DefaultOptions: option.DefaultDNSRule{DNSRuleAction: option.DNSRuleAction{
+				Action:       C.RuleActionTypeRoute,
+				RouteOptions: option.DNSRouteActionOptions{Server: source.Final},
+			}},
+		})
+		rules, _, _, err := r.buildRuleList(rawRules, start, true)
+		if err != nil {
+			return E.Cause(err, "DNS policy ", source.Tag)
+		}
+		policies[source.Tag] = dnsPolicy{rules: rules, final: source.Final}
+	}
+	if err := r.closePolicies(); err != nil {
+		return err
+	}
+	r.policies = policies
+	complete = true
+	return nil
+}
+
+func (r *Router) closePolicies() error {
+	var errs []error
+	for tag, policy := range r.policies {
+		for index, rule := range policy.rules {
+			if err := rule.Close(); err != nil {
+				errs = append(errs, E.Cause(err, "close DNS policy ", tag, " rule[", index, "]"))
+			}
+		}
+	}
+	return E.Errors(errs...)
+}
+
+func (r *Router) validatePolicy(options adapter.DNSQueryOptions) error {
+	if options.Policy == "" {
+		return nil
+	}
+	if options.Transport != nil || options.FallbackTransport != nil || len(options.FallbackTransports) != 0 {
+		return E.New("DNS policy cannot be combined with explicit resolver transports")
+	}
+	if options.Policy != "default" {
+		policy, found := r.policies[options.Policy]
+		if !found {
+			return E.New("DNS policy not found: ", options.Policy)
+		}
+		if _, found := r.transport.Transport(policy.final); !found {
+			return E.New("DNS policy final server is unavailable: ", policy.final)
+		}
+	}
+	return nil
+}
+
+// Called after validatePolicy and while the router's state is held for reading.
+func (r *Router) policyRules(tag string) ([]adapter.DNSRule, bool) {
+	if tag == "" || tag == "default" {
+		return r.rules, r.legacyDNSMode
+	}
+	return r.policies[tag].rules, false
+}
diff --git a/dns/policy_test.go b/dns/policy_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..48048ac590035858909b9ae64f81a9e19fcd276f
--- /dev/null
+++ b/dns/policy_test.go
@@ -0,0 +1,192 @@
+package dns_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func TestNamedDNSPoliciesComposeAndKeepFailuresInTheirOwnRole(t *testing.T) {
+	mainPort, mainQueries := startPolicyTCPWithTTL(t, false, "203.0.113.10", 60)
+	directPort, _ := startPolicyTCPWithTTL(t, false, "203.0.113.20", 60)
+	policyPort, _ := startPolicyTCPWithTTL(t, false, "203.0.113.30", 60)
+	closedPort, _ := startPolicyTCP(t, true, "")
+	var servers []any
+	for index, port := range []int{mainPort, directPort, policyPort, closedPort} {
+		servers = append(servers, map[string]any{"type": "tcp", "tag": fmt.Sprint(index), "server": "127.0.0.1", "server_port": port})
+	}
+	router, transports := startPolicyBox(t, map[string]any{
+		"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+		"dns": map[string]any{"servers": servers, "final": "0", "policies": []any{
+			map[string]any{"tag": "direct", "final": "1", "rules": []any{map[string]any{"domain_suffix": "internal.example", "action": "route", "server": "2"}}},
+			map[string]any{"tag": "failed", "final": "3"},
+		}},
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	for _, item := range []struct{ name, policy, address string }{
+		{"site.example", "default", "203.0.113.10"},
+		{"site.example", "direct", "203.0.113.20"},
+		{"internal.example", "direct", "203.0.113.30"},
+		{"sub.internal.example", "direct", "203.0.113.30"},
+	} {
+		addresses, err := router.Lookup(ctx, item.name, adapter.DNSQueryOptions{Policy: item.policy, Strategy: C.DomainStrategyIPv4Only})
+		if err != nil || len(addresses) != 1 || addresses[0] != netip.MustParseAddr(item.address) {
+			t.Fatalf("%s/%s: %v %v", item.policy, item.name, addresses, err)
+		}
+		response, err := exchangePolicyAsync(t, router, ctx, policyQuestion(item.name), adapter.DNSQueryOptions{Policy: item.policy})
+		if err != nil || response == nil || len(response.Answer) != 1 || response.Answer[0].(*mdns.A).A.String() != item.address {
+			t.Fatalf("async %s/%s: %v %v", item.policy, item.name, response, err)
+		}
+	}
+	query := new(mdns.Msg)
+	query.SetQuestion("must-not-leak.example.", mdns.TypeA)
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "failed"}); err == nil {
+		t.Fatal("failed role returned success")
+	}
+	if _, err := exchangePolicyAsync(t, router, ctx, query, adapter.DNSQueryOptions{Policy: "failed"}); err == nil {
+		t.Fatal("failed async role returned success")
+	}
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "missing"}); err == nil {
+		t.Fatal("unknown policy became default DNS")
+	}
+	explicit, _ := transports.Transport("0")
+	if _, err := router.Exchange(ctx, query, adapter.DNSQueryOptions{Policy: "direct", Transport: explicit}); err == nil {
+		t.Fatal("conflicting policy and explicit resolver accepted")
+	}
+	if _, seen := mainQueries.Load("must-not-leak.example."); seen {
+		t.Fatal("failed named policy leaked to the ordinary resolver")
+	}
+}
+
+func TestDNSGeoIPAcceptAllRejectsMixedAnswersInEitherOrder(t *testing.T) {
+	for _, answer := range [][]string{{"203.0.113.1", "198.51.100.1"}, {"198.51.100.1", "203.0.113.1"}, {"203.0.113.1", "203.0.113.2"}} {
+		t.Run(answer[0]+"/"+answer[1], func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := &policyTCPProbeDrain{done: make(chan error, 1)}
+			server := &mdns.Server{Listener: listener, Net: "tcp", DecorateReader: func(reader mdns.Reader) mdns.Reader {
+				return &policyTCPProbeReader{Reader: reader, probe: probe}
+			}, Handler: mdns.HandlerFunc(func(w mdns.ResponseWriter, q *mdns.Msg) {
+				// Both business requests are A; the AAAA request identifies the
+				// separate pipelined reuse probe whose peer must finish before
+				// this policy test deliberately shuts down the Box.
+				if q.Question[0].Qtype == mdns.TypeAAAA {
+					if err := probe.observe(w.RemoteAddr().String()); err != nil {
+						t.Error(err)
+					}
+				}
+				r := new(mdns.Msg)
+				r.SetReply(q)
+				for _, address := range answer {
+					record, err := mdns.NewRR(q.Question[0].Name + " 60 IN A " + address)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					r.Answer = append(r.Answer, record)
+				}
+				if err := w.WriteMsg(r); err != nil {
+					t.Error(err)
+				}
+			})}
+			go func() {
+				if err := server.ActivateAndServe(); err != nil {
+					t.Error(err)
+				}
+			}()
+			t.Cleanup(func() {
+				if err := server.Shutdown(); err != nil {
+					t.Error(err)
+				}
+			})
+			fallbackPort, fallbackQueries := startPolicyTCP(t, false, "192.0.2.1")
+			router, transports := startPolicyBox(t, map[string]any{
+				"log": map[string]any{"disabled": true}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}},
+				"route": map[string]any{"rule_set": []any{map[string]any{"type": "inline", "tag": "country", "rules": []any{map[string]any{"ip_cidr": "203.0.113.0/24"}}}}},
+				"dns": map[string]any{"final": "fallback", "servers": []any{
+					map[string]any{"type": "tcp", "tag": "main", "server": "127.0.0.1", "server_port": listener.Addr().(*net.TCPAddr).Port},
+					map[string]any{"type": "tcp", "tag": "fallback", "server": "127.0.0.1", "server_port": fallbackPort},
+				}, "rules": []any{map[string]any{"action": "evaluate", "server": "main", "response_filter": map[string]any{"rule_set": []string{"country"}}, "response_ip_accept_all": true}, map[string]any{"match_response": true, "action": "respond"}}},
+			})
+			// Register after the Box cleanup, so this runs before Box.Close even
+			// when a policy assertion fails. All WriteMsg errors remain fatal to
+			// the test; cancellation/Close itself is covered by transport tests.
+			t.Cleanup(func() {
+				select {
+				case err := <-probe.done:
+					if !errors.Is(err, io.EOF) {
+						t.Errorf("reuse probe peer did not finish cleanly: %v", err)
+					}
+				case <-time.After(6 * time.Second):
+					t.Error("reuse probe peer did not finish before policy fixture cleanup")
+				}
+			})
+			query := new(mdns.Msg)
+			query.SetQuestion("mixed.example.", mdns.TypeA)
+			main, _ := transports.Transport("main")
+			if _, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{Transport: main}); err != nil {
+				t.Fatal(err)
+			}
+			response, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, queriedFallback := fallbackQueries.Load("mixed.example.")
+			wantFallback := answer[0] == "198.51.100.1" || answer[1] == "198.51.100.1"
+			if queriedFallback != wantFallback {
+				t.Fatalf("fallback=%v expected=%v response=%v", queriedFallback, wantFallback, response)
+			}
+		})
+	}
+}
+
+// This reader observes the real probe connection's final EOF, not merely an
+// empty handler count (the probe may not have been scheduled yet). It does not
+// change requests, responses, socket deadlines, or server errors.
+type policyTCPProbeDrain struct {
+	access sync.Mutex
+	remote string
+	done   chan error
+	finish sync.Once
+}
+
+func (p *policyTCPProbeDrain) observe(remote string) error {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if p.remote != "" && p.remote != remote {
+		return fmt.Errorf("unexpected second reuse probe connection: %s", remote)
+	}
+	p.remote = remote
+	return nil
+}
+
+type policyTCPProbeReader struct {
+	mdns.Reader
+	probe *policyTCPProbeDrain
+}
+
+func (r *policyTCPProbeReader) ReadTCP(conn net.Conn, timeout time.Duration) ([]byte, error) {
+	message, err := r.Reader.ReadTCP(conn, timeout)
+	if err != nil {
+		r.probe.access.Lock()
+		matches := r.probe.remote != "" && r.probe.remote == conn.RemoteAddr().String()
+		r.probe.access.Unlock()
+		if matches {
+			r.probe.finish.Do(func() { r.probe.done <- err })
+		}
+	}
+	return message, err
+}
diff --git a/dns/response_filter_test.go b/dns/response_filter_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e0204105844e86632ad1ae48506398226c98b1a3
--- /dev/null
+++ b/dns/response_filter_test.go
@@ -0,0 +1,178 @@
+package dns
+
+import (
+	"context"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/logger"
+)
+
+type responseFilterTransport struct {
+	TransportAdapter
+	response *mdns.Msg
+	calls    atomic.Int32
+}
+
+func (*responseFilterTransport) Start(adapter.StartStage) error { return nil }
+func (*responseFilterTransport) Close() error                   { return nil }
+func (*responseFilterTransport) Reset()                         {}
+func (t *responseFilterTransport) Exchange(ctx context.Context, query *mdns.Msg) (*mdns.Msg, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	t.calls.Add(1)
+	response := t.response.Copy()
+	response.Id, response.Question = query.Id, query.Question
+	return response, nil
+}
+func (t *responseFilterTransport) ExchangeAsync(ctx context.Context, query *mdns.Msg, callback func(*mdns.Msg, error)) {
+	callback(t.Exchange(ctx, query))
+}
+
+func responseFilterRR(t *testing.T, text string) mdns.RR {
+	t.Helper()
+	record, err := mdns.NewRR("example.test. 60 IN " + text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return record
+}
+
+func newResponseFilterRouter(t *testing.T, response *mdns.Msg, strategy C.DomainStrategy, qtype uint16) (*Router, *responseFilterTransport, *responseFilterTransport) {
+	t.Helper()
+	primary := &responseFilterTransport{TransportAdapter: NewTransportAdapter("tcp", "primary", nil), response: response}
+	fallbackResponse := FixedResponse(0, mdns.Question{Name: "example.test.", Qtype: qtype, Qclass: mdns.ClassINET}, []netip.Addr{netip.MustParseAddr("203.0.113.9"), netip.MustParseAddr("2001:db8:1::9")}, 60)
+	if qtype == mdns.TypeHTTPS {
+		fallbackResponse.Answer = []mdns.RR{responseFilterRR(t, "HTTPS 1 . ipv4hint=203.0.113.9")}
+	}
+	fallback := &responseFilterTransport{TransportAdapter: NewTransportAdapter("tcp", "secondary", nil), response: fallbackResponse}
+	filter := &option.DNSResponseFilter{DNSRule: option.DNSRule{Type: C.RuleTypeLogical, LogicalOptions: option.LogicalDNSRule{RawLogicalDNSRule: option.RawLogicalDNSRule{
+		Mode: C.LogicalTypeAnd,
+		Rules: []option.DNSRule{
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPAcceptAny: true}}},
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPCIDR: []string{"203.0.113.0/24", "2001:db8:1::/48"}}}},
+			{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{IPCIDR: []string{"203.0.113.8/32"}, Invert: true}}},
+		},
+	}}}}
+	raw := []option.DNSRule{
+		{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{DNSRuleAction: option.DNSRuleAction{Action: C.RuleActionTypeEvaluate, EvaluateOptions: option.DNSEvaluateActionOptions{Server: "primary", ResponseFilter: filter, ResponseIPAcceptAll: true}}}},
+		{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{RawDefaultDNSRule: option.RawDefaultDNSRule{MatchResponse: &option.DNSRuleMatchResponse{Enabled: true}}, DNSRuleAction: option.DNSRuleAction{Action: C.RuleActionTypeRespond}}},
+	}
+	router := &Router{ctx: context.Background(), logger: logger.NOP(), transport: &fallbackTransportManager{primary: primary, secondary: fallback}, defaultDomainStrategy: strategy, client: NewClient(ClientOptions{Context: context.Background(), Logger: logger.NOP()})}
+	for _, source := range raw {
+		rule, err := R.NewDNSRule(context.Background(), logger.NOP(), source, true, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := rule.Start(); err != nil {
+			t.Fatal(err)
+		}
+		router.rules = append(router.rules, rule)
+	}
+	t.Cleanup(func() {
+		if err := router.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return router, primary, fallback
+}
+
+func TestNativeResponseFilterChecksAllOriginalAddressesAndNegativeAnswers(t *testing.T) {
+	soa := "SOA ns.example.test. hostmaster.example.test. 1 60 60 60 60"
+	cases := []struct {
+		name     string
+		qtype    uint16
+		answers  []string
+		rcode    int
+		soa      bool
+		fallback bool
+		ipv4Only bool
+	}{
+		{name: "mixed-A", qtype: mdns.TypeA, answers: []string{"A 203.0.113.1", "A 198.51.100.1"}, fallback: true},
+		{name: "mixed-A-reversed", qtype: mdns.TypeA, answers: []string{"A 198.51.100.1", "A 203.0.113.1"}, fallback: true},
+		{name: "mixed-AAAA", qtype: mdns.TypeAAAA, answers: []string{"AAAA 2001:db8:1::1", "AAAA 2001:db8:2::1"}, fallback: true},
+		{name: "banned-inside-allow-set", qtype: mdns.TypeA, answers: []string{"A 203.0.113.1", "A 203.0.113.8"}, fallback: true},
+		{name: "HTTPS-hidden-invalid-IPv6-hint", qtype: mdns.TypeHTTPS, answers: []string{"HTTPS 1 . ipv4hint=203.0.113.1 ipv6hint=2001:db8:2::1"}, fallback: true, ipv4Only: true},
+		{name: "HTTPS-all-allowed", qtype: mdns.TypeHTTPS, answers: []string{"HTTPS 1 . ipv4hint=203.0.113.1 ipv6hint=2001:db8:1::1"}, ipv4Only: true},
+		{name: "NXDOMAIN", qtype: mdns.TypeA, rcode: mdns.RcodeNameError, soa: true},
+		{name: "NODATA", qtype: mdns.TypeA, soa: true},
+		{name: "empty-without-SOA", qtype: mdns.TypeA, fallback: true},
+		{name: "CNAME-without-address", qtype: mdns.TypeA, answers: []string{"CNAME target.example.test."}, soa: true, fallback: true},
+	}
+	for _, test := range cases {
+		cacheModes := []bool{false}
+		if len(test.answers) > 0 || test.soa {
+			cacheModes = append(cacheModes, true)
+		}
+		for _, cached := range cacheModes {
+			for _, async := range []bool{false, true} {
+				name := test.name
+				if cached {
+					name += "/cached"
+				} else {
+					name += "/fresh"
+				}
+				if async {
+					name += "/async"
+				} else {
+					name += "/sync"
+				}
+				t.Run(name, func(t *testing.T) {
+					response := &mdns.Msg{MsgHdr: mdns.MsgHdr{Response: true, Rcode: test.rcode}}
+					for _, answer := range test.answers {
+						response.Answer = append(response.Answer, responseFilterRR(t, answer))
+					}
+					if test.soa {
+						response.Ns = []mdns.RR{responseFilterRR(t, soa)}
+					}
+					strategy := C.DomainStrategyAsIS
+					if test.ipv4Only {
+						strategy = C.DomainStrategyIPv4Only
+					}
+					router, primary, fallback := newResponseFilterRouter(t, response, strategy, test.qtype)
+					query := new(mdns.Msg).SetQuestion("example.test.", test.qtype)
+					if cached {
+						if _, err := router.Exchange(context.Background(), query, adapter.DNSQueryOptions{Transport: primary}); err != nil {
+							t.Fatal(err)
+						}
+					}
+					var result *mdns.Msg
+					var err error
+					if async {
+						done := make(chan struct{})
+						router.ExchangeAsync(context.Background(), query, adapter.DNSQueryOptions{}, func(reply *mdns.Msg, failure error) { result, err = reply, failure; close(done) })
+						<-done
+					} else {
+						result, err = router.Exchange(context.Background(), query, adapter.DNSQueryOptions{})
+					}
+					if err != nil || result == nil {
+						t.Fatalf("response=%v error=%v", result, err)
+					}
+					if got := fallback.calls.Load() > 0; got != test.fallback {
+						t.Fatalf("fallback=%v want=%v response=%v", got, test.fallback, result)
+					}
+					if primary.calls.Load() != 1 {
+						t.Fatalf("primary queries=%d; cache must preserve and recheck original reply", primary.calls.Load())
+					}
+					if !test.fallback && result.Rcode != test.rcode {
+						t.Fatalf("negative rcode changed: %d", result.Rcode)
+					}
+					if test.ipv4Only {
+						for _, address := range MessageToAddresses(result) {
+							if address.Is6() {
+								t.Fatal("returned IPv6 hint despite IPv4-only strategy")
+							}
+						}
+					}
+				})
+			}
+		}
+	}
+}
