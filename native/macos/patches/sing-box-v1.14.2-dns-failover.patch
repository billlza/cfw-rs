diff --git a/dns/response_policy.go b/dns/response_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..bf31c98df42ec6bf4c4bd06cb4453de01d02d2c2
--- /dev/null
+++ b/dns/response_policy.go
@@ -0,0 +1,86 @@
+package dns
+
+import (
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	R "github.com/sagernet/sing-box/route/rule"
+	"net/netip"
+)
+
+// Recheck cached and fresh answers identically. Domain policies and live rule
+// resources can change which addresses are acceptable without changing the
+// resolver's tag. Valid negative answers must not become a retry or DNS leak.
+func responseIsRejected(response *dns.Msg, checker func([]netip.Addr) bool) bool {
+	if response == nil {
+		return true
+	}
+	if checker == nil {
+		return false
+	}
+	if response.Rcode == dns.RcodeNameError {
+		return false
+	}
+	if response.Rcode != dns.RcodeSuccess {
+		return true
+	}
+	if isNODATAResponse(response) {
+		return false
+	}
+	return !checker(MessageToAddresses(response))
+}
+
+func isNODATAResponse(response *dns.Msg) bool {
+	if response == nil || response.Rcode != dns.RcodeSuccess || len(response.Answer) != 0 {
+		return false
+	}
+	_, hasSOA := extractNegativeTTL(response)
+	return hasSOA
+}
+
+func evaluateResponseCheck(action *R.RuleActionEvaluate, metadata *adapter.InboundContext) func(*dns.Msg) bool {
+	if action.ResponseFilter == nil {
+		return nil
+	}
+	base := *metadata
+	return func(response *dns.Msg) bool {
+		return !responseIsRejected(response, func(addresses []netip.Addr) bool {
+			if action.ResponseIPAcceptAll {
+				for _, address := range addresses {
+					current := base
+					current.DNSResponseAddressOverride = []netip.Addr{address}
+					if !action.ResponseFilter.MatchAddressLimit(&current, response) {
+						return false
+					}
+				}
+				return len(addresses) > 0
+			}
+			current := base
+			current.DNSResponseAddressOverride = nil
+			return action.ResponseFilter.MatchAddressLimit(&current, response)
+		})
+	}
+}
+
+// A/AAAA can return joined errors. A terminal negative only suppresses retries
+// when every branch is negative; it must not hide an independent I/O failure.
+func onlyNegativeDNSResult(err error) bool {
+	if code, ok := err.(RcodeError); ok {
+		return int(code) == dns.RcodeNameError
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		children := joined.Unwrap()
+		if len(children) == 0 {
+			return false
+		}
+		for _, child := range children {
+			if !onlyNegativeDNSResult(child) {
+				return false
+			}
+		}
+		return true
+	}
+	if wrapped, ok := err.(interface{ Unwrap() error }); ok {
+		return onlyNegativeDNSResult(wrapped.Unwrap())
+	}
+	return false
+}
