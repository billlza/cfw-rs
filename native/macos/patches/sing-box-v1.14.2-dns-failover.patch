+func TestMultiplexerLifecycleCloseOwnsBlockedProbe(t *testing.T) {
+	for _, managerFirst := range []bool{false, true} {
+		t.Run(map[bool]string{false: "transport-first", true: "connection-manager-first"}[managerFirst], func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			manager := route.NewConnectionManager(nil)
+			entered, readDone := make(chan struct{}), make(chan struct{})
+			m := newQueryMultiplexer(queryMultiplexerOptions{
+				probeReuse: true,
+				dial:       func(context.Context) (net.Conn, error) { return manager.TrackConn(client), nil },
+				write:      func(net.Conn, *mDNS.Msg, uint16) error { return nil },
+				readNext: func(c net.Conn) (*mDNS.Msg, error) {
+					close(entered)
+					var data [1]byte
+					_, err := c.Read(data[:])
+					close(readDone)
+					return nil, err
+				},
+			})
+			m.maybeStartProbe(context.Background(), lifecycleQuery())
+			lifecycleAwait(t, entered, "probe entered Read")
+			if managerFirst {
+				if err := manager.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := m.Close(); err != nil {
+				t.Error(err)
+			}
+			select {
+			case <-readDone:
+			default:
+				t.Error("Close returned success before owned probe Read ended")
+			}
+			client.Close()
+			lifecycleAwait(t, readDone, "test cleanup ended Read")
+		})
+	}
+}
