+			DNSRuleAction:     option.DNSRuleAction{Action: C.RuleActionTypeEvaluate, EvaluateOptions: option.DNSEvaluateActionOptions{Server: "primary", ResponseFilter: filter, ResponseIPAcceptAll: true}},
+		}},
+		{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultDNSRule{
