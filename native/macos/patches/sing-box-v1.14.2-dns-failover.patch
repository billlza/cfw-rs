+	if err := m.Close(); err != nil {
+		t.Fatal(err)
+	}
+	before := m.reuseState.Load()
+	close(release)
+	lifecycleAwait(t, finished, "late result finished")
+	if got := m.reuseState.Load(); got != before {
+		t.Errorf("late probe published state %d after Close, before=%d", got, before)
+	}
