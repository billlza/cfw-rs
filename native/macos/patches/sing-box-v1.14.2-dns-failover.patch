diff --git a/dns/client_policy_dedup_test.go b/dns/client_policy_dedup_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..429e7203c5a28530cf3dbb8166cc2b988669ed2f
--- /dev/null
+++ b/dns/client_policy_dedup_test.go
@@ -0,0 +1,176 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	mdns "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/logger"
+)
+
+type policyGatedTransport struct {
+	TransportAdapter
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+	calls   atomic.Int32
+	answer  mdns.RR
+}
+
+func (*policyGatedTransport) Start(adapter.StartStage) error { return nil }
+func (*policyGatedTransport) Close() error                   { return nil }
+func (*policyGatedTransport) Reset()                         {}
+func (p *policyGatedTransport) unblock()                     { p.once.Do(func() { close(p.release) }) }
+func (p *policyGatedTransport) Exchange(ctx context.Context, query *mdns.Msg) (*mdns.Msg, error) {
+	p.calls.Add(1)
+	p.entered <- struct{}{}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-p.release:
+		response := new(mdns.Msg).SetReply(query)
+		response.Answer = []mdns.RR{mdns.Copy(p.answer)}
+		return response, nil
+	}
+}
+func (p *policyGatedTransport) ExchangeAsync(ctx context.Context, query *mdns.Msg, callback func(*mdns.Msg, error)) {
+	go func() { callback(p.Exchange(ctx, query)) }()
+}
+
+func newPolicyGatedTransport(t *testing.T) *policyGatedTransport {
+	t.Helper()
+	answer, err := mdns.NewRR("example.test. 60 IN HTTPS 1 . ipv4hint=203.0.113.1 ipv6hint=2001:db8:2::1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &policyGatedTransport{TransportAdapter: NewTransportAdapter("tcp", "gated", nil), entered: make(chan struct{}, 8), release: make(chan struct{}), answer: answer}
+	t.Cleanup(p.unblock)
+	return p
+}
+
+type policyExchangeResult struct {
+	response *mdns.Msg
+	err      error
+}
+
+func policyExchange(t *testing.T, client *Client, transport adapter.DNSTransport, ctx context.Context, options adapter.DNSQueryOptions, async bool) <-chan policyExchangeResult {
+	t.Helper()
+	done := make(chan policyExchangeResult, 1)
+	query := new(mdns.Msg).SetQuestion("example.test.", mdns.TypeHTTPS)
+	if async {
+		client.ExchangeAsync(ctx, transport, query, options, nil, func(response *mdns.Msg, err error) { done <- policyExchangeResult{response, err} })
+	} else {
+		go func() {
+			response, err := client.Exchange(ctx, transport, query, options, nil)
+			done <- policyExchangeResult{response, err}
+		}()
+	}
+	return done
+}
+
+func waitPolicySignal[T any](t *testing.T, ctx context.Context, channel <-chan T) T {
+	t.Helper()
+	select {
+	case value := <-channel:
+		return value
+	case <-ctx.Done():
+		t.Fatal("bounded DNS operation did not complete: ", ctx.Err())
+		var zero T
+		return zero
+	}
+}
+
+func TestDNSPolicyConcurrentTimeoutsKeepIndependentBudgets(t *testing.T) {
+	for _, async := range []bool{false, true} {
+		name := "sync"
+		if async {
+			name = "async"
+		}
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			transport := newPolicyGatedTransport(t)
+			client := NewClient(ClientOptions{Context: ctx, Logger: logger.NOP()})
+			short := policyExchange(t, client, transport, ctx, adapter.DNSQueryOptions{Timeout: time.Second}, async)
+			waitPolicySignal(t, ctx, transport.entered)
+			long := policyExchange(t, client, transport, ctx, adapter.DNSQueryOptions{Timeout: 5 * time.Second}, async)
+			waitPolicySignal(t, ctx, transport.entered)
+			select {
+			case result := <-short:
+				t.Fatalf("long query waited for the short budget instead of starting independently: %v", result.err)
+			default:
+			}
+			if result := waitPolicySignal(t, ctx, short); !errors.Is(result.err, context.DeadlineExceeded) {
+				t.Fatalf("short budget returned %v", result.err)
+			}
+			select {
+			case result := <-long:
+				t.Fatalf("short timeout completed the long query: %v", result.err)
+			default:
+			}
+			transport.unblock()
+			if result := waitPolicySignal(t, ctx, long); result.err != nil || result.response == nil {
+				t.Fatalf("long query failed: %v", result.err)
+			}
+			if transport.calls.Load() != 2 {
+				t.Fatalf("transport calls=%d, want 2", transport.calls.Load())
+			}
+		})
+	}
+}
+
+func TestDNSPolicyCancelledWaiterKeepsLeaderAndRawResponseChecks(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	transport := newPolicyGatedTransport(t)
+	client := NewClient(ClientOptions{Context: ctx, Logger: logger.NOP()})
+	options := adapter.DNSQueryOptions{Timeout: 5 * time.Second, Strategy: C.DomainStrategyIPv4Only, DisableRDRC: true}
+	leader := policyExchange(t, client, transport, ctx, options, true)
+	waitPolicySignal(t, ctx, transport.entered)
+	waiterContext, cancelWaiter := context.WithCancel(ctx)
+	defer cancelWaiter()
+	// ExchangeAsync performs beginExchange synchronously, so this call reaches
+	// the existing leader's dedup wait before cancellation is delivered.
+	waiter := policyExchange(t, client, transport, waiterContext, options, true)
+	cancelWaiter()
+	if result := waitPolicySignal(t, ctx, waiter); !errors.Is(result.err, context.Canceled) {
+		t.Fatalf("cancelled waiter returned %v", result.err)
+	}
+	select {
+	case result := <-leader:
+		t.Fatalf("waiter cancellation completed leader: %v", result.err)
+	default:
+	}
+	transport.unblock()
+	result := waitPolicySignal(t, ctx, leader)
+	if result.err != nil || result.response == nil {
+		t.Fatalf("leader failed: %v", result.err)
+	}
+	for _, address := range MessageToAddresses(result.response) {
+		if address.Is6() {
+			t.Fatal("leader did not apply IPv4-only response options")
+		}
+	}
+	checked := false
+	_, err := client.Exchange(ctx, transport, new(mdns.Msg).SetQuestion("example.test.", mdns.TypeHTTPS), options, func(response *mdns.Msg) bool {
+		checked = true
+		for _, address := range MessageToAddresses(response) {
+			if address.Is6() {
+				return false
+			}
+		}
+		return true
+	})
+	if !checked || !errors.Is(err, ErrResponseRejectedCached) {
+		t.Fatalf("cached original IPv6 hint bypassed the new predicate: checked=%v error=%v", checked, err)
+	}
+	if transport.calls.Load() != 1 {
+		t.Fatalf("dedup/cache issued %d queries, want 1", transport.calls.Load())
+	}
+}
