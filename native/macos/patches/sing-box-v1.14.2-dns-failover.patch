+	var reads int
+	m := newQueryMultiplexer(queryMultiplexerOptions{
+		probeReuse: true,
+		dial:       func(context.Context) (net.Conn, error) { return client, nil },
+		write:      func(net.Conn, *mDNS.Msg, uint16) error { return nil },
+		readNext: func(net.Conn) (*mDNS.Msg, error) {
