+func TestMultiplexerLifecycleCloseRejectsNewDial(t *testing.T) {
+	var dials atomic.Int32
+	m := newQueryMultiplexer(queryMultiplexerOptions{
+		probeReuse: true,
+		dial: func(context.Context) (net.Conn, error) {
+			dials.Add(1)
+			return nil, errors.New("unexpected dial")
+		},
+	})
+	if err := m.Close(); err != nil {
+		t.Fatal(err)
+	}
+	_, err := m.Exchange(context.Background(), lifecycleQuery())
+	if !errors.Is(err, net.ErrClosed) {
+		t.Errorf("closed Exchange returned %v, want net.ErrClosed", err)
+	}
+	// This is the already-queued probe entry, not a new public API.
+	m.runReuseProbe(context.Background(), "lifecycle.test.", 0)
+	if got := dials.Load(); got != 0 {
+		t.Errorf("closed instance admitted %d dials", got)
+	}
+}
