+	doh := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		m := new(mdns.Msg)
+		if err = m.Unpack(data); err != nil {
+			t.Error(err)
+			return
+		}
+		response := new(mdns.Msg)
+		response.SetReply(m)
+		rr, _ := mdns.NewRR(m.Question[0].Name + " 0 IN A 192.0.2.77")
+		response.Answer = []mdns.RR{rr}
+		data, _ = response.Pack()
+		w.Header().Set("Content-Type", "application/dns-message")
+		w.Write(data)
+	}))
+	defer doh.Close()
+	cert, _ := x509.ParseCertificate(doh.TLS.Certificates[0].Certificate[0])
+	certificate := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: cert.Raw}))
+	for _, wrong := range []bool{false, true} {
+		t.Run(fmt.Sprintf("wrong=%v", wrong), func(t *testing.T) {
+			name := cert.DNSNames[0]
+			if wrong {
+				name = "wrong.invalid"
+			}
+			endpoint := map[string]any{"type": "https", "tag": "secure", "server": "resolver.example", "server_port": doh.Listener.Addr().(*net.TCPAddr).Port, "path": "/dns-query", "domain_resolver": map[string]any{"server": "bootstrap"}, "tls": map[string]any{"enabled": true, "server_name": name, "certificate": []string{certificate}}}
+			config := map[string]any{"log": map[string]any{"disabled": true}, "dns": map[string]any{"servers": []any{policyTCP("bootstrap", bootstrap), endpoint}, "final": "secure"}, "outbounds": []any{map[string]any{"type": "direct", "tag": "direct"}}, "route": map[string]any{"default_domain_resolver": map[string]any{"server": "secure"}}}
+			if wrong {
+				backup := make(map[string]any)
+				for key, value := range endpoint {
+					backup[key] = value
+				}
+				backup["tag"] = "backup"
+				dnsConfig := config["dns"].(map[string]any)
+				dnsConfig["servers"] = append(dnsConfig["servers"].([]any), backup)
+				dnsConfig["rules"] = []any{map[string]any{"ip_accept_any": true, "action": "route", "server": "secure"}}
+				dnsConfig["final"] = "backup"
+			}
+			router, _ := startPolicyBox(t, config)
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			response, err := router.Exchange(ctx, policyQuestion("doh-test.example"), adapter.DNSQueryOptions{})
+			if wrong {
+				if err == nil {
+					t.Fatal("wrong TLS identity succeeded")
+				}
+			} else if err != nil || len(response.Answer) != 1 {
+				t.Fatalf("valid DoH failed: %v", err)
+			}
+			if _, ok := seen.Load("resolver.example."); !ok {
+				t.Fatal("bootstrap not used")
+			}
+		})
+	}
+}
+func TestRuntimeCFMProjectedMixedAndTunnelDNSPolicies(t *testing.T) {
+	dir := os.Getenv("CFW_DNS_PROJECTED_FIXTURE_DIR")
+	if dir == "" {
+		t.Skip("Rust projection fixtures not supplied")
+	}
+	for _, file := range []string{"mixed.json", "tunnel.json", "named.json"} {
+		t.Run(file, func(t *testing.T) {
+			data, err := os.ReadFile(filepath.Join(dir, file))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var config map[string]any
+			if err = json.Unmarshal(data, &config); err != nil {
+				t.Fatal(err)
+			}
+			delete(config, "experimental")
+			config["log"] = map[string]any{"disabled": true}
+			proxyPort := localPolicySOCKS(t)
+			observed := map[string]*sync.Map{}
+			dns := config["dns"].(map[string]any)
+			for _, raw := range dns["servers"].([]any) {
+				server := raw.(map[string]any)
+				tag := server["tag"].(string)
+				port, seen := startPolicyTCP(t, tag == "cfw-profile-dns-0" || tag == "cfw-profile-dns-1", "127.0.0.1")
+				observed[tag] = seen
+				server["server"] = "127.0.0.1"
+				server["type"] = "tcp"
+				server["server_port"] = port
+			}
+			config["outbounds"].([]any)[0].(map[string]any)["server_port"] = proxyPort
+			if file == "tunnel.json" {
+				delete(config, "inbounds")
+			} else {
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				port := listener.Addr().(*net.TCPAddr).Port
+				listener.Close()
+				config["inbounds"].([]any)[0].(map[string]any)["listen_port"] = port
+			}
+			router, _ := startPolicyBox(t, config)
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			for _, name := range []string{"special.example.org", "child.example.org", "ordinary.example.net"} {
+				response, err := router.Exchange(ctx, policyQuestion(name), adapter.DNSQueryOptions{})
+				if err != nil || len(response.Answer) != 1 {
+					t.Fatalf("%s: %v", name, err)
+				}
+			}
+			for _, qtype := range []uint16{mdns.TypeTXT, mdns.TypeHTTPS, mdns.TypeMX} {
+				name := fmt.Sprintf("pool-%d.example.net.", qtype)
+				message := new(mdns.Msg).SetQuestion(name, qtype)
+				response, err := router.Exchange(ctx, message, adapter.DNSQueryOptions{})
+				if err != nil || response.Rcode != mdns.RcodeSuccess || len(response.Answer) != 1 {
+					t.Fatalf("type %d: %v", qtype, err)
+				}
+				for _, tag := range []string{"cfw-profile-dns-0", "cfw-profile-dns-1", "cfw-profile-dns-2"} {
+					if _, ok := observed[tag].Load(name); !ok {
+						t.Errorf("type %d skipped resolver %s", qtype, tag)
+					}
+				}
+			}
+			for tag, name := range map[string]string{"cfw-policy-dns-1-0": "special.example.org.", "cfw-policy-dns-0-0": "child.example.org.", "cfw-profile-dns-2": "ordinary.example.net.", "cfw-proxy-server-dns-0": "node.example.com."} {
+				if _, ok := observed[tag].Load(name); !ok {
+					t.Errorf("%s missing from %s", name, tag)
+				}
+			}
+			if file != "tunnel.json" {
+				target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("policy-ok")) }))
+				defer target.Close()
+				_, targetPort, _ := net.SplitHostPort(target.Listener.Addr().String())
+				port := config["inbounds"].([]any)[0].(map[string]any)["listen_port"].(int)
+				proxyURL, _ := url.Parse(fmt.Sprintf("http://127.0.0.1:%d", port))
+				transport := &http.Transport{Proxy: http.ProxyURL(proxyURL)}
+				defer transport.CloseIdleConnections()
+				client := &http.Client{Transport: transport, Timeout: 2 * time.Second}
+				names := []string{"special.example.org", "direct.example.com"}
+				if file == "named.json" {
+					names = append(names, "direct.example.org")
+				}
+				for _, name := range names {
+					response, err := client.Get("http://" + net.JoinHostPort(name, targetPort))
+					if err != nil {
+						t.Fatal(err)
+					}
+					body, _ := io.ReadAll(response.Body)
+					response.Body.Close()
+					if string(body) != "policy-ok" {
+						t.Fatal("wrong response")
+					}
+				}
+				if file == "named.json" {
+					if _, seen := observed["cfw-policy-dns-0-0"].Load("direct.example.org."); !seen {
+						t.Fatal("direct follow-policy skipped the matching domain policy")
+					}
+					if _, seen := observed["cfw-direct-dns-0"].Load("direct.example.org."); seen {
+						t.Fatal("direct follow-policy ignored its domain policy")
+					}
+				}
+				if _, ok := observed["cfw-direct-dns-0"].Load("direct.example.com."); !ok {
+					t.Fatal("direct resolver unused")
+				}
+				for tag, seen := range observed {
+					if tag == "cfw-direct-dns-0" {
+						continue
+					}
+					if _, ok := seen.Load("direct.example.com."); ok {
+						t.Fatalf("direct query leaked to %s", tag)
+					}
+				}
+			}
+		})
+	}
+}
