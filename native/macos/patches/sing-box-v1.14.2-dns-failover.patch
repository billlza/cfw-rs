+func TestMultiplexerLifecycleConcurrentCloseWaitsSameResult(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	m := newQueryMultiplexer(queryMultiplexerOptions{
+		probeReuse: true,
+		dial: func(context.Context) (net.Conn, error) {
+			close(entered)
+			<-release
+			return nil, errors.New("dial released")
+		},
+	})
+	m.maybeStartProbe(context.Background(), lifecycleQuery())
+	lifecycleAwait(t, entered, "uncooperative dial entered")
+	results := make(chan error, 2)
+	var start sync.WaitGroup
+	start.Add(2)
+	for range 2 {
+		go func() { start.Done(); start.Wait(); results <- m.Close() }()
+	}
+	first, second := <-results, <-results
+	if first == nil || second == nil {
+		t.Error("Close reported success with a still-running dial")
+	}
+	if first != second {
+		t.Errorf("concurrent Close results differ: %v / %v", first, second)
+	}
+	close(release)
+	lifecycleAwait(t, m.cleanupDone, "late dial cleanup completion after retained timeout")
+	if later := m.Close(); later != first {
+		t.Errorf("idempotent Close result changed: %v / %v", first, later)
+	}
+}
