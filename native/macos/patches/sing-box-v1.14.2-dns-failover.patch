+func lifecycleAwait(t *testing.T, done <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(7 * time.Second):
+		t.Fatal("bounded wait expired: ", what)
+	}
+}
