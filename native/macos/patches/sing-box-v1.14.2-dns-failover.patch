+func TestShouldContinueDNSRule(t *testing.T) {
+	t.Parallel()
+
+	transportError := errors.New("transport unavailable")
+	if !shouldContinueDNSRule(context.Background(), true, transportError, 1) {
+		t.Fatal("an eligible rule must fall through after a transport error")
+	}
+	if shouldContinueDNSRule(context.Background(), false, transportError, 1) {
+		t.Fatal("a rule without response fallback must retain its transport error")
+	}
+	if shouldContinueDNSRule(context.Background(), true, nil, 1) {
+		t.Fatal("a successful exchange must never fall through")
+	}
+	if shouldContinueDNSRule(context.Background(), true, transportError, maxDNSAttempts) {
+		t.Fatal("the global attempt budget must stop a third transport attempt")
+	}
+
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if shouldContinueDNSRule(cancelled, true, transportError, 1) {
+		t.Fatal("caller cancellation must stop fallback immediately")
+	}
+	deadline, cancelDeadline := context.WithDeadline(context.Background(), time.Unix(0, 0))
+	defer cancelDeadline()
+	if shouldContinueDNSRule(deadline, true, transportError, 1) {
+		t.Fatal("caller deadline must stop fallback immediately")
+	}
+}
