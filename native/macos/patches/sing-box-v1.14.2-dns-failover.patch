+)
+
+func TestExchangeDNSRuleFallback(t *testing.T) {
+	t.Run("transport error reaches secondary", func(t *testing.T) {
+		primaryError := errors.New("primary unavailable")
+		client := newFallbackDNSClient()
+		client.exchangeErrors["primary"] = primaryError
+		router := newFallbackRouter(t, client)
+
+		response, err := router.Exchange(context.Background(), testDNSQuestion(mDNS.TypeA), adapter.DNSQueryOptions{})
+		if err != nil {
+			t.Fatalf("exchange failed: %v", err)
+		}
+		if response == nil || client.exchangeCalls["primary"] != 1 || client.exchangeCalls["secondary"] != 1 {
+			t.Fatalf("unexpected fallback calls: %#v", client.exchangeCalls)
+		}
+	})
+
+	t.Run("accepted response does not reach secondary", func(t *testing.T) {
+		client := newFallbackDNSClient()
+		router := newFallbackRouter(t, client)
+
+		_, err := router.Exchange(context.Background(), testDNSQuestion(mDNS.TypeA), adapter.DNSQueryOptions{})
+		if err != nil {
+			t.Fatalf("exchange failed: %v", err)
+		}
+		if client.exchangeCalls["primary"] != 1 || client.exchangeCalls["secondary"] != 0 {
+			t.Fatalf("unexpected success calls: %#v", client.exchangeCalls)
+		}
+	})
+
+	t.Run("rejected response reaches secondary", func(t *testing.T) {
+		client := newFallbackDNSClient()
+		client.exchangeErrors["primary"] = ErrResponseRejected
+		router := newFallbackRouter(t, client)
+
+		_, err := router.Exchange(context.Background(), testDNSQuestion(mDNS.TypeA), adapter.DNSQueryOptions{})
+		if err != nil {
+			t.Fatalf("exchange failed: %v", err)
+		}
+		if client.exchangeCalls["primary"] != 1 || client.exchangeCalls["secondary"] != 1 {
+			t.Fatalf("unexpected rejection calls: %#v", client.exchangeCalls)
+		}
+	})
+
+	t.Run("caller cancellation stops fallback", func(t *testing.T) {
+		primaryError := errors.New("primary unavailable")
