+	if _, _, _, err := m.connection.AcquireShared(context.Background(), func(context.Context) (*multiplexConn, error) {
+		return &multiplexConn{Conn: gate}, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	results := make(chan error, 2)
+	started := time.Now()
+	go func() { results <- m.Close() }()
+	lifecycleAwait(t, gate.entered, "pool Close entered blocking net.Conn.Close")
+	go func() { results <- m.Close() }()
+	observed := make([]error, 0, 2)
+	deadline := time.NewTimer(6 * time.Second)
+	defer deadline.Stop()
+	for len(observed) < 2 {
+		select {
+		case err := <-results:
+			observed = append(observed, err)
+			if err == nil {
+				t.Error("Close reported success while pool socket Close remained blocked")
+			}
+		case <-deadline.C:
+			t.Error("pool Close escaped the shared five-second result budget")
+			goto release
+		}
+	}
+	if observed[0] != observed[1] {
+		t.Error("concurrent Close returned different timeout results")
+	}
+	t.Logf("pool_close_timeout_elapsed=%s", time.Since(started))
+release:
+	var timeoutEvidence interface {
+		CleanupDone() <-chan struct{}
+		CleanupResult() (bool, error)
+	}
+	if len(observed) == 2 {
+		var ok bool
+		timeoutEvidence, ok = observed[0].(interface {
+			CleanupDone() <-chan struct{}
+			CleanupResult() (bool, error)
+		})
+		if !ok {
+			t.Error("timeout result lost the pending cleanup evidence")
+		} else {
+			if complete, err := timeoutEvidence.CleanupResult(); complete || err != observed[0] {
+				t.Error("pending cleanup result appeared successful")
+			}
+			if timeoutEvidence.CleanupDone() != m.cleanupDone {
+				t.Error("timeout evidence refers to a different cleanup")
+			}
+		}
+		select {
+		case <-m.cleanupDone:
+			t.Error("blocked cleanup was marked complete")
+		default:
+		}
+		if phase := m.cleanupPhase.Load(); phase != 1 {
+			t.Errorf("expected pending pool-close phase, got %d", phase)
+		}
+	}
+	close(gate.release)
+	for len(observed) < 2 {
+		select {
+		case err := <-results:
+			observed = append(observed, err)
+		case <-time.After(time.Second):
+			t.Fatal("Close did not finish after releasing the pool socket")
+		}
+	}
+	lifecycleAwait(t, m.cleanupDone, "released pool cleanup completion")
+	if phase := m.cleanupPhase.Load(); phase != 3 {
+		t.Errorf("late cleanup did not record completion: %d", phase)
+	}
+	if m.cleanupErr != nil {
+		t.Errorf("late pool cleanup error: %v", m.cleanupErr)
+	}
+	if timeoutEvidence != nil {
+		if complete, err := timeoutEvidence.CleanupResult(); !complete || err != nil {
+			t.Errorf("late cleanup result not retained: complete=%v err=%v", complete, err)
+		}
+	}
+	if later := m.Close(); later != observed[0] {
+		t.Error("late cleanup changed the first Close result")
+	}
+}
