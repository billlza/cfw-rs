+package rule
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// The response predicate shares the parent's lifetime, including rule-set
+// references. Its action never participates in query routing.
+type responseFilteredDNSRule struct {
+	adapter.DNSRule
+	filter adapter.DNSRule
+}
+
+func (r *responseFilteredDNSRule) Start() error {
+	if err := r.DNSRule.Start(); err != nil {
+		return err
+	}
+	return r.filter.Start()
+}
+
+func (r *responseFilteredDNSRule) Close() error {
+	return E.Errors(r.DNSRule.Close(), r.filter.Close())
+}
