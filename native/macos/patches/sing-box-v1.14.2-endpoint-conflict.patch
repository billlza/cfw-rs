diff --git a/common/listener/loopback_share_darwin.go b/common/listener/loopback_share_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..77799172215a4a66cdca9b5e5a6ada8f93ff39c1
--- /dev/null
+++ b/common/listener/loopback_share_darwin.go
@@ -0,0 +1,68 @@
+package listener
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"syscall"
+
+	"github.com/sagernet/sing/common/control"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"golang.org/x/sys/unix"
+)
+
+// ErrLoopbackReuseAddr rejects reuse_addr on a loopback TCP listener. Such a
+// listener carries SO_REUSESHAREUID, which leaves the exact-address bind check
+// as the only guard against another user taking over the live port, and
+// SO_REUSEPORT would bypass that check.
+var ErrLoopbackReuseAddr = E.New("reuse_addr is not allowed on a loopback listener")
+
+// ShareLoopbackPortAcrossUsers returns a listen control that sets
+// SO_REUSESHAREUID on sockets bound to a loopback address.
+//
+// XNU refuses a non-root bind while a socket owned by another user holds the
+// same local address and port, even with SO_REUSEADDR, unless that socket
+// carries SO_REUSESHAREUID. The root packet tunnel and the user proxy agent
+// serve the same loopback endpoints, so the connected and TIME_WAIT sockets the
+// tunnel leaves behind would push the agent to another port for 2*MSL.
+// Accepted sockets inherit the flag from the listener. A live listener still
+// refuses the bind through the exact-address check unless it also has
+// SO_REUSEPORT, which ListenTCP therefore refuses for loopback listeners.
+func ShareLoopbackPortAcrossUsers() control.Func {
+	return func(network, address string, conn syscall.RawConn) error {
+		loopback, err := isLoopbackListenAddress(address)
+		if err != nil {
+			return err
+		}
+		if !loopback {
+			return nil
+		}
+		return control.Raw(conn, func(fd uintptr) error {
+			return os.NewSyscallError("setsockopt SO_REUSESHAREUID", unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSESHAREUID, 1))
+		})
+	}
+}
+
+func isLoopbackListenAddress(address string) (bool, error) {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return false, E.Cause(err, "parse listen address")
+	}
+	if host == "" {
+		return false, nil
+	}
+	addr, err := netip.ParseAddr(host)
+	if err != nil {
+		return false, E.Cause(err, "parse listen address")
+	}
+	return addr.IsLoopback(), nil
+}
+
+func rejectLoopbackReuseAddr(bindAddr M.Socksaddr) error {
+	if bindAddr.Addr.IsLoopback() {
+		return E.Cause(ErrLoopbackReuseAddr, "listen ", bindAddr)
+	}
+	return nil
+}
diff --git a/common/listener/loopback_share_darwin_test.go b/common/listener/loopback_share_darwin_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..92005b625f3531a75d084f038979373bb578e76e
--- /dev/null
+++ b/common/listener/loopback_share_darwin_test.go
@@ -0,0 +1,201 @@
+package listener
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/control"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"golang.org/x/sys/unix"
+)
+
+func reuseShareUID(t *testing.T, conn syscall.Conn) int {
+	t.Helper()
+	value, err := control.Conn0[int](conn, func(fd uintptr) (int, error) {
+		return unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSESHAREUID)
+	})
+	if err != nil {
+		t.Fatalf("getsockopt SO_REUSESHAREUID: %v", err)
+	}
+	return value
+}
+
+func listenOn(address netip.Addr) option.ListenOptions {
+	listen := badoption.Addr(address)
+	return option.ListenOptions{Listen: &listen}
+}
+
+func newTCPListener(listen option.ListenOptions) *Listener {
+	return New(Options{
+		Context: context.Background(),
+		Logger:  log.NewNOPFactory().NewLogger("listener"),
+		Network: []string{N.NetworkTCP},
+		Listen:  listen,
+	})
+}
+
+func TestLoopbackTCPListenerSharesPortAcrossUsers(t *testing.T) {
+	fastOpen := listenOn(netip.MustParseAddr("127.0.0.1"))
+	fastOpen.TCPFastOpen = true
+	for _, test := range []struct {
+		name   string
+		listen option.ListenOptions
+	}{
+		{"127.0.0.1", listenOn(netip.MustParseAddr("127.0.0.1"))},
+		{"::1", listenOn(netip.IPv6Loopback())},
+		{"127.0.0.1 TCP Fast Open", fastOpen},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			tcpListener, err := newTCPListener(test.listen).ListenTCP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer tcpListener.Close()
+			if reuseShareUID(t, tcpListener.(*net.TCPListener)) == 0 {
+				t.Fatal("loopback listener lacks SO_REUSESHAREUID")
+			}
+			client, err := net.Dial(N.NetworkTCP, tcpListener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			accepted, err := tcpListener.Accept()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer accepted.Close()
+			// The tunnel's lingering sockets are accepted ones, so the flag must
+			// be inherited from the listener.
+			if reuseShareUID(t, accepted.(*net.TCPConn)) == 0 {
+				t.Fatal("accepted loopback connection lacks SO_REUSESHAREUID")
+			}
+		})
+	}
+}
+
+func TestShareLoopbackPortAcrossUsersOnlyMarksLoopbackAddresses(t *testing.T) {
+	// Listening on a non-loopback address can raise the macOS firewall prompt,
+	// so the decision is checked on unbound sockets. The addresses have the form
+	// net.ListenConfig passes to Control: a literal IP, or an empty host for a
+	// wildcard listen, never a host name.
+	for _, test := range []struct {
+		family  int
+		address string
+		shared  bool
+	}{
+		{unix.AF_INET, "127.0.0.1:7890", true},
+		{unix.AF_INET, "127.8.9.10:0", true},
+		{unix.AF_INET6, "[::1]:9090", true},
+		{unix.AF_INET6, "[::ffff:127.0.0.1]:7890", true},
+		{unix.AF_INET, "0.0.0.0:7890", false},
+		{unix.AF_INET6, ":7890", false},
+		{unix.AF_INET6, "[::]:9090", false},
+		{unix.AF_INET, "192.0.2.10:7890", false},
+		{unix.AF_INET6, "[fe80::1%lo0]:7890", false},
+	} {
+		t.Run(test.address, func(t *testing.T) {
+			socket := newUnboundSocket(t, test.family)
+			defer socket.Close()
+			rawConn, err := socket.SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			err = ShareLoopbackPortAcrossUsers()(N.NetworkTCP, test.address, rawConn)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if shared := reuseShareUID(t, socket) != 0; shared != test.shared {
+				t.Fatalf("SO_REUSESHAREUID set=%v, want %v", shared, test.shared)
+			}
+		})
+	}
+}
+
+func TestShareLoopbackPortAcrossUsersReportsFailures(t *testing.T) {
+	socket := newUnboundSocket(t, unix.AF_INET)
+	defer socket.Close()
+	rawConn, err := socket.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = ShareLoopbackPortAcrossUsers()(N.NetworkTCP, "localhost:7890", rawConn)
+	if err == nil {
+		t.Fatal("unresolved listen address was accepted")
+	}
+	if reuseShareUID(t, socket) != 0 {
+		t.Fatal("unresolved listen address set SO_REUSESHAREUID")
+	}
+
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	defer writer.Close()
+	rawPipe, err := reader.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = ShareLoopbackPortAcrossUsers()(N.NetworkTCP, "127.0.0.1:7890", rawPipe)
+	if !errors.Is(err, unix.ENOTSOCK) {
+		t.Fatalf("setsockopt failure was not reported: %v", err)
+	}
+	if errors.Is(err, syscall.EADDRINUSE) {
+		t.Fatalf("setsockopt failure looks like an endpoint conflict: %v", err)
+	}
+}
+
+func TestLoopbackTCPListenerRejectsReuseAddr(t *testing.T) {
+	for _, address := range []netip.Addr{
+		netip.MustParseAddr("127.0.0.1"),
+		netip.IPv6Loopback(),
+		netip.MustParseAddr("::ffff:127.0.0.1"),
+	} {
+		t.Run(address.String(), func(t *testing.T) {
+			listen := listenOn(address)
+			listen.ReuseAddr = true
+			listener := newTCPListener(listen)
+			tcpListener, err := listener.ListenTCP()
+			if tcpListener != nil {
+				tcpListener.Close()
+			}
+			if !errors.Is(err, ErrLoopbackReuseAddr) {
+				t.Fatalf("loopback reuse_addr was not rejected: %v", err)
+			}
+			if errors.Is(err, syscall.EADDRINUSE) {
+				t.Fatalf("reuse_addr rejection looks like an endpoint conflict: %v", err)
+			}
+			if tcpListener != nil || listener.TCPListener() != nil {
+				t.Fatal("rejected listener was bound")
+			}
+		})
+	}
+	for _, address := range []netip.Addr{
+		netip.IPv4Unspecified(),
+		netip.IPv6Unspecified(),
+		netip.MustParseAddr("192.0.2.10"),
+	} {
+		if err := rejectLoopbackReuseAddr(M.SocksaddrFrom(address, 7890)); err != nil {
+			t.Fatalf("reuse_addr on %s was rejected: %v", address, err)
+		}
+	}
+}
+
+func newUnboundSocket(t *testing.T, family int) *os.File {
+	t.Helper()
+	fd, err := unix.Socket(family, unix.SOCK_STREAM, unix.IPPROTO_TCP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return os.NewFile(uintptr(fd), "socket")
+}
