@@ -0,0 +1,35 @@
+package mixed
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+func TestClassifyMixedListenError(t *testing.T) {
+	cause := fmt.Errorf("listen failed: %w", syscall.EADDRINUSE)
+	err := classifyMixedListenError(7892, cause)
+	role, port, ok := adapter.EndpointConflictFromError(err)
+	if !ok || role != adapter.EndpointConflictMixed || port != 7892 || !errors.Is(err, cause) {
+		t.Fatalf("unexpected mixed conflict: role=%v port=%d ok=%v err=%v", role, port, ok, err)
+	}
+}
+
+func TestClassifyMixedListenErrorRejectsOtherAndMalformedErrors(t *testing.T) {
+	ordinary := errors.New("permission denied")
+	for _, test := range []struct {
+		port uint16
+		err  error
+	}{
+		{7892, ordinary},
+		{0, syscall.EADDRINUSE},
+	} {
+		classified := classifyMixedListenError(test.port, test.err)
+		if classified != test.err {
+			t.Fatalf("unexpected classification for port %d: %v", test.port, classified)
+		}
+	}
+}
