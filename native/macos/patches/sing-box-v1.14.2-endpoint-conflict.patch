index 0000000000000000000000000000000000000000..af7ffce8767178b4a9eff5b3c17a24750be47427
--- /dev/null
+++ b/adapter/endpoint_conflict.go
@@ -0,0 +1,54 @@
+package adapter
+
+import "errors"
+
+type EndpointConflictRole int32
+
+const (
+	EndpointConflictNone EndpointConflictRole = iota
+	EndpointConflictMixed
+	EndpointConflictController
+)
+
+type EndpointConflictError struct {
+	role  EndpointConflictRole
+	port  uint16
+	cause error
+}
+
+func (e *EndpointConflictError) Error() string {
+	if e == nil || e.cause == nil {
+		return "endpoint conflict has no cause"
+	}
+	return e.cause.Error()
+}
+
+func (e *EndpointConflictError) Unwrap() error {
+	if e == nil {
+		return nil
+	}
+	return e.cause
+}
+
+func NewEndpointConflictError(role EndpointConflictRole, port uint16, err error) error {
+	if err == nil {
+		return errors.New("endpoint conflict cause is required")
+	}
+	if port == 0 {
+		return errors.New("endpoint conflict port is required")
+	}
+	switch role {
+	case EndpointConflictMixed, EndpointConflictController:
+	default:
+		return errors.New("endpoint conflict role is invalid")
+	}
+	return &EndpointConflictError{role: role, port: port, cause: err}
+}
+
+func EndpointConflictFromError(err error) (EndpointConflictRole, uint16, bool) {
+	var conflict *EndpointConflictError
+	if errors.As(err, &conflict) && conflict != nil && conflict.cause != nil {
+		return conflict.role, conflict.port, true
+	}
+	return EndpointConflictNone, 0, false
+}
diff --git a/adapter/endpoint_conflict_test.go b/adapter/endpoint_conflict_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8685643aceb8cea919b3eeccd6910868284d5c49
--- /dev/null
+++ b/adapter/endpoint_conflict_test.go
@@ -0,0 +1,39 @@
+package adapter
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+)
+
+func TestEndpointConflictRoleSurvivesWrapping(t *testing.T) {
+	err := fmt.Errorf("start mixed inbound: %w", NewEndpointConflictError(EndpointConflictMixed, 7891, syscall.EADDRINUSE))
+	role, port, ok := EndpointConflictFromError(err)
+	if !ok || role != EndpointConflictMixed || port != 7891 {
+		t.Fatalf("unexpected conflict: role=%v port=%d ok=%v", role, port, ok)
+	}
+	if !errors.Is(err, syscall.EADDRINUSE) {
+		t.Fatal("wrapped conflict lost EADDRINUSE")
+	}
+}
+
+func TestUnclassifiedAddressInUseIsNotAConflict(t *testing.T) {
+	role, port, ok := EndpointConflictFromError(syscall.EADDRINUSE)
+	if ok || role != EndpointConflictNone || port != 0 {
+		t.Fatalf("bare errno was classified as a product endpoint: role=%v port=%d ok=%v", role, port, ok)
+	}
+}
+
+func TestInvalidEndpointConflictsAreNotClassified(t *testing.T) {
+	for _, err := range []error{
+		NewEndpointConflictError(EndpointConflictMixed, 7890, nil),
+		NewEndpointConflictError(EndpointConflictNone, 7890, syscall.EADDRINUSE),
+		NewEndpointConflictError(EndpointConflictMixed, 0, syscall.EADDRINUSE),
+	} {
+		role, port, ok := EndpointConflictFromError(err)
+		if ok || role != EndpointConflictNone || port != 0 {
+			t.Fatalf("invalid conflict was classified: role=%v port=%d ok=%v", role, port, ok)
+		}
+	}
+}
