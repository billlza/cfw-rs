+package libbox
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+func TestRuntimeStartConflictPreservesExactRoleAndPort(t *testing.T) {
+	err := fmt.Errorf(
+		"start service: %w",
+		adapter.NewEndpointConflictError(adapter.EndpointConflictController, 9092, syscall.EADDRINUSE),
+	)
+	conflict := runtimeStartConflict(err)
+	if conflict == nil || conflict.Kind != RuntimeEndpointConflictController || conflict.Port != 9092 {
+		t.Fatalf("unexpected runtime conflict: %#v", conflict)
+	}
+}
+
+func TestRuntimeStartConflictRejectsOrdinaryAndMalformedErrors(t *testing.T) {
+	for _, err := range []error{
+		syscall.EADDRINUSE,
+		errors.New("ordinary startup failure"),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, errors.New("wrong cause")),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, nil),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictNone, 9090, syscall.EADDRINUSE),
+		adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 0, syscall.EADDRINUSE),
+		E.Errors(
+			adapter.NewEndpointConflictError(adapter.EndpointConflictMixed, 7890, syscall.EADDRINUSE),
+			errors.New("cleanup failed"),
+		),
+	} {
+		if conflict := runtimeStartConflict(err); conflict != nil {
+			t.Fatalf("unexpected retryable conflict for %v: %#v", err, conflict)
+		}
+	}
+}
