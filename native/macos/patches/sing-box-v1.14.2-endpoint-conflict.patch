+package mixed
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/control"
+	"github.com/sagernet/sing/common/json/badoption"
+
+	"golang.org/x/sys/unix"
+)
+
+func startLoopbackMixedInbound(t *testing.T, port uint16) (*Inbound, error) {
+	t.Helper()
+	listen := badoption.Addr(netip.MustParseAddr("127.0.0.1"))
+	created, err := NewInbound(context.Background(), nil, log.NewNOPFactory().NewLogger("mixed"), "mixed", option.HTTPMixedInboundOptions{
+		ListenOptions: option.ListenOptions{Listen: &listen, ListenPort: port},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	inbound := created.(*Inbound)
+	return inbound, inbound.Start(adapter.StartStateStart)
+}
+
+func TestLiveSharedLoopbackMixedListenerStillConflicts(t *testing.T) {
+	first, err := startLoopbackMixedInbound(t, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	tcpListener := first.listener.TCPListener().(*net.TCPListener)
+	shared, err := control.Conn0[int](tcpListener, func(fd uintptr) (int, error) {
+		return unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSESHAREUID)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if shared == 0 {
+		t.Fatal("mixed loopback listener lacks SO_REUSESHAREUID")
+	}
+	port := uint16(tcpListener.Addr().(*net.TCPAddr).Port)
+
+	second, err := startLoopbackMixedInbound(t, port)
+	defer second.Close()
+	role, conflictPort, ok := adapter.EndpointConflictFromError(err)
+	if !ok || role != adapter.EndpointConflictMixed || conflictPort != port || !errors.Is(err, syscall.EADDRINUSE) {
+		t.Fatalf("live shared listener did not conflict: role=%v port=%d ok=%v err=%v", role, conflictPort, ok, err)
+	}
+}
