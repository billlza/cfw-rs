+++ b/experimental/clashapi/controller_listen.go
@@ -0,0 +1,14 @@
+package clashapi
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/common/listener"
+)
+
+// listenController applies the inbound loopback port sharing to the controller.
+func listenController(ctx context.Context, address string) (net.Listener, error) {
+	listenConfig := net.ListenConfig{Control: listener.ShareLoopbackPortAcrossUsers()}
+	return listenConfig.Listen(ctx, "tcp", address)
+}
diff --git a/experimental/clashapi/endpoint_conflict_darwin_test.go b/experimental/clashapi/endpoint_conflict_darwin_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c2c8127377573e72719f6593fdcded7d17f731b6
--- /dev/null
+++ b/experimental/clashapi/endpoint_conflict_darwin_test.go
@@ -0,0 +1,127 @@
+package clashapi
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/common/control"
+
+	"golang.org/x/sys/unix"
+)
+
+func reuseShareUID(conn syscall.Conn) (int, error) {
+	return control.Conn0[int](conn, func(fd uintptr) (int, error) {
+		return unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSESHAREUID)
+	})
+}
+
+func newControllerServer(address string) *Server {
+	return &Server{
+		ctx:                context.Background(),
+		logger:             log.NewNOPFactory().NewLogger("clash-api"),
+		httpServer:         &http.Server{Addr: address, Handler: http.NotFoundHandler()},
+		externalController: true,
+	}
+}
+
+func TestControllerLoopbackListenerSharesPortAcrossUsers(t *testing.T) {
+	for _, address := range []string{"127.0.0.1:0", "[::1]:0", "localhost:0"} {
+		t.Run(address, func(t *testing.T) {
+			listener, err := listenController(context.Background(), address)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			shared, err := reuseShareUID(listener.(*net.TCPListener))
+			if err != nil || shared == 0 {
+				t.Fatalf("controller listener lacks SO_REUSESHAREUID: value=%d err=%v", shared, err)
+			}
+			client, err := net.Dial("tcp", listener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			accepted, err := listener.Accept()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer accepted.Close()
+			shared, err = reuseShareUID(accepted.(*net.TCPConn))
+			if err != nil || shared == 0 {
+				t.Fatalf("accepted controller connection lacks SO_REUSESHAREUID: value=%d err=%v", shared, err)
+			}
+		})
+	}
+}
+
+func TestControllerStartSharesLoopbackPortAcrossUsers(t *testing.T) {
+	reservation, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := reservation.Addr().String()
+	if err = reservation.Close(); err != nil {
+		t.Fatal(err)
+	}
+	type acceptedFlag struct {
+		value int
+		err   error
+	}
+	accepted := make(chan acceptedFlag, 1)
+	server := newControllerServer(address)
+	server.httpServer.ConnState = func(conn net.Conn, state http.ConnState) {
+		if state != http.StateNew {
+			return
+		}
+		value, err := reuseShareUID(conn.(*net.TCPConn))
+		select {
+		case accepted <- acceptedFlag{value, err}:
+		default:
+		}
+	}
+	if err = server.Start(adapter.StartStateStarted); err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	client, err := net.Dial("tcp", address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	select {
+	case flag := <-accepted:
+		if flag.err != nil || flag.value == 0 {
+			t.Fatalf("controller connection lacks SO_REUSESHAREUID: value=%d err=%v", flag.value, flag.err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("controller did not accept the connection")
+	}
+}
+
+func TestLiveSharedLoopbackControllerStillConflicts(t *testing.T) {
+	first, err := listenController(context.Background(), "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	shared, err := reuseShareUID(first.(*net.TCPListener))
+	if err != nil || shared == 0 {
+		t.Fatalf("controller listener lacks SO_REUSESHAREUID: value=%d err=%v", shared, err)
+	}
+	port := uint16(first.Addr().(*net.TCPAddr).Port)
+
+	server := newControllerServer(first.Addr().String())
+	err = server.Start(adapter.StartStateStarted)
+	defer server.Close()
+	role, conflictPort, ok := adapter.EndpointConflictFromError(err)
+	if !ok || role != adapter.EndpointConflictController || conflictPort != port || !errors.Is(err, syscall.EADDRINUSE) {
+		t.Fatalf("live shared controller did not conflict: role=%v port=%d ok=%v err=%v", role, conflictPort, ok, err)
+	}
+}
