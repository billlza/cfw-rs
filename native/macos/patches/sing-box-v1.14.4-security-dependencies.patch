diff --git a/common/tls/reality_hybrid_test.go b/common/tls/reality_hybrid_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..409a5ef460fce5e41660c7c49e9d80c7f8119717
--- /dev/null
+++ b/common/tls/reality_hybrid_test.go
@@ -0,0 +1,203 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"net"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+
+	utls "github.com/metacubex/utls"
+)
+
+func newTestRealityClient(t *testing.T, fingerprint string, hybrid bool) (Config, error) {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return NewRealityClient(context.Background(), logger.NOP(), "127.0.0.1:443", option.OutboundTLSOptions{
+		Enabled:    true,
+		ServerName: "example.test",
+		UTLS:       &option.OutboundUTLSOptions{Enabled: true, Fingerprint: fingerprint},
+		Reality: &option.OutboundRealityOptions{
+			Enabled:               true,
+			PublicKey:             base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()),
+			ShortID:               "a1b2c3d4",
+			SupportX25519MLKEM768: hybrid,
+		},
+	})
+}
+
+// clientHelloGroups returns the non-GREASE key share and supported group
+// identifiers of the ClientHello that the REALITY client writes.
+func clientHelloGroups(t *testing.T, config Config) (keyShares, supported []utls.CurveID) {
+	t.Helper()
+	client, server := net.Pipe()
+	defer server.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer client.Close()
+		_, _ = config.(*RealityClientConfig).ClientHandshake(context.Background(), client)
+	}()
+	header := make([]byte, 5)
+	if _, err := io.ReadFull(server, header); err != nil {
+		t.Fatal(err)
+	}
+	record := make([]byte, binary.BigEndian.Uint16(header[3:]))
+	if _, err := io.ReadFull(server, record); err != nil {
+		t.Fatal(err)
+	}
+	server.Close()
+	<-done
+	if header[0] != 22 || record[0] != 1 {
+		t.Fatalf("first record is not a ClientHello: %x %x", header[0], record[0])
+	}
+	body := record[4:]
+	offset := 2 + 32
+	offset += 1 + int(body[offset])
+	offset += 2 + int(binary.BigEndian.Uint16(body[offset:]))
+	offset += 1 + int(body[offset])
+	end := offset + 2 + int(binary.BigEndian.Uint16(body[offset:]))
+	for offset += 2; offset+4 <= end; {
+		kind := binary.BigEndian.Uint16(body[offset:])
+		data := body[offset+4 : offset+4+int(binary.BigEndian.Uint16(body[offset+2:]))]
+		offset += 4 + len(data)
+		switch kind {
+		case 0x0033:
+			for rest := data[2:]; len(rest) >= 4; rest = rest[4+int(binary.BigEndian.Uint16(rest[2:])):] {
+				if group := utls.CurveID(binary.BigEndian.Uint16(rest)); !isGREASECurve(group) {
+					keyShares = append(keyShares, group)
+				}
+			}
+		case 0x000a:
+			for rest := data[2:]; len(rest) >= 2; rest = rest[2:] {
+				if group := utls.CurveID(binary.BigEndian.Uint16(rest)); !isGREASECurve(group) {
+					supported = append(supported, group)
+				}
+			}
+		}
+	}
+	return keyShares, supported
+}
+
+func TestRealityClientHelloKeySharesFollowTheHybridOption(t *testing.T) {
+	plain, err := newTestRealityClient(t, "chrome", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyShares, supported := clientHelloGroups(t, plain)
+	if !slices.Equal(keyShares, []utls.CurveID{utls.X25519}) || slices.Contains(supported, utls.X25519MLKEM768) {
+		t.Fatalf("default hello offers X25519MLKEM768: shares %v groups %v", keyShares, supported)
+	}
+
+	hybrid, err := newTestRealityClient(t, "chrome", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyShares, supported = clientHelloGroups(t, hybrid)
+	if !slices.Equal(keyShares, []utls.CurveID{utls.X25519MLKEM768, utls.X25519}) {
+		t.Fatalf("hybrid hello shares %v, want X25519MLKEM768 then X25519", keyShares)
+	}
+	if slices.Index(supported, utls.X25519MLKEM768) != 0 || slices.Index(supported, utls.X25519) != 1 {
+		t.Fatalf("hybrid hello groups %v, want X25519MLKEM768 then X25519 first", supported)
+	}
+}
+
+func TestRealityHybridKeyShareRequiresTheChromeFingerprint(t *testing.T) {
+	for _, fingerprint := range []string{"firefox", "safari", "edge", "ios", "android", "random", "randomized"} {
+		if _, err := newTestRealityClient(t, fingerprint, true); err == nil ||
+			!strings.Contains(err.Error(), "requires the chrome uTLS fingerprint") {
+			t.Fatalf("%s: got %v, want the chrome fingerprint requirement", fingerprint, err)
+		}
+		if _, err := newTestRealityClient(t, fingerprint, false); err != nil {
+			t.Fatalf("%s without the hybrid share: %v", fingerprint, err)
+		}
+	}
+}
+
+func TestRealityHybridKeyShareRejectsRandomEvenWhenItDrawsChrome(t *testing.T) {
+	drawn := randomFingerprint
+	randomFingerprint = utls.HelloChrome_Auto
+	t.Cleanup(func() { randomFingerprint = drawn })
+	if _, err := newTestRealityClient(t, "random", true); err == nil ||
+		!strings.Contains(err.Error(), "requires the chrome uTLS fingerprint") {
+		t.Fatalf("random with a chrome draw: got %v, want the chrome fingerprint requirement", err)
+	}
+	for _, fingerprint := range []string{"chrome", "", "chrome_psk", "chrome_pq"} {
+		if _, err := newTestRealityClient(t, fingerprint, true); err != nil {
+			t.Fatalf("%q resolves to the chrome hello: %v", fingerprint, err)
+		}
+	}
+}
+
+func TestRealityHybridKeySharesRejectAnUnexpectedLayout(t *testing.T) {
+	build := func(t *testing.T) *utls.UConn {
+		t.Helper()
+		client, server := net.Pipe()
+		t.Cleanup(func() { client.Close(); server.Close() })
+		uConn := utls.UClient(client, &utls.Config{ServerName: "example.test"}, utls.HelloChrome_Auto)
+		if err := uConn.BuildHandshakeState(); err != nil {
+			t.Fatal(err)
+		}
+		return uConn
+	}
+	keyShares := func(uConn *utls.UConn) *utls.KeyShareExtension {
+		for _, extension := range uConn.Extensions {
+			if ks, ok := extension.(*utls.KeyShareExtension); ok {
+				return ks
+			}
+		}
+		t.Fatal("chrome hello has no key share extension")
+		return nil
+	}
+	if err := requireRealityHybridKeyShares(build(t)); err != nil {
+		t.Fatalf("chrome hello: %v", err)
+	}
+	mutations := map[string]func(*utls.UConn){
+		"reversed shares": func(uConn *utls.UConn) {
+			ks := keyShares(uConn)
+			ks.KeyShares[1], ks.KeyShares[2] = ks.KeyShares[2], ks.KeyShares[1]
+		},
+		"no hybrid share": func(uConn *utls.UConn) {
+			ks := keyShares(uConn)
+			ks.KeyShares = slices.DeleteFunc(ks.KeyShares, func(share utls.KeyShare) bool { return share.Group == utls.X25519MLKEM768 })
+		},
+		"no X25519 key": func(uConn *utls.UConn) {
+			uConn.HandshakeState.State13.KeyShareKeys.Ecdhe = nil
+		},
+		"P-256 key": func(uConn *utls.UConn) {
+			key, err := ecdh.P256().GenerateKey(rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			uConn.HandshakeState.State13.KeyShareKeys.Ecdhe = key
+		},
+	}
+	for name, mutate := range mutations {
+		uConn := build(t)
+		mutate(uConn)
+		if err := requireRealityHybridKeyShares(uConn); err == nil {
+			t.Fatalf("%s: accepted", name)
+		}
+	}
+}
+
+func TestIsGREASECurve(t *testing.T) {
+	for value, want := range map[uint16]bool{0x0a0a: true, 0x1a1a: true, 0xfafa: true, 0x0a1a: false, 0x11ec: false, 0x001d: false} {
+		if got := isGREASECurve(utls.CurveID(value)); got != want {
+			t.Fatalf("isGREASECurve(%#04x) = %v", value, got)
+		}
+	}
+}
