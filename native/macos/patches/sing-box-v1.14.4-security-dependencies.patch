@@ -244,0 +260,33 @@ func (e *RealityClientConfig) ClientHandshake(ctx context.Context, conn net.Conn
+// requireRealityHybridKeyShares admits only the hello that a REALITY server
+// requiring X25519MLKEM768 accepts: the hybrid share followed by a separate
+// X25519 share. Such servers derive the authentication key from the separate
+// X25519 share, which is the Ecdhe key that seals the session ID.
+func requireRealityHybridKeyShares(uConn *utls.UConn) error {
+	var groups []utls.CurveID
+	for _, extension := range uConn.Extensions {
+		if ks, ok := extension.(*utls.KeyShareExtension); ok {
+			for _, share := range ks.KeyShares {
+				if !isGREASECurve(share.Group) {
+					groups = append(groups, share.Group)
+				}
+			}
+		}
+	}
+	if len(groups) != 2 || groups[0] != utls.X25519MLKEM768 || groups[1] != utls.X25519 {
+		return E.New("reality X25519MLKEM768 requires the X25519MLKEM768 and X25519 key shares in that order, got ", fmt.Sprint(groups))
+	}
+	keys := uConn.HandshakeState.State13.KeyShareKeys
+	if keys == nil || keys.Ecdhe == nil || keys.Mlkem == nil || keys.MlkemEcdhe == nil {
+		return E.New("reality X25519MLKEM768 key shares were not generated")
+	}
+	if keys.Ecdhe.Curve() != ecdh.X25519() {
+		return E.New("reality X25519MLKEM768 requires the X25519 share to seal the session ID")
+	}
+	return nil
+}
+
+func isGREASECurve(curveID utls.CurveID) bool {
+	value := uint16(curveID)
+	return value&0x0f0f == 0x0a0a && value>>8 == value&0xff
+}
