diff --git a/dns/runtime_policy_test.go b/dns/runtime_policy_test.go
--- a/dns/runtime_policy_test.go
+++ b/dns/runtime_policy_test.go
@@ -559,0 +560 @@
+			writesDone := make(chan uint16, 3)
@@ -563,2 +564,3 @@
-					t.Error(err)
-				}
+					t.Errorf("response write for %s: %v", mdns.TypeToString[request.Question[0].Qtype], err)
+				}
+				writesDone <- request.Question[0].Qtype
@@ -590,0 +593,15 @@
+			// The transport also probes TCP reuse with A/AAAA requests. Keep
+			// the engine alive until those fixture writes complete; otherwise
+			// test cleanup can reset their sockets after the TXT answer wins.
+			completed := make(map[uint16]bool)
+			for len(completed) < 3 {
+				select {
+				case qtype := <-writesDone:
+					if qtype != mdns.TypeTXT && qtype != mdns.TypeA && qtype != mdns.TypeAAAA || completed[qtype] {
+						t.Fatalf("unexpected or duplicate fixture query type: %d", qtype)
+					}
+					completed[qtype] = true
+				case <-ctx.Done():
+					t.Fatal("DNS fixture writes did not complete before the query deadline")
+				}
+			}
