  "xcodegen": {
    "patchPathKey": "XCODEGEN_PATCH_PATH",
    "patchSha256Key": "XCODEGEN_PATCH_SHA256",
    "bootstrapPath": "scripts/bootstrap_release_toolchain.sh",
    "requiredBootstrapFragments": [
