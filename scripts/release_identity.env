# The active release identity: the product version (CFBundleShortVersionString)
# and its active GA bundle build (CFBundleVersion). Every release tool reads both
# from this file. A GA allocation changes the build together with the product
# version's allocation ledger docs/release/build-allocations-v<version>.json and
# the retired build's note; a new product version also changes the files the
# version contract (scripts/verify_version_contract.py) checks.
CFW_PRODUCT_VERSION=0.5.1
CFW_GA_BUILD=51001
