diff --git a/Tests/XcodeGenKitTests/DependencyCompatibilityTests.swift b/Tests/XcodeGenKitTests/DependencyCompatibilityTests.swift
new file mode 100644
--- /dev/null
+++ b/Tests/XcodeGenKitTests/DependencyCompatibilityTests.swift
@@ -0,0 +1,31 @@
+import ProjectSpec
+import XcodeGenKit
+import XcodeProj
+import XCTest
+
+final class DependencyCompatibilityTests: XCTestCase {
+
+    func testHostBuildToolLinksStaticDependenciesAndGeneratesRunnableScheme() throws {
+        let library = Target(name: "ToolSupport", type: .staticLibrary, platform: .macOS)
+        let tool = Target(
+            name: "HostTool",
+            type: .hostBuildTool,
+            platform: .macOS,
+            dependencies: [Dependency(type: .target, reference: library.name)],
+            scheme: TargetScheme()
+        )
+        let project = Project(name: "HostToolProject", targets: [library, tool])
+        let generated = try project.generateXcodeProject()
+        let target = try XCTUnwrap(generated.pbxproj.nativeTargets.first { $0.name == tool.name })
+        let frameworks = try XCTUnwrap(target.frameworksBuildPhase())
+        let scheme = try XCTUnwrap(generated.sharedData?.schemes.first { $0.name == tool.name })
+        let runnable = try XCTUnwrap(scheme.launchAction?.runnable?.buildableReference)
+
+        XCTAssertTrue(tool.defaultLinkage == .none)
+        XCTAssertEqual(tool.filename, "HostTool")
+        XCTAssertEqual(target.productType, .hostBuildTool)
+        XCTAssertEqual(frameworks.files?.compactMap { $0.file?.nameOrPath }, ["libToolSupport.a"])
+        XCTAssertEqual(runnable.blueprintName, tool.name)
+        XCTAssertEqual(runnable.buildableName, "HostTool")
+    }
+}
